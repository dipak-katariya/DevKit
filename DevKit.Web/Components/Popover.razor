@inherits ClickOutsideComponent

@* A trigger and a panel floating over the page beneath it. A click anywhere outside closes it,
   through the outside-click listener the dropdowns use, and so does Escape anywhere inside it.
   The owner holds the open state. *@

<div class="pop @CssClass" @ref="Root" @onkeydown="OnKeyDown">
    @Trigger
    @if (Open)
    {
        <div class="pop-panel @PanelClass" role="dialog" aria-label="@Label">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public RenderFragment Trigger { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Extra classes on the panel; they set its width and which edge it lines up with.</summary>
    [Parameter] public string? PanelClass { get; set; }

    /// <summary>Accessible name of the panel.</summary>
    [Parameter] public string? Label { get; set; }

    private const string FocusFirstCall = "devKit.focusFirst";

    protected override bool IsPanelOpen => Open;

    // The owner decides; if it keeps the panel open, the next render adds the listener again.
    protected override Task CloseFromOutsideAsync() => OpenChanged.InvokeAsync(false);

    // A dropdown in the panel handles its own Escape and stops it, so the first Escape closes only that list. Focus
    // goes back to the trigger, the first control in the popover, since the panel that may have held it is gone.
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || !Open)
        {
            return;
        }
        await OpenChanged.InvokeAsync(false);
        await InvokeJsAsync(FocusFirstCall, Root);
    }
}
