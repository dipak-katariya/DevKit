@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject SettingsService Settings
@inject UserSession Session
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILogger<MainLayout> Logger

<PageTitle>@ToolCatalog.PageTitle(new Uri(Nav.Uri).AbsolutePath)</PageTitle>

<div class="devkit-app">
    @* The first Tab stop, past the sidebar to the page. It shows only while it has keyboard focus. *@
    <a class="skip-link" href="#main" @onclick="SkipToContentAsync" @onclick:preventDefault>Skip to content</a>

    @* At 900px and narrower the sidebar is a drawer the menu button opens (tools.css). While it is open the page
       behind it is inert, so Tab stays in the drawer, and Escape, a tap outside or a followed link closes it. *@
    <aside class="sidebar @(navOpen ? "open" : "")" id="sidebar" tabindex="-1" aria-label="DevKit"
           @ref="sidebar" @onkeydown="OnSidebarKeyDown">
        <div class="sidebar-profile">
            <div class="profile-avatar">DK</div>
            <div class="profile-meta">
                <span class="profile-name">DevKit</span>
                <span class="profile-sub">@ServerLabel</span>
            </div>
        </div>
        <NavMenu />
    </aside>
    @if (navOpen)
    {
        <div class="nav-scrim" @onclick="CloseNav"></div>
    }

    <div class="main" inert="@navOpen">
        <header class="topbar">
            <button class="tb-btn tb-menu" aria-label="Menu" aria-controls="sidebar"
                    aria-expanded="@(navOpen ? "true" : "false")" @ref="menuButton" @onclick="OpenNav">
                <Icon Inner="@Icons.Menu" />
            </button>
            <div class="tb-nav">
                <button class="tb-btn" title="Back" @onclick="GoBack"><Icon Inner="@Icons.ChevronLeft" /></button>
                <button class="tb-btn" title="Forward" @onclick="GoForward"><Icon Inner="@Icons.ChevronRight" /></button>
            </div>
            <CommandSearch />
            <div class="tb-spacer"></div>
            <div class="tb-actions">
                @if (Session.IsReady && (Settings.LastSaveError ?? Settings.LoadProblem) is { } settingsProblem)
                {
                    <a class="conn-pill err" href="settings" title="@settingsProblem">
                        <span class="dot"></span>
                        <span class="conn-label">Settings problem</span>
                    </a>
                }
                @if (Session.IsReady)
                {
                    <div class="conn-pill @(Settings.IsConfigured ? "ok" : "err")">
                        <span class="dot"></span>
                        <span class="conn-label">@(Settings.IsConfigured ? "Connected" : "Not configured")</span>
                    </div>
                }
                @if (Session.User is { } user)
                {
                    @* A plain form: the browser posts it and follows the redirect to the sign-in page. *@
                    <form class="tb-user" method="post" action="signout">
                        <AntiforgeryToken />
                        <span class="tb-user-name" title="Signed in as @user.Name">@user.Name</span>
                        <button class="tb-btn tb-signout" type="submit" title="Sign out, so someone else can sign in">Sign out</button>
                    </form>
                }
            </div>
        </header>

        <main class="shell" id="main" tabindex="-1" @ref="content">
            @if (!Session.IsReady)
            {
                <div class="setup-guard">
                    <div class="setup-card">
                        @if (startProblem is null)
                        {
                            <span class="spin setup-spin" aria-hidden="true"></span>
                        }
                        <h2>@(startProblem is null ? "Opening DevKit…" : "DevKit could not open")</h2>
                        <p>@(startProblem ?? "Loading your settings.")</p>
                    </div>
                </div>
            }
            else if (!Settings.IsConfigured && RequiresSetup)
            {
                <div class="setup-guard">
                    <div class="setup-card">
                        <div class="setup-icon"><Icon Inner="@Icons.ToolSettings" CssClass="ic-xl" /></div>
                        <h2>Setup Required</h2>
                        <p>@SetupHint</p>
                        <button class="btn-primary setup-action" @onclick='() => Nav.NavigateTo("/settings")'>
                            Open Settings
                        </button>
                    </div>
                </div>
            }
            else
            {
                @Body
            }
        </main>
    </div>
</div>

@code {
    private static readonly string[] NoSetupPaths = { "", "/markdown", "/workday", "/settings" };

    // tools.css makes the sidebar a drawer at 900px and narrower. Wider than this it is back in the page, so a
    // drawer still open then (a tablet turned, a window widened) is closed, or the inert page would stay locked.
    private const string WideScreen = "(min-width: 901px)";

    /// <summary>Where focus goes after the next render, once the drawer has opened or closed.</summary>
    private enum PendingFocus
    {
        None,
        Drawer,
        MenuButton
    }

    // Why the settings could not be made ready; null while they load or once they have.
    private string? startProblem;

    private bool navOpen;
    private PendingFocus pendingFocus;
    private ElementReference sidebar;
    private ElementReference menuButton;
    private ElementReference content;
    private DotNetObjectReference<MainLayout>? selfRef;

    private bool RequiresSetup
    {
        get
        {
            var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
            return !NoSetupPaths.Contains(path, StringComparer.OrdinalIgnoreCase);
        }
    }

    /// <summary>"TFS · Collection" for the server in use: its collection is the last part of its address.</summary>
    private string ServerLabel =>
        Uri.TryCreate(Settings.Tfs.Url, UriKind.Absolute, out var server) && server.Segments.Length > 1
            ? $"TFS · {Uri.UnescapeDataString(server.Segments[^1].TrimEnd('/'))}"
            : "TFS";

    private string SetupHint => Session.IsShared
        ? "Connect DevKit to TFS: enter your personal access token once in Settings. It is kept encrypted in this browser on your PC, for you only."
        : "Connect DevKit to TFS in Settings: sign in with your Windows account or a personal access token.";

    protected override void OnInitialized()
    {
        // The top bar shows the connection and any save problem, so it redraws when Settings saves on another page.
        Settings.Changed += OnSettingsChanged;
        Nav.LocationChanged += OnLocationChanged;
        if (Session.IsShared)
        {
            Authentication.AuthenticationStateChanged += OnAuthenticationChanged;
        }
    }

    // Raised on whichever thread saved, which in local mode can be another page's: the redraw goes through this
    // page's own dispatcher.
    private void OnSettingsChanged() => _ = InvokeAsync(StateHasChanged);

    // A link in the drawer was followed, so the drawer has done its job. Focus goes to the new page's heading
    // (Routes.razor), not back to the menu button.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(() =>
    {
        if (navOpen)
        {
            navOpen = false;
            StateHasChanged();
        }
    });

    /// <summary>
    /// After every render, focus moves where the drawer asked. After the first, the window's width is watched for
    /// the drawer and, when needed, the settings are loaded: they may live in the browser, which only answers once
    /// the page is live.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await MoveFocusAsync();
        if (!firstRender)
        {
            return;
        }

        await WatchWideScreenAsync();
        if (!Session.IsReady)
        {
            await StartSessionAsync();
        }
    }

    private async Task StartSessionAsync()
    {
        try
        {
            if (!await Session.StartAsync())
            {
                Nav.NavigateTo(SignInEndpoints.SignInPath, forceLoad: true);
                return;
            }
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "The page closed while the settings were loading");
            return;
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException)
        {
            Logger.LogError(ex, "The settings could not be loaded for this page");
            startProblem = "Your settings could not be loaded. Reload the page. If it keeps happening, tell whoever runs DevKit.";
        }

        StateHasChanged();
    }

    /// <summary>The session ended (signed out in another tab, or past its days): this page goes back to the sign-in page.</summary>
    private void OnAuthenticationChanged(Task<AuthenticationState> changed) => _ = InvokeAsync(async () =>
    {
        if ((await changed).User.Identity?.IsAuthenticated != true)
        {
            Nav.NavigateTo(SignInEndpoints.SignInPath, forceLoad: true);
        }
    });

    private async Task GoBack() => await JS.InvokeVoidAsync("devKit.historyBack");
    private async Task GoForward() => await JS.InvokeVoidAsync("devKit.historyForward");

    private void OpenNav()
    {
        navOpen = true;
        pendingFocus = PendingFocus.Drawer;
    }

    private void CloseNav()
    {
        navOpen = false;
        pendingFocus = PendingFocus.MenuButton;
    }

    private void OnSidebarKeyDown(KeyboardEventArgs e)
    {
        if (navOpen && e.Key == "Escape")
        {
            CloseNav();
        }
    }

    /// <summary>Called by app.js when the window grows past the drawer's width while the drawer is open.</summary>
    [JSInvokable]
    public Task CloseNavForWideScreen() => InvokeAsync(() =>
    {
        if (navOpen)
        {
            navOpen = false;
            StateHasChanged();
        }
    });

    private Task SkipToContentAsync() => FocusAsync(content, "page");

    private Task MoveFocusAsync()
    {
        var target = pendingFocus;
        pendingFocus = PendingFocus.None;
        return target switch
        {
            PendingFocus.Drawer => FocusAsync(sidebar, "menu"),
            PendingFocus.MenuButton => FocusAsync(menuButton, "menu button"),
            _ => Task.CompletedTask
        };
    }

    // Moving focus is a help, not a step the page depends on: if the browser refuses, the person clicks instead,
    // so the failure is logged and the page carries on. A page that has closed has nothing left to focus.
    private async Task FocusAsync(ElementReference element, string target)
    {
        try
        {
            await element.FocusAsync();
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "The page closed before focus could move to the {Target}", target);
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException)
        {
            Logger.LogError(ex, "Focus could not move to the {Target}", target);
        }
    }

    private async Task WatchWideScreenAsync()
    {
        selfRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("devKit.watchWideScreen", WideScreen, selfRef);
        }
        catch (JSDisconnectedException ex)
        {
            Logger.LogDebug(ex, "The page closed before the menu could watch the window's width");
        }
        catch (Exception ex) when (ex is JSException or TaskCanceledException)
        {
            Logger.LogError(ex, "The menu could not watch the window's width; a drawer left open while the window grows stays open");
        }
    }

    public async ValueTask DisposeAsync()
    {
        Settings.Changed -= OnSettingsChanged;
        Nav.LocationChanged -= OnLocationChanged;
        Authentication.AuthenticationStateChanged -= OnAuthenticationChanged;
        if (selfRef is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("devKit.unwatchWideScreen");
            }
            catch (JSDisconnectedException ex)
            {
                Logger.LogDebug(ex, "The page closed before the width watch was removed");
            }
            catch (Exception ex) when (ex is JSException or TaskCanceledException)
            {
                Logger.LogError(ex, "The width watch could not be removed");
            }
            selfRef.Dispose();
        }
        GC.SuppressFinalize(this);
    }
}
