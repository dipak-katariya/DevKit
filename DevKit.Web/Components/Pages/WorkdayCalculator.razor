@page "/workday"
@implements IDisposable
@inject IJSRuntime JS
@inject ILogger<WorkdayCalculator> Logger
@inject TimeProvider Clock

@* One panel: the entries on the left, and on the right how far through the day they put you. The figures update
   every second while the last line is an open IN. *@
<div class="wc-page">
    <h1 class="sr-only">Workday Calculator</h1>
    <section class="gpanel wc-panel" aria-labelledby="wcTitle">
        <div class="phead">
            <h2 class="ptitle" id="wcTitle"><span aria-hidden="true">⏱</span> Workday Calculator</h2>
            <span class="wc-lead">Calculate your workday and see live progress</span>
        </div>
        <div class="pbody wc-body">
            <div class="wc-entry">
                <div class="f-row" role="group" aria-labelledby="wcTypeLabel">
                    <div class="f-label" id="wcTypeLabel">Workday Type</div>
                    <div class="cm-seg wc-seg">
                        <button type="button" class="cm-seg-btn @(dayType == "full" ? "on" : "")" aria-pressed="@(dayType == "full" ? "true" : "false")" @onclick='() => SetDayType("full")'>Full Day (8h 30m)</button>
                        <button type="button" class="cm-seg-btn @(dayType == "half" ? "on" : "")" aria-pressed="@(dayType == "half" ? "true" : "false")" @onclick='() => SetDayType("half")'>Half Day (4h 30m)</button>
                        <button type="button" class="cm-seg-btn @(dayType == "move" ? "on" : "")" aria-pressed="@(dayType == "move" ? "true" : "false")" @onclick='() => SetDayType("move")'>Movement (7h 30m)</button>
                    </div>
                </div>

                <label class="f-label" for="wcEntries">Time Entries (e.g., 09:30:00 or 9:30 AM)</label>
                <p class="wc-hint" id="wcEntriesHint">Enter your clock-in/out times, one per line. Last line may be an open IN if you're clocked in.</p>
                <textarea class="fi wc-entries" id="wcEntries" spellcheck="false" aria-describedby="wcEntriesHint wcFormats"
                          placeholder="@EntriesExample"
                          @oninput="OnEntriesInput" @bind="entriesText"></textarea>
                <p class="wc-hint" id="wcFormats">
                    Order: IN, OUT, IN, OUT… Formats: <code>9:22</code>, <code>9:22:22</code>, <code>9:22 AM</code>, <code>13:05</code>
                </p>
                @if (problem is not null) { <div class="notice warn wc-problem" role="alert">⚠ @problem</div> }
            </div>

            <div class="wc-result">
                <div class="wc-ring" role="progressbar" aria-label="Completion %" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Math.Round(percent)">
                    <svg viewBox="0 0 36 36" aria-hidden="true">
                        <circle class="wc-ring-track" cx="18" cy="18" r="15.9" />
                        @* At 0% a round line cap would still draw a dot, so the fill waits for some progress. *@
                        @if (percent > 0)
                        {
                            <circle class="wc-ring-fill" cx="18" cy="18" r="15.9" stroke-dasharray="@DashArray" stroke-dashoffset="0" />
                        }
                    </svg>
                    <div class="wc-ring-text">
                        <span class="wc-pct">@Math.Round(percent)%</span>
                        <span class="wc-ring-note">Live progress</span>
                    </div>
                </div>
                <h3 class="wc-sub"><span aria-hidden="true">📊</span> Your Daily Summary</h3>
                @* Three figures read as one summary, not as three cards: the label quiet, the figure in the lead size. *@
                <dl class="wc-figures">
                    <div><dt>Total Time Worked</dt><dd>@workedStr</dd></div>
                    <div><dt>Remaining Time</dt><dd>@remainStr</dd></div>
                    <div><dt>Estimated Departure</dt><dd>@departStr</dd></div>
                </dl>
            </div>
        </div>
    </section>
</div>

@code {
    // Shown in the empty box, one entry per line, as the hint above it asks.
    private const string EntriesExample = "09:30:00 AM\n12:45:00 PM\n01:30:00 PM";

    private string dayType = "full";
    private string entriesText = "";
    private double percent;
    private string workedStr = "00h 00m 00s";
    private string remainStr = "08h 30m 00s";
    private string departStr = "Not Clocked In";
    private System.Threading.Timer? liveTimer;

    // A day has a few clock-ins and outs. Far more lines than this is a paste gone wrong, and it would overflow the sums.
    private const int MaxEntries = 48;

    // Enough of a bad line to find it in the box, without a pasted paragraph filling the notice.
    private const int MaxQuoted = 24;

    // A clock-in typed a few minutes ahead of the clock counts as just started, not as a time still to come.
    private const int ClockInGraceMinutes = 5;

    // Why the figures cannot be worked out, shown under the entries; null while they can.
    private string? problem;

    // The entries the last failure was logged for: the figures refresh every second, and one failure is logged once.
    private string? loggedFailureFor;

    private string DashArray => $"{(percent / 100.0 * 100.0):F1} {(100.0 - percent / 100.0 * 100.0):F1}";

    private static readonly Dictionary<string, int> DayTargets = new()
    {
        ["full"] = 8 * 3600 + 30 * 60,
        ["half"] = 4 * 3600 + 30 * 60,
        ["move"] = 7 * 3600 + 30 * 60
    };

    private int TargetSec => DayTargets.TryGetValue(dayType, out var v) ? v : DayTargets["full"];

    protected override void OnInitialized()
    {
        liveTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() => { Compute(); StateHasChanged(); });
        }, null, 0, 1000);
    }

    private void SetDayType(string type)
    {
        dayType = type;
        Compute();
    }

    private void OnEntriesInput(ChangeEventArgs e)
    {
        entriesText = e.Value?.ToString() ?? "";
        Compute();
    }

    private void Compute()
    {
        try
        {
            var now = Clock.GetLocalNow().DateTime;
            var baseDate = now.Date;
            var lines = (entriesText ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries)
                .Select(l => l.Trim()).Where(l => l.Length > 0).ToList();

            if (lines.Count == 0)
            {
                percent = 0; workedStr = "00h 00m 00s"; remainStr = FmtHms(TargetSec); departStr = "Not Clocked In";
                problem = null;
                return;
            }
            if (lines.Count > MaxEntries)
            {
                ShowUnknown($"Too many lines. Keep to {MaxEntries}, one clock-in or clock-out time per line.");
                return;
            }

            // Skipping a line that is not a time would swap IN and OUT on every line after it, so one bad line stops the sums.
            var badLine = lines.FindIndex(l => ParseTime(l, baseDate) is null);
            if (badLine >= 0)
            {
                ShowUnknown($"\"{Shorten(lines[badLine])}\" is not a time. Write each time on its own line, such as 9:30 or 9:30 AM.");
                return;
            }
            var times = lines.Select(l => ParseTime(l, baseDate)!.Value).ToList();

            // Each time follows the one above it. A step back used to be read as crossing midnight, so a slip such as
            // 9:00 AM under 9:30 AM counted 23h 30m worked.
            var stepBack = FirstStepBack(times);
            if (stepBack > 0)
            {
                ShowUnknown($"\"{Shorten(lines[stepBack])}\" is earlier than \"{Shorten(lines[stepBack - 1])}\" above it. Write the times in the order they happened.");
                return;
            }

            var (totalWork, openIn) = SumPairs(times);
            // An open IN still to come used to be read as yesterday's, which added most of a day.
            if (openIn > now.AddMinutes(ClockInGraceMinutes))
            {
                ShowUnknown($"\"{Shorten(lines[^1])}\" has not come yet. The last line is when you clocked in, so it must be earlier than now.");
                return;
            }
            problem = null;

            if (openIn.HasValue)
            {
                totalWork += Math.Max(0, (now - openIn.Value).TotalSeconds);
            }

            var remaining = TargetSec - totalWork;
            percent = Math.Max(0, Math.Min(100, totalWork / TargetSec * 100));
            workedStr = FmtHms((int)totalWork);
            remainStr = FmtHms((int)remaining);

            if (openIn.HasValue)
            {
                var addSec = Math.Max(remaining, 0);
                var exp = now.AddSeconds(addSec);
                departStr = exp.ToString("hh:mm:ss tt");
            }
            else
            {
                departStr = "Not Clocked In";
            }
        }
        catch (Exception ex)
        {
            // The checks above leave nothing known to throw; this is the last resort, and it says nothing technical.
            if (loggedFailureFor != entriesText)
            {
                loggedFailureFor = entriesText;
                Logger.LogError(ex, "The workday figures could not be worked out from the entries typed");
            }
            ShowUnknown("These times could not be worked out. Check that each line holds one time, such as 9:30 or 9:30 AM.");
        }
    }

    private static string Shorten(string line) => line.Length > MaxQuoted ? line[..MaxQuoted] + "…" : line;

    // The first line whose time comes before the line above it, or -1 when each time follows the one before.
    private static int FirstStepBack(List<DateTime> times)
    {
        for (var i = 1; i < times.Count; i++)
        {
            if (times[i] < times[i - 1])
            {
                return i;
            }
        }
        return -1;
    }

    // The seconds inside each IN and OUT pair, and the last IN when no OUT follows it yet.
    private static (double Seconds, DateTime? OpenIn) SumPairs(List<DateTime> times)
    {
        double seconds = 0;
        for (var i = 0; i + 1 < times.Count; i += 2)
        {
            seconds += (times[i + 1] - times[i]).TotalSeconds;
        }
        return (seconds, times.Count % 2 == 1 ? times[^1] : null);
    }

    private void ShowUnknown(string why)
    {
        percent = 0; workedStr = "Unknown"; remainStr = "Unknown"; departStr = "Unknown";
        problem = why;
    }

    private static DateTime? ParseTime(string raw, DateTime baseDate)
    {
        raw = raw.Trim();
        if (string.IsNullOrEmpty(raw)) return null;

        // Try standard parsing
        if (DateTime.TryParse(raw, System.Globalization.CultureInfo.CurrentCulture, System.Globalization.DateTimeStyles.None, out var dt))
        {
            return baseDate.Date.Add(dt.TimeOfDay);
        }

        // Try common patterns
        var s = System.Text.RegularExpressions.Regex.Replace(raw, @"\s+", " ").Trim();

        // HH:mm:ss AM/PM
        var m = System.Text.RegularExpressions.Regex.Match(s, @"^(\d{1,2}):(\d{2}):(\d{2})\s*(AM|PM)$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (m.Success)
        {
            int h = int.Parse(m.Groups[1].Value), mi = int.Parse(m.Groups[2].Value), sec = int.Parse(m.Groups[3].Value);
            var ap = m.Groups[4].Value.ToUpper();
            if (h == 12) h = ap == "AM" ? 0 : 12; else if (ap == "PM") h += 12;
            return baseDate.AddHours(h).AddMinutes(mi).AddSeconds(sec);
        }

        // HH:mm AM/PM
        m = System.Text.RegularExpressions.Regex.Match(s, @"^(\d{1,2}):(\d{2})\s*(AM|PM)$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (m.Success)
        {
            int h = int.Parse(m.Groups[1].Value), mi = int.Parse(m.Groups[2].Value);
            var ap = m.Groups[3].Value.ToUpper();
            if (h == 12) h = ap == "AM" ? 0 : 12; else if (ap == "PM") h += 12;
            return baseDate.AddHours(h).AddMinutes(mi);
        }

        // HH:mm:ss (24h)
        m = System.Text.RegularExpressions.Regex.Match(s, @"^(\d{1,2}):(\d{2}):(\d{2})$");
        if (m.Success)
        {
            return baseDate.AddHours(int.Parse(m.Groups[1].Value)).AddMinutes(int.Parse(m.Groups[2].Value)).AddSeconds(int.Parse(m.Groups[3].Value));
        }

        // HH:mm (24h)
        m = System.Text.RegularExpressions.Regex.Match(s, @"^(\d{1,2}):(\d{2})$");
        if (m.Success)
        {
            return baseDate.AddHours(int.Parse(m.Groups[1].Value)).AddMinutes(int.Parse(m.Groups[2].Value));
        }

        return null;
    }

    private static string FmtHms(int sec)
    {
        var sign = sec >= 0 ? "" : "-";
        sec = Math.Abs(sec);
        var h = sec / 3600;
        var m = (sec % 3600) / 60;
        var s = sec % 60;
        return $"{sign}{h:D2}h {m:D2}m {s:D2}s";
    }

    public void Dispose()
    {
        liveTimer?.Dispose();
    }
}
