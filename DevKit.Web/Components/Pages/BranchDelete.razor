@page "/branch-delete"
@inject TfsApiService TfsApi
@inject BranchCleanupService Cleanup
@inject SettingsService Settings
@inject PageStateService PageState
@inject ILogger<BranchDelete> Logger

<div class="cm-page">
    <div class="cm-toolbar">
        <div class="cm-tb-row">
            <div class="cm-fld" style="flex:1 1 230px;">
                <label class="cfg-label">📂 Area Path <span class="cm-hint">for sprint work items</span></label>
                <GlassDropdown Value="@(selectedArea != null ? AreaSprintSelect.Serialize(selectedArea) : "")"
                               Placeholder="— Any area —" EmptyLabel="— Any area —" EmptyValue=""
                               Disabled="@(areas.Count == 0 || Busy)" Groups="@AreaGroups" OnChange="OnAreaChange" />
            </div>
            <div class="cm-fld" style="flex:1 1 200px;">
                <label class="cfg-label">
                    📅 Sprint
                    @if (selectedSprints.Count > 1) { <span class="cm-hint">@selectedSprints.Count selected</span> }
                </label>
                <MultiSelectDropdown Options="@SprintOptions" Selected="@selectedSprints"
                                     SelectedChanged="OnSprintsChanged" ItemNoun="sprint"
                                     Disabled="@(selectedArea == null || Busy)"
                                     Placeholder="@(selectedArea == null ? "— Pick an area first —" : "— Sprints to clean up —")"
                                     SearchPlaceholder="Search sprints…" />
            </div>
            <div class="cm-fld" style="flex:1 1 210px;">
                <label class="cfg-label">
                    📦 Repositories
                    @if (selectedRepoIds.Count > 1) { <span class="cm-hint">@selectedRepoIds.Count selected</span> }
                </label>
                <MultiSelectDropdown Options="@RepoOptions" Selected="@selectedRepoIds"
                                     SelectedChanged="OnReposChanged" ItemNoun="repository"
                                     Disabled="@(AvailableRepos.Count == 0 || Busy)"
                                     Placeholder="— Select repositories —" SearchPlaceholder="Search repositories…" />
            </div>
            <div class="cm-fld" style="flex:0 1 150px;">
                <label class="cfg-label" title="The team name Branch Creator puts at the front of every branch. Shared with Branch Creator.">👥 Team</label>
                <input class="cfg-fi" value="@teamName" @onchange="OnTeamNameChange" placeholder="e.g. FXCPMGR"
                       maxlength="@MaxTeamNameLength" disabled="@Busy" />
            </div>
            <div class="cm-fld cm-fld-btn">
                <button class="cfg-load-btn" @onclick="Load" disabled="@(!CanLoad)">
                    @if (loading) { <span class="spin spin-sm" style="color:#fff;"></span> } else { <Icon Inner="@Icons.Refresh" /> }
                    Load Branches
                </button>
                @if (stale) { <span class="cm-hint bdel-stale" title="The grid still shows the last load">changed — load again</span> }
            </div>
        </div>

        @if (loaded)
        {
            <div class="cm-tb-row">
                <div class="cm-fld">
                    <label class="cfg-label">🔗 Work item link</label>
                    <div class="cm-seg">
                        <button class="cm-seg-btn @(linkFilter == LinkFilter.All ? "on" : "")" @onclick="() => SetLinkFilter(LinkFilter.All)">All</button>
                        <button class="cm-seg-btn @(linkFilter == LinkFilter.Linked ? "on" : "")" @onclick="() => SetLinkFilter(LinkFilter.Linked)"
                                title="Branches a work item links to">Linked</button>
                        <button class="cm-seg-btn @(linkFilter == LinkFilter.Unattached ? "on" : "")" @onclick="() => SetLinkFilter(LinkFilter.Unattached)"
                                title="Team branches no work item links to">Unattached</button>
                    </div>
                </div>
                <div class="cm-fld">
                    <label class="cfg-label">📅 Sprint</label>
                    <div class="cm-seg">
                        <button class="cm-seg-btn @(sprintOnly ? "on" : "")" disabled="@(!loadedWithSprints)" @onclick="() => SetSprintOnly(true)"
                                title="@(loadedWithSprints ? "Linked from the selected sprints' work items, or named after one of those sprints" : "Pick sprints and load again to filter by sprint")">Selected sprints</button>
                        <button class="cm-seg-btn @(sprintOnly ? "" : "on")" @onclick="() => SetSprintOnly(false)">All</button>
                    </div>
                </div>
                <div class="cm-fld" style="flex:1 1 180px;">
                    <label class="cfg-label">👤 Created by</label>
                    <GlassDropdown Value="@creatorFilter" Placeholder="— Anyone —" EmptyLabel="— Anyone —" EmptyValue=""
                                   Options="@CreatorOptions" OnChange="OnCreatorChange" />
                </div>
                <div class="cm-fld" style="flex:2 1 220px;">
                    <label class="cfg-label">🔍 Search</label>
                    <input class="cfg-fi" placeholder="Branch, work item id or title…" value="@search" @oninput="OnSearchInput" />
                </div>
                <div class="cm-fld cm-fld-btn">
                    <button class="cfg-load-btn bdel-delete-btn" @onclick="OpenConfirm" disabled="@(!CanDelete)">
                        🗑 Delete selected (@selectedKeys.Count)
                    </button>
                </div>
            </div>
        }
    </div>

    @if (Busy && progress is { } p)
    {
        <div class="bdel-progress">
            <div class="bdel-progress-text">
                <span class="spin spin-sm"></span> @p.Stage
                @if (p.Total > 0) { <b>@p.Done / @p.Total (@p.Percent%)</b> }
            </div>
            <div class="progress-bar"><div class="progress-fill" style="width:@(p.Percent)%;"></div></div>
        </div>
    }
    @if (!string.IsNullOrEmpty(error)) { <div class="notice warn">⚠ @error</div> }
    @foreach (var warning in result.Warnings) { <div class="notice warn">⚠ @warning</div> }

    <div class="gpanel bdel-panel">
        <div class="phead">
            <span class="ptitle">🗑 Branch Manager</span>
            @if (loaded)
            {
                <div class="bdel-chips">
                    <span class="chip">@result.Rows.Count branches</span>
                    @if (loadedWithSprints) { <span class="chip chip-green" title="Linked from the selected sprints, or named after one">@SprintCount in sprint</span> }
                    <span class="chip">@LinkedCount linked</span>
                    <span class="chip bdel-chip-warn" title="Team branches no work item links to">@UnattachedCount unattached</span>
                    <span class="chip bdel-chip-lock">@ProtectedCount locked</span>
                </div>
                <div style="display:flex;gap:6px;align-items:center;">
                    @if (HiddenSelection > 0) { <span class="cm-hint">@HiddenSelection selected outside the filter</span> }
                    <button class="btn-sm" @onclick="SelectAllVisible" disabled="@(VisibleDeletable == 0 || Busy)">Select all shown (@VisibleDeletable)</button>
                    <button class="btn-sm" @onclick="ClearSelection" disabled="@(selectedKeys.Count == 0 || Busy)">Clear selection</button>
                </div>
            }
        </div>
        <div class="pbody" style="padding:0;flex:1;overflow:hidden;">
            @if (!loaded && !loading)
            {
                <div class="pr-placeholder">
                    <div style="font-size:2rem;opacity:.2;">🌿</div>
                    <div class="bp-title">Pick the repositories to clean up</div>
                    <div class="bp-sub">Add an area and old sprints to find the branches their work items link, and set the team to find unattached team branches.</div>
                </div>
            }
            else
            {
                <div class="grid-wrap bdel-grid">
                    <table class="req-table bdel-table">
                        <thead>
                            <tr>
                                <th class="bdel-check"></th>
                                <th>Branch</th>
                                <th class="bdel-repo">Repository</th>
                                <th class="bdel-wi">Work item</th>
                                <th class="bdel-sprint">Sprint</th>
                                <th class="bdel-creator">Created by</th>
                                <th class="bdel-sha">SHA</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (loaded && visible.Count == 0)
                            {
                                <tr><td colspan="7" class="tbl-empty">No branches match the filters.</td></tr>
                            }
                            <Virtualize Items="@visible" Context="r" ItemSize="46" OverscanCount="12" SpacerElement="tr">
                                <tr @key="r.Key" class="@RowClass(r)" @onclick="() => Toggle(r)">
                                    <td class="bdel-check">
                                        <input type="checkbox" checked="@selectedKeys.Contains(r.Key)" disabled="@(!r.CanDelete || Busy)"
                                               @onclick:stopPropagation @onchange="() => Toggle(r)" />
                                    </td>
                                    <td class="bdel-branch">
                                        <CopyableRef Text="@r.Branch" Url="@TfsApi.BranchUrl(r.Repo, r.Branch)" Label="branch" />
                                        @if (!r.CanDelete) { <div class="bdel-lock">🔒 @r.ProtectedReason</div> }
                                    </td>
                                    <td class="bdel-repo">@r.Repo.Name</td>
                                    <td class="bdel-wi">
                                        @if (r.LinkedBy.Count > 0)
                                        {
                                            @foreach (var wi in r.LinkedBy)
                                            {
                                                <div class="bdel-wi-line" title="@wi.Type · @wi.Sprint · @wi.Title">
                                                    <a class="id-link" href="@TfsApi.WorkItemUrl(wi.Project, wi.Id)" target="_blank" rel="noopener" @onclick:stopPropagation>#@wi.Id</a>
                                                    <span class="state-pill @WorkItemBadges.StateClass(wi.State)">@wi.State</span>
                                                    <span class="bdel-wi-title">@wi.Title</span>
                                                </div>
                                            }
                                        }
                                        else if (r.LinkState == BranchLinkState.Unattached)
                                        {
                                            <span class="bdel-unattached" title="@UnattachedHint(r)">Unattached</span>
                                        }
                                        else
                                        {
                                            <span class="bdel-muted" title="Not a team branch, so its links were not looked up">—</span>
                                        }
                                    </td>
                                    <td class="bdel-sprint">
                                        <span class="@(r.InSelectedSprint ? "bdel-sprint-on" : "")">@(r.Parsed?.Sprint ?? "—")</span>
                                    </td>
                                    <td class="bdel-creator">@(string.IsNullOrEmpty(r.Creator) ? "—" : r.Creator)</td>
                                    <td class="bdel-sha"><CopyableRef Text="@r.ObjectId" Display="@WorkItemBadges.ShortSha(r.ObjectId)" Label="SHA" /></td>
                                </tr>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (deleteLog.Count > 0)
    {
        <div class="gpanel bdel-log">
            <div class="phead">
                <span class="ptitle">📋 Delete log</span>
                <span class="cm-hint">@DeletedCount deleted · @(deleteLog.Count - DeletedCount) not deleted</span>
                <button class="btn-sm" @onclick="() => deleteLog.Clear()" disabled="@deleting">Clear</button>
            </div>
            <div class="pbody bdel-log-body">
                @foreach (var entry in deleteLog.OrderBy(o => o.Deleted))
                {
                    <div class="bdel-log-line @(entry.Deleted ? "ok" : "err")">
                        @(entry.Deleted ? "✓" : "✕") @entry.RepoName / @entry.Branch — @entry.Message
                    </div>
                }
            </div>
        </div>
    }
</div>

@if (showConfirm)
{
    <div class="modal-overlay" @onclick="() => showConfirm = false">
        <div class="modal" style="max-width:640px;" @onclick:stopPropagation>
            <h3>⚠ Delete @SelectedRows.Count branch(es)?</h3>
            <div class="modal-body">
                <p style="font-size:.76rem;margin-bottom:10px;">
                    This cannot be undone. Work items keep their links to deleted branches — Branch Creator shows
                    those as stale and can remove them. A branch someone has pushed to since it was loaded is refused.
                </p>
                <div class="bdel-confirm-list">
                    @foreach (var byRepo in SelectedRows.GroupBy(r => r.Repo.Name).OrderBy(g => g.Key))
                    {
                        <div class="bdel-confirm-repo">@byRepo.Key · @byRepo.Count() branch(es)</div>
                        @foreach (var r in byRepo.OrderBy(r => r.Branch, StringComparer.OrdinalIgnoreCase))
                        {
                            <div class="bdel-confirm-branch">🗑 @r.Branch</div>
                        }
                    }
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn-ghost" @onclick="() => showConfirm = false">Cancel</button>
                <button class="btn-ghost btn-danger" @onclick="ExecuteDelete">🗑 Delete @SelectedRows.Count branch(es)</button>
            </div>
        </div>
    </div>
}
