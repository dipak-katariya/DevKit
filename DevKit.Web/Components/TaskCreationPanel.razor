@* The Task Creation tab of Sprint Insights: standardized child tasks for a Requirement, Change Request
   or Bug, created in one action. *@
@inject TfsApiService TfsApi
@inject PageStateService PageState
@inject ILogger<TaskCreationPanel> Logger
@implements IDisposable

<div class="si-toolbar">
<div class="cfg-bar">
    @Selectors
    <div class="cfg-divider"></div>
    <div class="cfg-col">
        <button type="button" class="cfg-load-btn" @onclick="LoadRequirements" disabled="@(loading || LoadBlocked is not null)" title="@LoadBlocked">
            @if (loading) { <span class="spin spin-sm"></span> } else { <span aria-hidden="true">⬇</span> }
            Load Requirements
        </button>
    </div>
</div>
@if (Requirements.Count > 0)
{
    <div class="cfg-bar-filters">
        <div class="tc-f-search"><div class="cfg-field"><label class="cfg-label">🔍 Search</label><input class="cfg-fi" placeholder="ID, title, assignee…" aria-label="Search requirements" value="@State.SearchQ" @oninput="OnSearch" /></div></div>
        <div class="tc-f-pick"><div class="cfg-field"><label class="cfg-label">🏷 Type</label>
            <GlassDropdown Value="@State.TypeFilter" Placeholder="All" EmptyLabel="All" EmptyValue="" Label="Type" Options="@TypeOptions" OnChange="OnType" /></div></div>
        <div class="tc-f-pick"><div class="cfg-field"><label class="cfg-label">👤 Assignee</label>
            <GlassDropdown Value="@State.AssigneeFilter" Placeholder="All" EmptyLabel="All" EmptyValue="" Label="Assignee" Options="@AssigneeOptions()" OnChange="OnAssignee" /></div></div>
    </div>
}
</div>
@if (!string.IsNullOrEmpty(error)) { <div class="notice warn" role="alert">⚠ @error</div> }
<div class="content">
    <div class="gpanel tc-panel">
        @* How the tab works is the Task Creation tab's tooltip, so the heading keeps to the title and the count. *@
        <div class="phead">
            <span class="ptitle">🧩 Create Tasks</span>
            @if (Requirements.Count > 0) { <span class="si-count">@ItemCountText</span> }
        </div>
        <div class="pbody">
            <div class="sr-only" role="status">@announcement</div>
            @if (loading)
            {
                <LoadingState>Reading requirements, change requests and bugs for <b>@AreaSprintSelect.Describe(Area, Sprint)</b></LoadingState>
            }
            else if (LoadedEmpty)
            {
                <BlankState Glyph="@Icons.TabTaskCreation" Title="Nothing to add tasks to">This area and sprint have no requirements, change requests or bugs.</BlankState>
            }
            else if (Requirements.Count == 0)
            {
                <BlankState Glyph="@Icons.TabTaskCreation" Title="Nothing loaded yet">
                    Select an area and sprint, then <b>Load Requirements</b> to list the items you can add the standard tasks to.
                </BlankState>
            }
            else
            {
                var rows = Filtered();
                <table class="req-table">
                    <thead><tr><th class="tc-c-id">ID</th><th>Title</th><th class="tc-c-type">Type</th><th class="tc-c-user">Assigned</th><th class="tc-c-state">State</th><th class="tc-c-act"></th></tr></thead>
                    @* One Tab stop: the arrow keys move between the rows' buttons (app.js), and the IDs open TFS for the
                       pointer only; the dialog's "#id" is the keyboard's way to TFS. *@
                    <tbody class="@arrival.Class" data-roving data-roving-stop>
                        @if (rows.Count == 0)
                        {
                            <tr><td colspan="6" class="tbl-empty">No items match the filters.</td></tr>
                        }
                        @foreach (var r in rows)
                        {
                            <tr @key="r.Id">
                                <td><a class="id-link" href="@TfsApi.WorkItemUrl(r.Project, r.Id)" target="_blank" rel="noopener" tabindex="-1">#@r.Id</a></td>
                                <td class="tc-title" title="@r.Title">@r.Title</td>
                                <td class="tc-clip"><span class="type-pill @WorkItemBadges.TypeClass(r.Type)">@r.Type</span></td>
                                <td class="tc-clip tc-user">@r.Assigned</td>
                                <td class="tc-clip"><span class="state-pill @WorkItemBadges.StateClass(r.State)">@r.State</span></td>
                                <td class="tc-act">
                                    <button type="button" class="si-row-act" data-roving-item tabindex="@(ReferenceEquals(r, rows[0]) ? "0" : "-1")"
                                            aria-label="@RowActionName(r)" @onclick="() => OpenCreate(r)">
                                        @if (State.CreatedCounts.TryGetValue(r.Id, out var n) && n > 0) { <text>✅ @n Created · add more</text> }
                                        else { <text>Create Tasks</text> }
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@if (target != null)
{
    <ModalDialog CssClass="tc-dialog" OnClose="CloseCreate">
        <Title>
            Create tasks under <a class="tc-dialog-link" href="@TfsApi.WorkItemUrl(target.Project, target.Id)" target="_blank" rel="noopener">#@target.Id<span class="sr-only"> (opens TFS in a new tab)</span></a>
        </Title>
        <ChildContent>
                <div class="si-dialog-sub">@target.Title</div>
                @if (confirmShown)
                {
                    <div class="notice info">Create these @confirmTitles.Count task(s)? They'll be children of #@target.Id with a <b>@PlanningTaskCatalog.TagFor(target.Type)</b> tag.</div>
                    <ul class="si-confirm-list">
                        @foreach (var t in confirmTitles) { <li>@t</li> }
                    </ul>
                }
                else
                {
                    <label class="cat-defaults" title="Ticks the standard set for a @(target.Type) in one go: @DefaultTasksList. Without it, each box creates only its own task.">
                        <input type="checkbox" checked="@selection.AllDefaultsSelected" @onchange="() => selection.ToggleDefaults()" />
                        <span>Default tasks</span>
                        <span class="cat-defaults-count">@selection.SelectedDefaults of @selection.Defaults.Count</span>
                    </label>
                    <div class="cat-grid">
                        @foreach (var grp in PlanningTaskCatalog.Categories.GroupBy(c => c.Group))
                        {
                            <div>
                                <div class="cat-head">@(grp.Key == "dev" ? "Development" : "Test")</div>
                                @foreach (var cat in grp)
                                {
                                    <label class="cat-item">
                                        <input type="checkbox" checked="@selection.Contains(cat.Prefix)" @onchange="() => selection.Toggle(cat.Prefix)" />
                                        <span>@cat.Prefix</span>
                                        @if (selection.IsDefault(cat.Prefix)) { <span class="cat-default" title="One of the default tasks for a @target.Type">default</span> }
                                        @if (createdThisSession.Contains(cat.Prefix)) { <span class="cat-done">✓ Created</span> }
                                    </label>
                                    @if (cat.ExecTypes.Length > 1)
                                    {
                                        <div class="cat-exec">
                                            @foreach (var opt in cat.ExecTypes)
                                            {
                                                <label class="cat-exec-opt">
                                                    <input type="radio" name="@ExecGroupName(cat.Prefix)" checked="@(SelectedExec(cat) == opt)"
                                                           @onchange="() => selectedExec[cat.Prefix] = opt" />
                                                    <span>@opt</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="cat-exec-single">⚙ @cat.ExecTypes[0]</div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
                <div role="status">
                    @if (!string.IsNullOrEmpty(createResult))
                    {
                        <div class="si-create-result @(createOk ? "ok" : "bad")">@createResult</div>
                    }
                </div>
        </ChildContent>
        <Actions>
                @if (confirmShown)
                {
                    <button type="button" class="btn-ghost" @onclick="() => confirmShown = false" disabled="@creating">Back</button>
                    <button type="button" class="btn-primary" @onclick="ConfirmCreate" disabled="@creating">
                        @if (creating) { <span class="spin spin-sm"></span> }
                        Confirm & Create
                    </button>
                }
                else
                {
                    <button type="button" class="btn-ghost" @onclick="CloseCreate">Close</button>
                    <button type="button" class="btn-primary" @onclick="PrepareConfirm" disabled="@(selection.Count == 0)">
                        Create Selected Tasks (@selection.Count)
                    </button>
                }
        </Actions>
    </ModalDialog>
}

@code {
    private static readonly List<GlassDropdown.DropdownOption> TypeOptions = new()
    {
        new() { Value = "Requirement", Label = "Requirement" },
        new() { Value = "Change Request", Label = "Change Request" },
        new() { Value = "Bug", Label = "Bug" }
    };

    [Parameter] public TfsArea? Area { get; set; }
    [Parameter] public string? Sprint { get; set; }

    /// <summary>The page's shared area and sprint pickers, rendered at the start of the bar.</summary>
    [Parameter] public RenderFragment? Selectors { get; set; }

    private bool loading;
    private string? error;

    private WorkItem? target;

    // Replaced per parent: a Bug's default tasks are not a Requirement's.
    private TaskCreationSelection selection = new(PlanningTaskCatalog.DefaultTasksFor(null));
    private readonly HashSet<string> createdThisSession = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> selectedExec = new(StringComparer.Ordinal);
    private List<string> confirmTitles = new();
    private bool confirmShown, creating, createOk;
    private string? createResult;

    // Kept in PageState so the list and the "n Created" badges survive switching tabs.
    private TaskCreationState State => PageState.TaskCreation;

    // Leaving Sprint Insights stops the list's read (a tab switch only hides this panel); tasks being created are
    // left to finish.
    private readonly PageLifetime page = new();
    private readonly ArrivalCue arrival = new();

    // What a screen reader is told once a load finishes; a failure is the alert notice.
    private string announcement = "";

    private string SelectionKey => AreaSprintSelect.Key(Area, Sprint);

    private string? LoadBlocked => AreaSprintSelect.MissingSelection(Area, Sprint);

    // Loaded for the area and sprint picked now, and nothing came back: an answer, not a failure.
    private bool LoadedEmpty => State.LoadedKey.Length > 0 && State.LoadedKey == SelectionKey && State.Requirements.Count == 0;

    // A list loaded for another area or sprint is hidden rather than shown under the new
    // selection: creating from it would put tasks into a sprint their requirement isn't in.
    private IReadOnlyList<WorkItem> Requirements =>
        State.LoadedKey.Length > 0 && State.LoadedKey == SelectionKey ? State.Requirements : Array.Empty<WorkItem>();

    private List<WorkItem> Filtered() => Requirements.Where(Matches).ToList();

    private List<GlassDropdown.DropdownOption> AssigneeOptions() => Requirements
        .Select(r => r.Assigned).Where(a => !string.IsNullOrEmpty(a)).Distinct().OrderBy(a => a)
        .Select(a => new GlassDropdown.DropdownOption { Value = a, Label = a }).ToList();

    private async Task LoadRequirements()
    {
        var area = Area;
        var sprint = Sprint;
        if (area == null || string.IsNullOrEmpty(sprint)) return;

        var key = SelectionKey;
        loading = true; error = null; announcement = "";
        State.LoadedKey = ""; State.Requirements = new(); State.CreatedCounts = new();
        StateHasChanged();
        try
        {
            var iterPath = TfsApiService.ToWiqlPath(sprint);
            var areaPath = TfsApiService.ToWiqlPath(area.Path);
            var items = await TfsApi.LoadPlanningItemsAsync(area.Project, iterPath, page.Token);
            State.Requirements = items.Where(r => InArea(r, areaPath)).ToList();
            State.LoadedKey = key;
            State.LoadedSprint = sprint;
            State.SearchQ = ""; State.TypeFilter = ""; State.AssigneeFilter = "";
            arrival.Mark();
            announcement = State.Requirements.Count == 0
                ? "This area and sprint have no requirements, change requests or bugs."
                : $"Loaded {State.Requirements.Count} items.";
        }
        catch (OperationCanceledException ex) when (page.Token.IsCancellationRequested)
        {
            Logger.LogDebug(ex, "Task Creation load for {Area} / {Sprint} stopped because the page was left", area.Path, sprint);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Task Creation load failed for {Area} / {Sprint}", area.Path, sprint);
            error = $"Load failed: {TfsErrors.Describe(ex)}";
        }
        finally
        {
            loading = false;
        }
    }

    private static bool InArea(WorkItem r, string areaPath) =>
        r.Area.Replace("\\Area\\", "\\").Contains(areaPath, StringComparison.OrdinalIgnoreCase)
        || r.Area.Equals(areaPath, StringComparison.OrdinalIgnoreCase);

    private void OpenCreate(WorkItem r)
    {
        target = r;
        selection = new TaskCreationSelection(PlanningTaskCatalog.DefaultTasksFor(r.Type));
        createdThisSession.Clear(); selectedExec.Clear();
        confirmShown = false; createResult = null;
    }

    private string DefaultTasksList => string.Join(", ", selection.Defaults);

    private void CloseCreate() { target = null; confirmShown = false; }

    // Names the row's button for a screen reader: which item it is for, and how many tasks it has made there.
    private string RowActionName(WorkItem r) =>
        State.CreatedCounts.TryGetValue(r.Id, out var n) && n > 0 ? $"{n} created under #{r.Id}, add more" : $"Create tasks under #{r.Id}";

    private string SelectedExec(PlanningCategory cat) => selectedExec.TryGetValue(cat.Prefix, out var v) ? v : cat.ExecTypes[0];
    private static string ExecGroupName(string prefix) => "exec-" + new string(prefix.Where(char.IsLetterOrDigit).ToArray());
    private static string TaskTitle(PlanningCategory cat, WorkItem parent) => $"{cat.Prefix} : {parent.Title}";

    private void PrepareConfirm()
    {
        var parent = target;
        if (parent == null || selection.Count == 0) return;
        confirmTitles = selection.InCatalogOrder().Select(c => $"{TaskTitle(c, parent)}  ·  {SelectedExec(c)}").ToList();
        confirmShown = true; createResult = null;
    }

    private async Task ConfirmCreate()
    {
        var parent = target;
        if (parent == null || selection.Count == 0 || string.IsNullOrEmpty(State.LoadedSprint)) return;
        creating = true;
        StateHasChanged();

        var iterPath = TfsApiService.ToWiqlPath(State.LoadedSprint);
        var tag = PlanningTaskCatalog.TagFor(parent.Type);
        var failed = new List<string>();
        var firstFailure = "";
        var created = 0;
        foreach (var cat in selection.InCatalogOrder())
        {
            try
            {
                var task = new ChildTaskRequest(parent.Project, parent.Id, TaskTitle(cat, parent), cat.Discipline, parent.Area, iterPath)
                {
                    ExecutionType = SelectedExec(cat),
                    Tag = tag
                };
                await TfsApi.CreateChildTaskAsync(task, CancellationToken.None);
                created++;
                createdThisSession.Add(cat.Prefix);
            }
            catch (Exception ex)
            {
                // One rejected task must not stop the rest of the set; it stays ticked for a retry.
                Logger.LogError(ex, "Creating '{Prefix}' under #{ParentId} failed", cat.Prefix, parent.Id);
                failed.Add(cat.Prefix);
                if (firstFailure.Length == 0)
                {
                    firstFailure = TfsErrors.Describe(ex);
                }
            }
        }

        if (created > 0) State.CreatedCounts[parent.Id] = State.CreatedCounts.GetValueOrDefault(parent.Id) + created;
        selection.RetainOnly(failed);
        confirmShown = false;
        createOk = failed.Count == 0;
        createResult = createOk
            ? $"✓ Created {created} task(s) tagged {tag}."
            : $"Created {created}, {failed.Count} failed: {string.Join(", ", failed)} ({firstFailure.TrimEnd('.')}). They are still ticked, so you can try again.";
        creating = false;
    }

    private bool Matches(WorkItem r) =>
        (string.IsNullOrEmpty(State.SearchQ)
            || r.Id.Contains(State.SearchQ, StringComparison.OrdinalIgnoreCase)
            || r.Title.Contains(State.SearchQ, StringComparison.OrdinalIgnoreCase)
            || r.Assigned.Contains(State.SearchQ, StringComparison.OrdinalIgnoreCase))
        && (string.IsNullOrEmpty(State.TypeFilter) || r.Type == State.TypeFilter)
        && (string.IsNullOrEmpty(State.AssigneeFilter) || r.Assigned == State.AssigneeFilter);

    /// <summary>"10/34 item(s)" once a filter hides some, so the one count also says how many were loaded.</summary>
    private string ItemCountText
    {
        get
        {
            var shown = Requirements.Count(Matches);
            return shown == Requirements.Count ? $"{shown} item(s)" : $"{shown}/{Requirements.Count} item(s)";
        }
    }

    private void OnSearch(ChangeEventArgs e) => State.SearchQ = e.Value?.ToString() ?? "";
    private void OnType(ChangeEventArgs e) => State.TypeFilter = e.Value?.ToString() ?? "";
    private void OnAssignee(ChangeEventArgs e) => State.AssigneeFilter = e.Value?.ToString() ?? "";

    public void Dispose() => page.Dispose();
}
