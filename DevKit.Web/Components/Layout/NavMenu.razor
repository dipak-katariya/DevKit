@inject NavigationManager Nav
@implements IDisposable

<nav class="sidebar-nav">
    <a class="nav-item @ActiveClass(ToolCatalog.Dashboard.Path)" href="@ToolCatalog.Dashboard.Path"
       @onclick="() => Go(ToolCatalog.Dashboard.Path)" @onclick:preventDefault>
        <Icon Inner="@ToolCatalog.Dashboard.Icon" />
        <span>@ToolCatalog.Dashboard.Name</span>
    </a>

    <div class="sidebar-cap">Tools</div>
    @foreach (var tool in ToolCatalog.Tools)
    {
        <a class="nav-item @ActiveClass(tool.Path)" href="@tool.Path"
           @onclick="() => Go(tool.Path)" @onclick:preventDefault>
            <Icon Inner="@tool.Icon" />
            <span>@tool.Name</span>
        </a>
    }
</nav>

<div class="sidebar-foot">
    <a class="nav-item @ActiveClass(ToolCatalog.Settings.Path)" href="@ToolCatalog.Settings.Path"
       @onclick="() => Go(ToolCatalog.Settings.Path)" @onclick:preventDefault>
        <Icon Inner="@ToolCatalog.Settings.Icon" />
        <span>@ToolCatalog.Settings.Name</span>
    </a>
</div>

@code {
    protected override void OnInitialized() => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => StateHasChanged();

    private string ActiveClass(string path)
    {
        var current = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        var target = path.TrimEnd('/');
        if (string.IsNullOrEmpty(target)) return string.IsNullOrEmpty(current) ? "active" : "";
        return current.Equals(target, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    private void Go(string path) => Nav.NavigateTo(path);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
