<?xml version="1.0" encoding="utf-8"?>
<!--
  DevKit takes every package from nuget.org alone, whatever feeds this machine knows: with two feeds, a package of the
  same name on the other one could be picked instead (dependency confusion). The runtime packs of a self-contained
  package, the test framework and SonarAnalyzer all come from nuget.org.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
