@inherits ClickOutsideComponent

@* Searchable single-select. Only a bounded slice is rendered, so a list with thousands of
   options cannot flood the DOM. BranchPicker and MultiSelectDropdown use the same cap.
   The trigger is a button and the search box a combobox over the list, so it works from the
   keyboard alone and a screen reader hears the list and the option the arrows reached. *@

@{ var triggerText = TriggerText; }
<div class="gdd @(IsOpen ? "gdd-open" : "") @CssClass" @ref="Root" style="@Style">
    <button type="button" class="gdd-trigger" @ref="trigger" @onclick="Toggle" @onclick:stopPropagation
            disabled="@Disabled" aria-haspopup="listbox" aria-expanded="@(IsOpen ? "true" : "false")"
            aria-label="@(Label is null ? null : $"{Label}: {triggerText}")">
        <span class="gdd-value @(string.IsNullOrEmpty(Value) ? "gdd-placeholder" : "")" title="@(string.IsNullOrEmpty(Value) ? null : triggerText)">@triggerText</span>
        <span class="gdd-arrow" aria-hidden="true">▾</span>
    </button>

    @if (IsOpen)
    {
        var render = BuildRender();
        var showAll = ShowAllRow;
        var index = 0;
        <div class="gdd-panel" @onclick:stopPropagation>
            <div class="gdd-search-wrap">
                @* Keydown stops here, so Escape closes only this list and not a popover the dropdown sits in. *@
                <input class="gdd-search" type="text" placeholder="Search…" autocomplete="off"
                       role="combobox" aria-label="@Label" aria-autocomplete="list" aria-expanded="true"
                       aria-controls="@PanelId" aria-activedescendant="@(highlightIdx >= 0 ? OptionId(highlightIdx) : null)"
                       @oninput="OnSearchInput" @ref="searchInput" @onkeydown="OnKeyDown" @onkeydown:stopPropagation />
            </div>
            @* tabindex -1: a list that scrolls is otherwise a Tab stop of its own in Chrome, and the arrows already
               move through it from the search box. *@
            <div class="gdd-list" id="@PanelId" role="listbox" aria-label="@Label" tabindex="-1">
                @if (showAll)
                {
                    var allIdx = index++;
                    var allOn = string.IsNullOrEmpty(Value);
                    <div class="gdd-item @(allOn ? "gdd-item-active" : "") @(highlightIdx == allIdx ? "gdd-item-hl" : "")"
                         id="@OptionId(allIdx)" role="option" aria-selected="@(allOn ? "true" : "false")"
                         @onclick="SelectEmpty">
                        @(EmptyLabel ?? Placeholder)
                    </div>
                }

                @foreach (var grp in render.Groups)
                {
                    var named = !string.IsNullOrEmpty(grp.Label);
                    <div role="group" aria-label="@(named ? grp.Label : null)">
                        @if (named)
                        {
                            <div class="gdd-group" aria-hidden="true">@grp.Label</div>
                        }
                        @foreach (var opt in grp.Options)
                        {
                            var idx = index++;
                            var isOn = opt.Value == Value;
                            <div class="gdd-item @(isOn ? "gdd-item-active" : "") @(highlightIdx == idx ? "gdd-item-hl" : "")"
                                 id="@OptionId(idx)" role="option" aria-selected="@(isOn ? "true" : "false")"
                                 title="@opt.Label" @onclick="() => Select(opt.Value)">
                                @opt.Label
                            </div>
                        }
                    </div>
                }
            </div>
            @if (render.Total == 0)
            {
                <div class="gdd-empty" role="status">No results</div>
            }
            @if (render.Hidden > 0)
            {
                <div class="bpk-more">@render.Hidden more. Type to narrow the list.</div>
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// Rows put in the DOM at once. Every option used to be rendered, which on a repository with
    /// thousands of refs meant thousands of elements pushed over the circuit on every keystroke.
    /// </summary>
    private const int MaxRendered = 60;

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback<ChangeEventArgs> OnChange { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select";
    [Parameter] public string? EmptyLabel { get; set; }
    [Parameter] public string? EmptyValue { get; set; }
    [Parameter] public bool ShowEmptyOption { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter] public List<DropdownOption>? Options { get; set; }
    [Parameter] public List<DropdownGroup>? Groups { get; set; }

    /// <summary>What the field is, such as "Area path". Screen readers then hear the trigger as "Area path: value".</summary>
    [Parameter] public string? Label { get; set; }

    private bool IsOpen;
    private string searchText = "";

    // Counts the "All" row first when it is shown, then the rendered options in order.
    private int highlightIdx = -1;
    private ElementReference searchInput;
    private ElementReference trigger;

    protected override bool IsPanelOpen => IsOpen;

    private bool HasGroups => Groups is { Count: > 0 };

    // Matches the pre-cap behaviour: an empty Options list still offers the "All" row, which
    // is what the type and assignee filters show before any work items have loaded.
    private bool HasSource => HasGroups || Options != null;

    private bool ShowAllRow => ShowEmptyOption && HasSource;

    private string TriggerText => string.IsNullOrEmpty(Value) ? Placeholder : GetDisplayText(Value);

    private string OptionId(int index) => $"{PanelId}-{index}";

    /// <summary>What one render of the open panel shows, plus how much was left out.</summary>
    private sealed record RenderModel(List<DropdownGroup> Groups, int Total, int Hidden);

    /// <summary>
    /// Filters and caps in a single pass, and is built once per render. The previous version
    /// resolved each row's highlight position by rebuilding and rescanning the filtered list,
    /// which made rendering O(n²). That is why a large list froze the page on every keystroke.
    /// </summary>
    private RenderModel BuildRender()
    {
        var groups = new List<DropdownGroup>();
        var total = 0;
        var rendered = 0;

        if (HasGroups)
        {
            foreach (var grp in Groups!)
            {
                var matched = Match(grp.Options);
                total += matched.Count;

                var budget = MaxRendered - rendered;
                if (budget <= 0 || matched.Count == 0) continue;

                var take = matched.Count <= budget ? matched : matched.GetRange(0, budget);
                rendered += take.Count;
                groups.Add(new DropdownGroup { Label = grp.Label, Options = take });
            }
        }
        else if (Options is { Count: > 0 })
        {
            var matched = Match(Options);
            total = matched.Count;

            var take = matched.Count <= MaxRendered ? matched : matched.GetRange(0, MaxRendered);
            rendered = take.Count;
            groups.Add(new DropdownGroup { Label = "", Options = take });
        }

        return new RenderModel(groups, total, total - rendered);
    }

    private List<DropdownOption> Match(List<DropdownOption>? options)
    {
        if (options is null) return new List<DropdownOption>();
        if (string.IsNullOrEmpty(searchText)) return options;
        return options.Where(o => o.Label.Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private string GetDisplayText(string val)
    {
        if (Groups != null)
        {
            foreach (var g in Groups)
                foreach (var o in g.Options)
                    if (o.Value == val) return o.Label;
        }
        if (Options != null)
        {
            var match = Options.FirstOrDefault(o => o.Value == val);
            if (match != null) return match.Label;
        }
        return val;
    }

    private async Task Toggle()
    {
        if (Disabled)
        {
            return;
        }
        IsOpen = !IsOpen;
        searchText = "";
        highlightIdx = -1;
        if (IsOpen)
        {
            await Task.Yield();
            await FocusAsync(searchInput);
        }
    }

    protected override Task CloseFromOutsideAsync()
    {
        IsOpen = false;
        searchText = "";
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>Closes from the keyboard or a choice. Focus goes back to the trigger, since the search box it was in is gone.</summary>
    private async Task CloseToTriggerAsync()
    {
        IsOpen = false;
        searchText = "";
        highlightIdx = -1;
        await FocusAsync(trigger);
    }

    private Task SelectEmpty() => Select(EmptyValue ?? "");

    private async Task Select(string value)
    {
        Value = value;
        await CloseToTriggerAsync();
        await ValueChanged.InvokeAsync(value);
        await OnChange.InvokeAsync(new ChangeEventArgs { Value = value });
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        highlightIdx = -1;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseToTriggerAsync();
            return;
        }

        // Only the rendered slice is navigable, which is also all the user can see.
        var values = NavigableValues();
        if (e.Key == "Enter")
        {
            if (highlightIdx >= 0 && highlightIdx < values.Count)
            {
                await Select(values[highlightIdx]);
            }
            return;
        }

        var step = e.Key switch { "ArrowDown" => 1, "ArrowUp" => -1, _ => 0 };
        if (step == 0 || values.Count == 0)
        {
            return;
        }
        highlightIdx = Math.Clamp(highlightIdx + step, 0, values.Count - 1);
        await RevealAsync(OptionId(highlightIdx));
    }

    /// <summary>The values the arrow keys move through, in the order the rows are shown.</summary>
    private List<string> NavigableValues()
    {
        var values = new List<string>();
        if (ShowAllRow)
        {
            values.Add(EmptyValue ?? "");
        }
        values.AddRange(BuildRender().Groups.SelectMany(g => g.Options).Select(o => o.Value));
        return values;
    }

    public class DropdownOption
    {
        public string Value { get; set; } = "";
        public string Label { get; set; } = "";
    }

    public class DropdownGroup
    {
        public string Label { get; set; } = "";
        public List<DropdownOption> Options { get; set; } = new();
    }
}
