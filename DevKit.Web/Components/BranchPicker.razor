@inherits ClickOutsideComponent

@* Searchable branch dropdown. Only a bounded slice is rendered, so a repository with
   thousands of refs cannot flood the DOM. Type to narrow the list; Enter picks the first match.
   Clear sits beside the trigger rather than inside it, since a button cannot hold another. *@

@{
    var shownText = string.IsNullOrEmpty(Value) ? Placeholder : Value;
    var clearable = !string.IsNullOrEmpty(Value) && !Disabled;
}
<div class="gdd bpk @(IsOpen ? "gdd-open" : "") @(clearable ? "bpk-clearable" : "") @CssClass" @ref="Root" style="@Style">
    <button type="button" class="gdd-trigger" @ref="trigger" @onclick="Toggle" @onclick:stopPropagation
            disabled="@Disabled" aria-haspopup="listbox" aria-expanded="@(IsOpen ? "true" : "false")"
            aria-label="@(Label is null ? null : $"{Label}: {shownText}")">
        <span class="gdd-value @(string.IsNullOrEmpty(Value) ? "gdd-placeholder" : "bpk-branch")" title="@(string.IsNullOrEmpty(Value) ? null : shownText)">@shownText</span>
        <span class="gdd-arrow" aria-hidden="true">▾</span>
    </button>
    @if (clearable)
    {
        <button type="button" class="bpk-clear" title="Clear" aria-label="@(Label is null ? "Clear" : $"Clear {Label}")"
                @onclick="Clear" @onclick:stopPropagation>✕</button>
    }

    @if (IsOpen && !Disabled)
    {
        <div class="gdd-panel" @onclick:stopPropagation>
            <div class="gdd-search-wrap">
                @* Keydown stops here, so Escape closes only this list and not the popover the picker sits in. *@
                <input class="gdd-search" type="text" placeholder="Search branches…" autocomplete="off"
                       role="combobox" aria-label="@Label" aria-autocomplete="list" aria-expanded="true" aria-controls="@PanelId"
                       @oninput="OnSearchInput" @ref="searchInput" @onkeydown="OnKeyDown" @onkeydown:stopPropagation />
            </div>
            @* A listbox only while it has branches, so the empty line below is read as a status, not a list item. It
               does the scrolling, with tabindex -1, because a list that scrolls is otherwise a Tab stop of its own
               in Chrome. *@
            <div id="@PanelId" class="gdd-scroll" tabindex="-1" role="@(Visible().Count > 0 ? "listbox" : null)" aria-label="@Label">
            <div class="gdd-list">
                @foreach (var b in Visible())
                {
                    <div class="gdd-item bpk-item @(b == Value ? "gdd-item-active" : "")" role="option"
                         aria-selected="@(b == Value ? "true" : "false")" title="@b" @onclick="() => Select(b)">@b</div>
                }
                @if (Visible().Count == 0)
                {
                    <div class="gdd-empty" role="status">
                        @if (Loading)
                        {
                            <span class="spin spin-sm"></span><span>Loading branches…</span>
                        }
                        else
                        {
                            @(Branches.Count == 0 ? "No branches loaded for this repository." : "No branches match.")
                        }
                    </div>
                }
            </div>
            </div>
            @if (HiddenCount > 0)
            {
                <div class="bpk-more">@HiddenCount more. Type to narrow the list.</div>
            }
        </div>
    }
</div>

@code {
    private const int MaxRendered = 60;

    /// <summary>Read-only so a caller can safely hand every empty picker one shared instance.</summary>
    [Parameter] public IReadOnlyList<string> Branches { get; set; } = Array.Empty<string>();
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select branch";
    [Parameter] public string? Style { get; set; }

    /// <summary>Extra classes on the shell, e.g. "fi-size" to match the form inputs around it.</summary>
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Shows a loading line in place of the empty message while branches are fetched.</summary>
    [Parameter] public bool Loading { get; set; }

    /// <summary>
    /// Raised when the panel opens. Lets a caller holding many repositories fetch that one
    /// repository's branches on demand instead of loading every repository up front.
    /// </summary>
    [Parameter] public EventCallback OnOpened { get; set; }

    /// <summary>What the field is, such as "QA branch". Screen readers then hear the trigger as "QA branch: value".</summary>
    [Parameter] public string? Label { get; set; }

    private bool IsOpen;
    private string searchText = "";
    private ElementReference searchInput;
    private ElementReference trigger;

    protected override bool IsPanelOpen => IsOpen;

    private List<string> Matches() => Branches
        .Where(b => string.IsNullOrEmpty(searchText) || b.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private List<string> Visible() => Matches().Take(MaxRendered).ToList();

    private int HiddenCount => Math.Max(0, Matches().Count - MaxRendered);

    private async Task Toggle()
    {
        if (Disabled)
        {
            return;
        }
        IsOpen = !IsOpen;
        searchText = "";
        if (IsOpen)
        {
            await OnOpened.InvokeAsync();
            await Task.Yield();
            await FocusAsync(searchInput);
        }
    }

    protected override Task CloseFromOutsideAsync()
    {
        IsOpen = false;
        searchText = "";
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task Select(string branch)
    {
        Value = branch;
        await CloseToTriggerAsync();
        await ValueChanged.InvokeAsync(branch);
    }

    private async Task Clear()
    {
        Value = "";
        await CloseToTriggerAsync();
        await ValueChanged.InvokeAsync("");
    }

    /// <summary>Closes after a choice, a clear or Escape. Focus goes back to the trigger, since what held it is gone.</summary>
    private async Task CloseToTriggerAsync()
    {
        IsOpen = false;
        searchText = "";
        await FocusAsync(trigger);
    }

    private void OnSearchInput(ChangeEventArgs e) => searchText = e.Value?.ToString() ?? "";

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { await CloseToTriggerAsync(); return; }
        if (e.Key != "Enter") return;

        var first = Visible().FirstOrDefault();
        if (first != null) await Select(first);
    }
}
