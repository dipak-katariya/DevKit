@page "/merge"
@inject TfsApiService TfsApi
@inject GitCommandService GitCmd
@inject SettingsService Settings
@inject PageStateService PageState
@inject BranchCacheService BranchCache
@inject ILogger<MergeTool> Logger
@inject IJSRuntime JS
@implements IDisposable

<div style="display:flex;flex-direction:column;gap:0;flex:1;overflow:hidden;">
    <!-- Config Bar -->
    <div class="cfg-bar">
        <div class="cfg-col" style="flex:0 0 auto;">
            <div class="cfg-field">
                <label class="cfg-label">📂 Area Path</label>
                <GlassDropdown Style="min-width:220px;"
                               Value="@(selectedArea != null ? AreaSprintSelect.Serialize(selectedArea) : "")"
                               Placeholder="— Select area —"
                               Disabled="@(areas.Count==0)"
                               Groups="@AreaGroups"
                               OnChange="OnAreaChange" />
            </div>
        </div>
        <div class="cfg-divider"></div>
        <div class="cfg-col" style="flex:0 0 auto;">
            <div class="cfg-field">
                <label class="cfg-label">📅 Sprint</label>
                <GlassDropdown Style="min-width:180px;"
                               Value="@(selectedSprint ?? "")"
                               Placeholder="— All —"
                               EmptyLabel="— All —" EmptyValue=""
                               Disabled="@(iterations.Count==0)"
                               Groups="@SprintGroups"
                               OnChange="OnSprintChange" />
            </div>
        </div>
        <div class="cfg-divider"></div>
        <div class="cfg-col" style="flex:0 0 auto;">
            <div class="cfg-field">
                <label class="cfg-label">💻 Local Repository</label>
                <GlassDropdown Style="min-width:220px;"
                               Value="@selectedLocalRepoPath"
                               Placeholder="— Select local repo —"
                               Disabled="@(localRepoOptions.Count==0)"
                               Options="@localRepoOptions"
                               OnChange="OnLocalRepoChange" />
            </div>
        </div>
        <div class="cfg-divider"></div>
        <div class="cfg-col" style="flex:0 0 auto;">
            <div class="cfg-field">
                <label class="cfg-label">🌿 Base Branch</label>
                <GlassDropdown Style="min-width:180px;"
                               Value="@globalBaseBranch"
                               Placeholder="— Select branch —"
                               Disabled="@(string.IsNullOrEmpty(selectedLocalRepoPath) || globalBranches.Count==0)"
                               ShowEmptyOption="false"
                               Options="@GlobalBranchOptions"
                               OnChange="OnGlobalBranchChange" />
            </div>
        </div>
        <div class="cfg-divider"></div>
        <div class="cfg-col" style="flex:0 0 auto;">
            <button class="cfg-load-btn" @onclick="LoadWorkItems" disabled="@(selectedArea == null || loading)">
                @if (loading) { <span class="spin spin-sm" style="color:var(--text);"></span> }
                else { <span>⬇</span> }
                Load
            </button>
            @if (workItems.Count > 0) { <span class="chip chip-green" style="font-size:.56rem;">@workItems.Count items</span> }
        </div>
    </div>

    <!-- Filter bar -->
    <div class="cfg-bar-filters">
        <div style="flex:2;"><div class="cfg-field"><label class="cfg-label">🔍 Search</label><input class="cfg-fi" placeholder="ID, title, assignee…" @oninput="OnSearch" /></div></div>
        <div style="flex:1;"><div class="cfg-field"><label class="cfg-label">🏷 Type</label>
            <GlassDropdown Value="@typeFilter" Placeholder="— All —" EmptyLabel="— All —" EmptyValue=""
                           Options="@TypeOptions" OnChange="OnTypeFilter" />
        </div></div>
        <div style="flex:1;"><div class="cfg-field"><label class="cfg-label">👤 Assignee</label>
            <GlassDropdown Value="@assigneeFilter" Placeholder="— All —" EmptyLabel="— All —" EmptyValue=""
                           Options="@AssigneeOptions" OnChange="OnAssigneeFilter" />
        </div></div>
    </div>

    <!-- Main: left table + right PR view -->
    <div class="content" style="flex:1;overflow:hidden;">
        <!-- LEFT: Work Items -->
        <div class="content-left">
            <div class="gpanel" style="flex:1;display:flex;flex-direction:column;overflow:hidden;">
                <div class="phead">
                    <span class="ptitle">📋 Requirements / Change Requests / Bugs</span>
                    @if (filtered.Count > 0) { <span class="chip chip-cyan">@filtered.Count item(s)</span> }
                </div>
                <div class="pbody" style="padding:0;flex:1;overflow:hidden;">
                    <div class="grid-wrap" style="overflow:auto;height:100%;">
                        <table class="req-table">
                            <thead><tr>
                                <th style="width:70px;" @onclick='()=>Sort("id")'>ID</th>
                                <th @onclick='()=>Sort("title")'>Title & Details</th>
                                <th style="width:80px;" @onclick='()=>Sort("state")'>State</th>
                                <th style="width:110px;" @onclick='()=>Sort("assigned")'>Assigned</th>
                            </tr></thead>
                            <tbody>
                                @if (filtered.Count == 0)
                                {
                                    <tr><td colspan="4" class="tbl-empty">@(workItems.Count==0?"Select area, then Load":"No items match.")</td></tr>
                                }
                                @foreach (var item in filtered)
                                {
                                    <tr class="@(selectedItemId == item.Id ? "selected" : "")" @onclick="()=>SelectItem(item.Id)">
                                        <td><a class="id-link" href="@TfsApi.WorkItemUrl(item.Project,item.Id)" target="_blank" @onclick:stopPropagation>#@item.Id</a></td>
                                        <td><span class="type-pill @TypeCls(item.Type)">@item.Type</span><div class="cell-title">@item.Title</div><div class="cell-meta">@item.Area.Split('\\').LastOrDefault()</div></td>
                                        <td><span class="state-pill @StateCls(item.State)">@item.State</span></td>
                                        <td style="font-size:.7rem;">@item.Assigned</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: PR & Commit View -->
        <div class="content-right">
            <div class="gpanel">
                <div class="phead">
                    <span class="ptitle">⛙ Pull Requests & Commits</span>
                    <div style="display:flex;gap:6px;align-items:center;">
                        @if (repoPRs.Count > 0)
                        {
                            <button class="btn-sm" @onclick="LoadPRs">⟳ Refresh</button>
                            <span style="font-size:.58rem;color:var(--muted);">@repoPRs.Values.Sum(r=>r.Prs.Count) PR(s)</span>
                        }
                        <button class="btn-sm @(prSortDesc ? "btn-sm-active" : "")" @onclick="TogglePrSort" title="Toggle sort order">
                            @(prSortDesc ? "↓ Newest" : "↑ Oldest")
                        </button>
                    </div>
                </div>
                <div class="pbody" style="padding:0;">
                    @if (string.IsNullOrEmpty(selectedItemId))
                    {
                        <div class="pr-placeholder">
                            <div style="font-size:2rem;opacity:.2;">⛙</div>
                            <div class="bp-title">Select a Work Item</div>
                            <div class="bp-sub">Click a row in the table to view<br/>related Pull Requests & commits.</div>
                        </div>
                    }
                    else if (loadingPRs)
                    {
                        <div style="padding:30px;text-align:center;"><div class="spin" style="color:var(--accent);width:24px;height:24px;border-width:2.5px;margin:0 auto;"></div><div style="font-size:.73rem;color:var(--muted);margin-top:10px;">Searching PRs across @repos.Count repos…</div></div>
                    }
                    else if (repoPRs.Count == 0 && !loadingPRs)
                    {
                        <div class="pr-placeholder">
                            <div style="font-size:2rem;opacity:.2;">🔍</div>
                            <div class="bp-title">No Pull Requests Found</div>
                            <div class="bp-sub">No PRs reference the selected work item ID.</div>
                        </div>
                    }
                    else
                    {
                        <!-- Selected item summary -->
                        @if (GetSelectedItem() is WorkItem selItem)
                        {
                            <div class="sel-bar">
                                <span class="sel-chip @(selItem.Type == "Requirement" ? "sel-chip-req" : selItem.Type == "Bug" ? "sel-chip-bug" : "sel-chip-chr")">
                                    @selItem.Type
                                </span>
                                <span style="font-size:.68rem;font-weight:600;">#@selItem.Id — @selItem.Title</span>
                            </div>
                        }

                        <!-- Connection status -->
                        @if (!string.IsNullOrEmpty(selectedLocalRepoPath))
                        {
                            <div style="padding:6px 14px;font-size:.62rem;display:flex;align-items:center;gap:8px;border-bottom:1px solid rgba(255,255,255,.04);background:rgba(100,100,120,.03);">
                                <span style="color:var(--green);">●</span>
                                <span style="font-weight:700;">@selectedLocalRepoName</span>
                                <span style="color:var(--muted);">→</span>
                                <span class="proj-branch-badge">@(string.IsNullOrEmpty(globalBaseBranch) ? "none" : globalBaseBranch)</span>
                                <span style="font-family:var(--mono);font-size:.58rem;color:var(--muted);margin-left:auto;">@selectedLocalRepoPath</span>
                            </div>
                        }

                        @foreach (var kv in repoPRs)
                        {
                            var repoId = kv.Key;
                            var data = kv.Value;
                            var dn = $"{data.Repo.Project} / {data.Repo.Name}";
                            var collapsed = collapsedProjects.Contains(repoId);

                            <div class="proj-section">
                                <div class="proj-hdr" @onclick="()=>ToggleProject(repoId)">
                                    <span class="proj-name">@dn</span>
                                    @if (!string.IsNullOrEmpty(globalBaseBranch)) { <span class="proj-branch-badge">→ @globalBaseBranch</span> }
                                    <span style="font-size:.6rem;color:var(--muted);margin-left:3px;">@data.Prs.Count PR(s)</span>
                                    <span class="proj-chevron">@(collapsed?"▶":"▼")</span>
                                </div>

                                @if (!collapsed)
                                {
                                    var sortedPrs = prSortDesc
                                        ? data.Prs.OrderByDescending(p => p.CreationDate).ToList()
                                        : data.Prs.OrderBy(p => p.CreationDate).ToList();

                                    @foreach (var pr in sortedPrs)
                                    {
                                        var prKey = $"{repoId}-{pr.PullRequestId}";
                                        var prCollapsed = collapsedPRs.Contains(prKey);

                                        <div class="mr-row">
                                            <div class="mr-hdr" @onclick="()=>TogglePR(prKey)">
                                                <span class="pr-badge @pr.StatusCss">@pr.StatusLabel</span>
                                                <span class="mr-title" title="@pr.Title">PR #@pr.PullRequestId — @pr.Title</span>
                                                <div class="mr-meta">
                                                    <span class="mr-branch">@pr.SourceBranch → @pr.TargetBranch</span>
                                                    <span>@pr.CreatedBy?.DisplayName</span>
                                                    <TimeStamp Value="@pr.CreationDate" Label="Raised" Empty="" />
                                                </div>
                                                <span style="color:var(--muted);font-size:.65rem;">@(prCollapsed?"▶":"▼")</span>
                                            </div>

                                            @if (!prCollapsed)
                                            {
                                                var sortedCommits = prSortDesc
                                                    ? pr.Commits.OrderByDescending(x => x.AuthorDate).ToList()
                                                    : pr.Commits.OrderBy(x => x.AuthorDate).ToList();

                                                @foreach (var c in sortedCommits)
                                                {
                                                    var cpKey = $"{c.CommitId}-{repoId}";
                                                    var cpHist = GetHistory(cpKey);
                                                    <div class="commit-row">
                                                        <a class="commit-sha" href="@TfsApi.CommitUrl(data.Repo.Project, data.Repo.Name, c.CommitId)" target="_blank">@c.ShortSha</a>
                                                        <span class="commit-msg" title="@c.Comment">@c.FirstLine</span>
                                                        <span class="commit-author">@c.AuthorName</span>
                                                        <TimeStamp Value="@c.AuthorDate" Label="Authored" Empty="" CssClass="commit-date" />
                                                        <span class="commit-status">
                                                            @if (cpHist != null)
                                                            {
                                                                <span class="cp-badge @CpBadgeCls(cpHist.Status)">@CpBadgeText(cpHist.Status)</span>
                                                            }
                                                        </span>
                                                        <button class="cp-btn" disabled="@(cpHist?.Status is CherryPickStatus.Done or CherryPickStatus.Resolved || string.IsNullOrEmpty(globalBaseBranch) || string.IsNullOrEmpty(selectedLocalRepoPath) || cherryPicking)"
                                                                @onclick="()=>DoCherryPick(c.CommitId, repoId, globalBaseBranch, selectedLocalRepoPath, c.FirstLine)">
                                                            ⛙ Pick
                                                        </button>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cherry-pick modal -->
@if (showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal" @onclick:stopPropagation>
            <h3>@modalTitle</h3>
            <div class="modal-body">
                @((MarkupString)modalBody)
            </div>
            <div class="modal-actions">
                <button class="btn-ghost" @onclick="CloseModal">Dismiss</button>
                @if (conflictRepoPath != null)
                {
                    <button class="btn-ghost" style="color:var(--accent2);" @onclick="OpenInVisualStudio">Open in Visual Studio</button>
                    <button class="btn-ghost" style="color:var(--green);" @onclick="MarkConflictResolved">Mark Resolved</button>
                }
            </div>
        </div>
    </div>
}
