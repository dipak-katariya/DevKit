{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5850",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "hosted": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://*:5850",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DevKit__Mode": "Hosted",
        "DEVKIT_NO_BROWSER": "1"
      }
    }
  }
}
