@inherits ClickOutsideComponent

@* A trigger and a panel floating over the page beneath it. A click anywhere outside closes it,
   through the outside-click listener the dropdowns use. The owner holds the open state. *@

<div class="pop @CssClass" @ref="Root">
    @Trigger
    @if (Open)
    {
        <div class="pop-panel @PanelClass" role="dialog" aria-label="@Label">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter, EditorRequired] public RenderFragment Trigger { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? CssClass { get; set; }

    /// <summary>Extra classes on the panel; they set its width and which edge it lines up with.</summary>
    [Parameter] public string? PanelClass { get; set; }

    /// <summary>Accessible name of the panel.</summary>
    [Parameter] public string? Label { get; set; }

    protected override bool IsPanelOpen => Open;

    // The owner decides; if it keeps the panel open, the next render adds the listener again.
    protected override Task CloseFromOutsideAsync() => OpenChanged.InvokeAsync(false);
}
