@inherits ClickOutsideComponent

@* Searchable multi-select built on the same .gdd-* shell as GlassDropdown. The arrow keys move
   through the options from the search box and Enter ticks one, so it works from the keyboard alone. *@

@{ var triggerLabel = TriggerLabel; }
<div class="gdd msd @(IsOpen ? "gdd-open" : "") @CssClass" @ref="Root" style="@Style">
    <button type="button" class="gdd-trigger" @ref="trigger" @onclick="Toggle" @onclick:stopPropagation
            disabled="@Disabled" aria-haspopup="listbox" aria-expanded="@(IsOpen ? "true" : "false")"
            aria-label="@(Label is null ? null : $"{Label}: {triggerLabel}")">
        <span class="gdd-value @(Selected.Count == 0 ? "gdd-placeholder" : "")" title="@SelectedLabels">@triggerLabel</span>
        @if (Selected.Count > 1)
        {
            <span class="msd-count" aria-hidden="true">@Selected.Count</span>
        }
        <span class="gdd-arrow" aria-hidden="true">▾</span>
    </button>

    @if (IsOpen && !Disabled)
    {
        <div class="gdd-panel" @onclick:stopPropagation>
            <div class="gdd-search-wrap">
                @* Keydown stops here, so Escape closes only this list and not a popover the dropdown sits in. *@
                <input class="gdd-search" type="text" placeholder="@SearchPlaceholder" autocomplete="off" value="@searchText"
                       role="combobox" aria-label="@Label" aria-autocomplete="list" aria-expanded="true"
                       aria-controls="@PanelId" aria-activedescendant="@ActiveOptionId"
                       @oninput="OnSearchInput" @ref="searchInput" @onkeydown="OnKeyDown" @onkeydown:stopPropagation />
            </div>

            <div class="msd-bulk">
                <button class="msd-bulk-btn" @onclick="SelectAllVisible" disabled="@(Visible().Count == 0)">
                    Select all@(HasSearch ? " matching" : "")
                </button>
                <button class="msd-bulk-btn" @onclick="ClearAll" disabled="@(Selected.Count == 0)">Clear</button>
            </div>

            @* A listbox only while it has options, so "No matches" is read as a status line, not as a list item. It
               does the scrolling, with tabindex -1, because a list that scrolls is otherwise a Tab stop of its own
               in Chrome, and the arrows already move through it from the search box. *@
            @{ var optionIndex = 0; }
            <div id="@PanelId" class="gdd-scroll" tabindex="-1" role="@(Visible().Count > 0 || CanCreate ? "listbox" : null)" aria-label="@Label" aria-multiselectable="true">
            <div class="gdd-list">
                @foreach (var opt in Visible())
                {
                    var isOn = Selected.Contains(opt.Value);
                    var idx = optionIndex++;
                    @* Pressing an option keeps focus in the search box, so the keys go on working after a click. *@
                    <div class="gdd-item msd-item @(isOn ? "gdd-item-active" : "") @(highlightIdx == idx ? "gdd-item-hl" : "")"
                         id="@OptionId(idx)" role="option" aria-selected="@(isOn ? "true" : "false")"
                         title="@(opt.Hint ?? opt.Label)" @onmousedown:preventDefault @onclick="() => ToggleValue(opt.Value)">
                        <span class="msd-box @(isOn ? "on" : "")" aria-hidden="true">@(isOn ? "✓" : "")</span>
                        <span class="msd-label">@opt.Label</span>
                    </div>
                }
                @if (CanCreate)
                {
                    @* Only where the page takes new values, and only for text no option already has. The arrow keys reach
                       it as the last row; Enter adds it once it is highlighted, or straight away when nothing else matches. *@
                    <div class="gdd-item msd-item msd-create @(highlightIdx == Visible().Count ? "gdd-item-hl" : "")" role="option" aria-selected="false" id="@CreateId"
                         @onmousedown:preventDefault @onclick="CreateAsync">
                        <span class="msd-box" aria-hidden="true">+</span>
                        <span class="msd-label">Add "@searchText.Trim()"</span>
                    </div>
                }
                else if (Visible().Count == 0)
                {
                    <div class="gdd-empty" role="status">No matches</div>
                }
            </div>
            </div>
            @if (HiddenCount > 0)
            {
                <div class="bpk-more">@HiddenCount more. Type to narrow the list.</div>
            }
        </div>
    }
</div>

@code {
    private const int MaxRendered = 80;

    public sealed class Option
    {
        public string Value { get; set; } = "";
        public string Label { get; set; } = "";
        /// <summary>Tooltip; falls back to the label.</summary>
        public string? Hint { get; set; }
    }

    [Parameter] public List<Option> Options { get; set; } = new();
    [Parameter] public HashSet<string> Selected { get; set; } = new();
    [Parameter] public EventCallback<HashSet<string>> SelectedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select";
    [Parameter] public string SearchPlaceholder { get; set; } = "Search…";
    [Parameter] public string ItemNoun { get; set; } = "item";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }

    /// <summary>What the field is, such as "Sprint". Screen readers then hear the trigger as "Sprint: value".</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>
    /// Set where a value the list does not have may be added, such as a new tag: the typed text is offered as "Add
    /// …", and handed here to check and add. Unset, the list takes only its own options.
    /// </summary>
    [Parameter] public EventCallback<string> OnCreate { get; set; }

    private bool CanCreate => OnCreate.HasDelegate && HasSearch && ExactMatch() is null;

    // The search worked out once per change of the typed text or the options, since the markup and the keys read it
    // many times over a list that can hold a project's every tag.
    private List<Option>? matchedOptions;
    private string matchedSearch = "";
    private List<Option> matches = new();
    private List<Option> visible = new();
    private Option? exactMatch;

    private void MatchSearch()
    {
        if (ReferenceEquals(matchedOptions, Options) && string.Equals(matchedSearch, searchText, StringComparison.Ordinal))
        {
            return;
        }

        matchedOptions = Options;
        matchedSearch = searchText;
        var typed = searchText.Trim();
        matches = Options.Where(o => !HasSearch || o.Label.Contains(searchText, StringComparison.OrdinalIgnoreCase)).ToList();
        visible = matches.Take(MaxRendered).ToList();
        exactMatch = HasSearch ? Options.FirstOrDefault(o => string.Equals(o.Label, typed, StringComparison.OrdinalIgnoreCase)) : null;
    }

    /// <summary>The option whose label is the typed text, in any case.</summary>
    private Option? ExactMatch()
    {
        MatchSearch();
        return exactMatch;
    }

    private string CreateId => $"{PanelId}-new";

    // The Add row counts as one past the last option, so the arrow keys and the screen reader reach it like the others.
    private string? ActiveOptionId
    {
        get
        {
            if (highlightIdx < 0)
            {
                return null;
            }

            return highlightIdx == Visible().Count && CanCreate ? CreateId : OptionId(highlightIdx);
        }
    }

    private bool IsOpen;
    private string searchText = "";
    private ElementReference searchInput;
    private ElementReference trigger;
    private int highlightIdx = -1;

    protected override bool IsPanelOpen => IsOpen;

    private bool HasSearch => !string.IsNullOrWhiteSpace(searchText);

    private List<Option> Visible()
    {
        MatchSearch();
        return visible;
    }

    private int HiddenCount
    {
        get
        {
            MatchSearch();
            return Math.Max(0, matches.Count - MaxRendered);
        }
    }

    private string TriggerLabel
    {
        get
        {
            if (Selected.Count == 0) return Placeholder;
            var first = Options.FirstOrDefault(o => Selected.Contains(o.Value));
            if (first is null) return $"{Selected.Count} {ItemNoun}(s) selected";
            return Selected.Count == 1 ? first.Label : $"{first.Label}  +{Selected.Count - 1}";
        }
    }

    // Every selected label for the trigger's tooltip, since the trigger names only the first.
    private string? SelectedLabels => Selected.Count == 0
        ? null
        : string.Join(", ", Options.Where(o => Selected.Contains(o.Value)).Select(o => o.Label));

    private async Task Toggle()
    {
        if (Disabled)
        {
            return;
        }
        IsOpen = !IsOpen;
        searchText = "";
        highlightIdx = -1;
        if (IsOpen)
        {
            await Task.Yield();
            await FocusAsync(searchInput);
        }
    }

    protected override Task CloseFromOutsideAsync()
    {
        IsOpen = false;
        searchText = "";
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ToggleValue(string value)
    {
        if (!Selected.Add(value)) Selected.Remove(value);
        return SelectedChanged.InvokeAsync(Selected);
    }

    private Task TickAsync(string value)
    {
        searchText = "";
        highlightIdx = -1;
        return Selected.Add(value) ? SelectedChanged.InvokeAsync(Selected) : Task.CompletedTask;
    }

    private Task SelectAllVisible()
    {
        Selected.UnionWith(Visible().Select(opt => opt.Value));
        return SelectedChanged.InvokeAsync(Selected);
    }

    private Task ClearAll()
    {
        Selected.Clear();
        return SelectedChanged.InvokeAsync(Selected);
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        highlightIdx = -1;
    }

    /// <summary>Hands the typed text to the page to add, and clears the search so the list shows everything again.</summary>
    private async Task CreateAsync()
    {
        var text = searchText.Trim();
        searchText = "";
        highlightIdx = -1;
        await OnCreate.InvokeAsync(text);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseToTriggerAsync();
            return;
        }

        var visible = Visible();
        if (e.Key == "Enter")
        {
            // Ticks and stays open, since the point of this list is to pick several.
            if (highlightIdx >= 0 && highlightIdx < visible.Count)
            {
                await ToggleValue(visible[highlightIdx].Value);
            }
            else if (highlightIdx < 0 && ExactMatch() is { } existing)
            {
                // "pt merged" typed for "PT Merged" ticks it rather than adding the same tag in another case.
                await TickAsync(existing.Value);
            }
            else if (CanCreate && (highlightIdx == visible.Count || visible.Count == 0))
            {
                // A partial match typed to find "PT Merged" is not added as a tag of its own by an Enter meant to pick.
                await CreateAsync();
            }
            return;
        }

        var step = e.Key switch { "ArrowDown" => 1, "ArrowUp" => -1, _ => 0 };
        var last = CanCreate ? visible.Count : visible.Count - 1;
        if (step == 0 || last < 0)
        {
            return;
        }
        highlightIdx = Math.Clamp(highlightIdx + step, 0, last);
        await RevealAsync(ActiveOptionId!);
    }

    /// <summary>Closes from the keyboard. Focus goes back to the trigger, since the search box it was in is gone.</summary>
    private async Task CloseToTriggerAsync()
    {
        IsOpen = false;
        searchText = "";
        highlightIdx = -1;
        await FocusAsync(trigger);
    }

    private string OptionId(int index) => $"{PanelId}-{index}";
}
