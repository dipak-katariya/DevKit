@page "/insights"
@inject TfsApiService TfsApi
@inject SettingsService Settings
@inject PageStateService PageState
@inject ILogger<Insights> Logger
@implements IDisposable

<div class="hub si-page">
    @* The top bar already names the page, so the heading is for screen readers and for the focus a new page gets. *@
    <h1 class="sr-only">Sprint Insights</h1>
    @* Tabs in the usual pattern: one Tab stop, Left and Right move between them (app.js), Enter or Space opens one. *@
    <div class="tabbar" role="tablist" aria-label="Sprint Insights tools" data-roving="row">
        @foreach (var t in Tabs)
        {
            var open = activeTab == t.Key;
            @* What each tab does is its tooltip, so the panels below keep their headings short. *@
            <button type="button" role="tab" id="@TabId(t.Key)" class="tab @(open ? "active" : "")" aria-selected="@(open ? "true" : "false")"
                    aria-controls="@(visited.Contains(t.Key) ? PanelId(t.Key) : null)" tabindex="@(open ? "0" : "-1")" data-roving-item
                    title="@t.Summary" @onclick="() => SelectTab(t.Key)">
                <Icon Inner="@t.Icon" /><span class="tab-label">@t.Label</span>
            </button>
        }
    </div>

    <div class="tab-body">
        @if (!string.IsNullOrEmpty(metadataError)) { <div class="notice warn" role="alert">⚠ @metadataError</div> }
        @* A tab is built the first time it opens and only hidden after that, so what it loaded, its filters and its open
           rows are still there when you come back to it. *@
        @foreach (var key in Tabs.Select(t => t.Key).Where(visited.Contains))
        {
            <div @key="key" class="si-tabpanel" role="tabpanel" id="@PanelId(key)" aria-labelledby="@TabId(key)" hidden="@(activeTab != key)">
                @if (key == "create")
                {
                    <TaskCreationPanel Area="@selectedArea" Sprint="@selectedSprint" Selectors="@AreaSprintSelectors" />
                }
                else if (key == "planning")
                {
                    <CapacityPlanningPanel Area="@selectedArea" Sprint="@selectedSprint" Selectors="@AreaSprintSelectors" />
                }
                else if (key == "size")
                {
                    <SizeCheckPanel Area="@selectedArea" Sprint="@selectedSprint" Selectors="@AreaSprintSelectors" />
                }
                else if (key == "burndown")
                {
                    @BurndownPanel
                }
                else if (key == "tasks")
                {
                    @AuditPanel(taskChecks, "Task checks", Icons.TabTasks)
                }
                else
                {
                    @AuditPanel(bugChecks, "Bug checks", Icons.TabBugs)
                }
            </div>
        }
    </div>
</div>

@code {
    private sealed record TabDef(string Key, string Label, string Icon, string Summary);

    private static readonly TabDef[] Tabs =
    {
        new("create", "Task Creation", Icons.TabTaskCreation, "Creates the standard child tasks for a Requirement, CHR or Bug in one step. Each task gets its discipline and the Product tag (Bug/Maintenance under a Bug)."),
        new("planning", "Capacity Planning", Icons.TabCapacity, "Shows each member's planned hours against capacity."),
        new("size", "Size Check", Icons.TabSize, "Compares Requirement and CHR sizes with the estimates on their child tasks, and applies the calculated size. Bugs are off by default; tick Bug in the Type filter to include them."),
        new("burndown", "Burndown", Icons.Insights, "Shows the hours each member logged per day or week, from revision history. Regular and bug hours are shown apart and compared with the hours per day set in Capacity Planning."),
        new("tasks", "Tasks", Icons.TabTasks, "Checks tasks for missing discipline or estimates, wrong title prefixes, manual execution and unusual remaining or completed hours."),
        new("bugs", "Bugs", Icons.TabBugs, "Checks bugs for a missing root cause, proposed fix or dev task, and shows flag dates. Duplicate, Deferred, Cannot Reproduce and Rejected bugs are excluded."),
    };

    // Tied to the order above, so moving a tab to the front also makes it the one Sprint Insights opens on.
    private string activeTab = Tabs[0].Key;

    /// <summary>Opens Sprint Insights on a given tab, e.g. /insights?tab=size. Used by the /planning redirect.</summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }

    private string? appliedTab;

    // The tabs opened so far. Each is built on its first visit and kept after that, hidden while another is open.
    private readonly HashSet<string> visited = new(StringComparer.Ordinal);

    private IReadOnlyList<TfsArea> areas => PageState.TfsData.Areas;
    private IReadOnlyList<TfsIteration> iterations => PageState.TfsData.Iterations;

    private TfsArea? selectedArea;
    private string? selectedSprint;

    // Shown above every tab: the area and sprint pickers are empty without this metadata.
    private string? metadataError;

    // The audit and burndown reads stop when Sprint Insights closes. Closing only ends its wait for the shared metadata:
    // that load goes on for the next page.
    private readonly PageLifetime page = new();

    // Tasks / Bugs audit
    private const string FlagDateFormat = "dd/MM/yyyy hh:mm tt";
    private const string UnreadFlagDate = "Unreadable";
    private bool auditLoading;
    private string? auditError;
    private List<AuditCheck> taskChecks = new();
    private List<AuditCheck> bugChecks = new();

    // Work items TFS did not return, so the checks never saw them.
    private IReadOnlyList<string> auditUnread = Array.Empty<string>();

    // The area and sprint the checks and the burndown last read. Their results show only while that pair is still
    // picked, as Task Creation and Size Check do.
    private (TfsArea? Area, string? Sprint) auditFor, burndownFor;
    private bool AuditShowsSelection => Shows(auditFor);
    private bool BurndownShowsSelection => Shows(burndownFor);

    // New results fade in once per run and per load, never when a tab switch brings them back.
    private readonly ArrivalCue auditArrival = new();
    private readonly ArrivalCue burndownArrival = new();

    // What a screen reader is told once a run or a load finishes; the notices carry the failures.
    private string auditAnnouncement = "";
    private string burndownAnnouncement = "";

    // Burndown
    private bool burndownLoading, burndownLoaded, burndownWeekly;
    private string? burndownError;
    private string burndownSearch = "";
    private IReadOnlyList<BurndownContribution> burndownContribs = Array.Empty<BurndownContribution>();

    // Work items whose hours could not be read, and why the first one could not; the grid without them is partial.
    private IReadOnlyList<string> burndownUnread = Array.Empty<string>();
    private string? burndownProblem;
    private BurndownMatrix burndownMatrix = new();
    private double burndownThreshold = CapacityPlanningSettings.DefaultHoursPerDay;
    private BurndownScope burndownScope = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Settings.IsConfigured)
        {
            return;
        }
        var load = await PageState.TfsData.EnsureLoadedAsync(page.Token);
        if (load.Cancelled)
        {
            return;
        }
        metadataError = load.ErrorMessage;

        selectedArea = AreaSprintSelect.Parse(Settings.DefaultAreaPath) ?? selectedArea;
        selectedSprint = AreaSprintSelect.DefaultSprint(Settings, iterations, selectedArea, DateTime.Today) ?? selectedSprint;
    }

    // Only honour ?tab= when it actually changes, so a re-render can't yank the user back
    // off a tab they clicked (clicking a tab does not touch the URL).
    protected override void OnParametersSet()
    {
        if (Tab != appliedTab)
        {
            appliedTab = Tab;
            if (!string.IsNullOrEmpty(Tab) && Tabs.Any(t => t.Key == Tab))
            {
                activeTab = Tab;
            }
        }
        visited.Add(activeTab);
    }

    private void SelectTab(string key)
    {
        activeTab = key;
        visited.Add(key);
    }

    private static string TabId(string key) => "si-tab-" + key;

    private static string PanelId(string key) => "si-panel-" + key;

    private void OnAreaChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        selectedArea = string.IsNullOrEmpty(val) ? null : AreaSprintSelect.Parse(val) ?? selectedArea;
    }

    private void OnSprintChange(ChangeEventArgs e) => selectedSprint = e.Value?.ToString();

    private async Task LoadAudit()
    {
        var area = selectedArea;
        var sprint = selectedSprint;
        if (area == null || string.IsNullOrEmpty(sprint))
        {
            return;
        }
        auditLoading = true; auditError = null; auditUnread = Array.Empty<string>(); taskChecks = new(); bugChecks = new();
        auditAnnouncement = "";
        auditFor = (area, sprint);
        StateHasChanged();
        try
        {
            var iterPath = TfsApiService.ToWiqlPath(sprint);
            var areaPath = TfsApiService.ToWiqlPath(area.Path);
            var data = await TfsApi.LoadAuditDataAsync(area.Project, areaPath, iterPath, page.Token);
            auditUnread = data.UnreadWorkItemIds.Select(id => id.ToString(System.Globalization.CultureInfo.InvariantCulture)).ToList();
            taskChecks = InsightAuditService.RunTaskChecks(data);
            bugChecks = InsightAuditService.RunBugChecks(data);

            // Fill §5.3 Flag Provided Date from revision history (bounded to qualifying bugs).
            var published = bugChecks.FirstOrDefault(c => c.ExtraColumn2 == "Flag Provided Date");
            if (published != null)
            {
                await FillFlagDatesAsync(area.Project, published);
            }
            auditArrival.Mark();
            auditAnnouncement = $"Checks done: {taskChecks.Sum(c => c.Count)} flagged items in tasks, {bugChecks.Sum(c => c.Count)} in bugs.";
        }
        catch (OperationCanceledException ex) when (page.Token.IsCancellationRequested)
        {
            Logger.LogDebug(ex, "Task and bug audit for {Area} / {Sprint} stopped because the page was left", area.Path, sprint);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Task and bug audit failed for {Area} / {Sprint}", area.Path, sprint);
            auditError = $"Load failed: {TfsErrors.Describe(ex)}";
        }
        auditLoading = false;
    }

    /// <summary>
    /// Reads each listed bug's flag date. One that cannot be read shows as unreadable, not blank, which would
    /// read as never flagged, and the failures are counted in the audit's notice.
    /// </summary>
    private async Task FillFlagDatesAsync(string project, AuditCheck published)
    {
        var failed = 0;
        string? firstProblem = null;
        foreach (var r in published.Rows)
        {
            try
            {
                r.Expected2 = (await TfsApi.GetPublishedFlagDateAsync(project, r.Item.Id, page.Token))?.ToString(FlagDateFormat);
            }
            catch (Exception ex) when (!TfsErrors.IsRequestedCancellation(ex, page.Token))
            {
                Logger.LogError(ex, "The flag date of bug {Id} could not be read", r.Item.Id);
                r.Expected2 = UnreadFlagDate;
                failed++;
                firstProblem ??= TfsErrors.Describe(ex);
            }
        }
        if (failed > 0)
        {
            auditError = $"Flag dates of {failed} bug(s) could not be read: {firstProblem}";
        }
    }

    private async Task LoadBurndown()
    {
        var area = selectedArea;
        var sprint = selectedSprint;
        if (area == null || string.IsNullOrEmpty(sprint))
        {
            return;
        }
        burndownLoading = true; burndownLoaded = false; burndownError = null; burndownMatrix = new(); burndownAnnouncement = "";
        burndownContribs = Array.Empty<BurndownContribution>(); burndownUnread = Array.Empty<string>(); burndownProblem = null;
        burndownFor = (area, sprint);
        // Read per load, so a change in Capacity Planning shows on the next Load. The sprint's own
        // dates come from the iterations already in memory, so a short first or last week is held
        // only to the days it covers.
        var planning = Settings.CapacityPlanning;
        var iteration = iterations.FirstOrDefault(i => i.Path == sprint);
        burndownThreshold = planning.HoursPerDay;
        burndownScope = new BurndownScope
        {
            Start = iteration?.StartDate,
            Finish = iteration?.FinishDate,
            Today = DateTime.Today,
            WorkingDays = planning.WorkingDays
        };
        StateHasChanged();
        try
        {
            var iterPath = TfsApiService.ToWiqlPath(sprint);
            var areaPath = TfsApiService.ToWiqlPath(area.Path);
            var load = await TfsApi.LoadBurndownAsync(area.Project, areaPath, iterPath, page.Token);
            burndownContribs = load.Contributions;
            burndownUnread = load.UnreadItemIds;
            burndownProblem = load.FirstProblem;
            burndownLoaded = true;
            RebuildBurndown();
            burndownArrival.Mark();
            burndownAnnouncement = NoHoursLogged
                ? "No completed work was logged in this area and sprint yet."
                : $"Loaded hours for {burndownMatrix.Rows.Count} members.";
        }
        catch (OperationCanceledException ex) when (page.Token.IsCancellationRequested)
        {
            Logger.LogDebug(ex, "Burndown load for {Area} / {Sprint} stopped because the page was left", area.Path, sprint);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Burndown load failed for {Area} / {Sprint}", area.Path, sprint);
            burndownError = $"Load failed: {TfsErrors.Describe(ex)}";
        }
        burndownLoading = false;
    }

    private string AuditUnreadNotice =>
        $"{WorkItems(auditUnread.Count)} could not be read, so the checks did not look at {(auditUnread.Count == 1 ? "it" : "them")}.";

    private string BurndownUnreadNotice =>
        $"Hours from {WorkItems(burndownUnread.Count)} could not be read, so the totals may be low. {burndownProblem}";

    private static string WorkItems(int count) => count == 1 ? "1 work item" : $"{count} work items";

    private string? SelectionMissing => AreaSprintSelect.MissingSelection(selectedArea, selectedSprint);

    private bool Shows((TfsArea? Area, string? Sprint) loadedFor) =>
        AreaSprintSelect.Key(loadedFor.Area, loadedFor.Sprint) == AreaSprintSelect.Key(selectedArea, selectedSprint);

    // Read in full and nothing was logged: an answer, not a failure. A partial read says so in its own notice instead.
    private bool NoHoursLogged => burndownContribs.Count == 0 && burndownUnread.Count == 0;

    // A grid with no rows left has hours that the member filter or the sprint's days leave out.
    private string BurndownEmptyText => burndownSearch.Length > 0
        ? "No member matches the filter."
        : "No completed work falls on this sprint's working days.";

    private static string UnreadIdsText(IReadOnlyList<string> ids) => "Not read: " + string.Join(", ", ids.Select(id => "#" + id));

    public void Dispose() => page.Dispose();

    private void RebuildBurndown() => burndownMatrix = BurndownCalculator.Build(burndownContribs, burndownWeekly, burndownSearch, burndownScope);
    private void SetBurndownView(bool weekly) { if (burndownWeekly != weekly) { burndownWeekly = weekly; RebuildBurndown(); } }
    private void OnBurndownSearch(ChangeEventArgs e) { burndownSearch = e.Value?.ToString() ?? ""; RebuildBurndown(); }

    // The Tasks and Bugs tabs share one toolbar: one Run Checks fills both.
    private RenderFragment AuditPanel(List<AuditCheck> checks, string title, string glyph) => @<text>
        <div class="si-toolbar">
            <div class="cfg-bar">
                @AreaSprintSelectors
                <div class="cfg-col">
                    <button type="button" class="cfg-load-btn" @onclick="LoadAudit" disabled="@(auditLoading || SelectionMissing is not null)" title="@SelectionMissing">
                        @if (auditLoading) { <span class="spin spin-sm"></span> } else { <span aria-hidden="true">⬇</span> }
                        Run Checks
                    </button>
                </div>
            </div>
        </div>
        <div class="si-scroll @auditArrival.Class">
            <div class="sr-only" role="status">@auditAnnouncement</div>
            @if (AuditShowsSelection && !string.IsNullOrEmpty(auditError)) { <div class="notice warn" role="alert">⚠ @auditError</div> }
            @if (AuditShowsSelection && auditUnread.Count > 0)
            {
                <div class="notice warn" title="@UnreadIdsText(auditUnread)">⚠ @AuditUnreadNotice</div>
            }
            @if (auditLoading)
            {
                <div class="gpanel"><LoadingState>Running the checks on <b>@AreaSprintSelect.Describe(auditFor.Area, auditFor.Sprint)</b></LoadingState></div>
            }
            else if (!AuditShowsSelection || checks.Count == 0)
            {
                <div class="gpanel">
                    <BlankState Glyph="@glyph" Title="Nothing checked yet">
                        Select an area and sprint, then <b>Run Checks</b>. One run checks both the sprint's tasks and its bugs.
                    </BlankState>
                </div>
            }
            else
            {
                <AuditCheckList Checks="@checks" Title="@title" />
            }
        </div>
    </text>;

    // Hours from revision history, per member and per day or week.
    private RenderFragment BurndownPanel => @<text>
        <div class="si-toolbar">
            <div class="cfg-bar">
                @AreaSprintSelectors
                <div class="cfg-col">
                    <div class="cfg-field" role="group" aria-label="View">
                        <label class="cfg-label">📆 View</label>
                        <div class="cm-seg">
                            <button type="button" class="cm-seg-btn @(burndownWeekly ? "" : "on")" aria-pressed="@(burndownWeekly ? "false" : "true")" @onclick="() => SetBurndownView(false)">Daily</button>
                            <button type="button" class="cm-seg-btn @(burndownWeekly ? "on" : "")" aria-pressed="@(burndownWeekly ? "true" : "false")" @onclick="() => SetBurndownView(true)">Weekly</button>
                        </div>
                    </div>
                </div>
                <div class="cfg-col si-f-search">
                    <div class="cfg-field">
                        <label class="cfg-label" for="siBurndownMember">🔍 Member</label>
                        <input id="siBurndownMember" class="cfg-fi" placeholder="Filter by name…" @oninput="OnBurndownSearch" />
                    </div>
                </div>
                <div class="cfg-col">
                    <button type="button" class="cfg-load-btn" @onclick="LoadBurndown" disabled="@(burndownLoading || SelectionMissing is not null)" title="@SelectionMissing">
                        @if (burndownLoading) { <span class="spin spin-sm"></span> } else { <span aria-hidden="true">⬇</span> }
                        Load
                    </button>
                </div>
            </div>
        </div>
        <div class="si-scroll @burndownArrival.Class">
            <div class="sr-only" role="status">@burndownAnnouncement</div>
            @if (BurndownShowsSelection && !string.IsNullOrEmpty(burndownError)) { <div class="notice warn" role="alert">⚠ @burndownError</div> }
            @if (BurndownShowsSelection && burndownUnread.Count > 0)
            {
                <div class="notice warn" title="@UnreadIdsText(burndownUnread)">⚠ @BurndownUnreadNotice</div>
            }
            @if (burndownLoading)
            {
                <div class="gpanel"><LoadingState>Reading the revision history of every work item in <b>@AreaSprintSelect.Describe(burndownFor.Area, burndownFor.Sprint)</b></LoadingState></div>
            }
            else if (!BurndownShowsSelection || !burndownLoaded)
            {
                <div class="gpanel">
                    <BlankState Glyph="@Icons.Insights" Title="Nothing loaded yet">
                        Select an area and sprint, then <b>Load</b> to see the hours each member logged per day, from revision history.
                    </BlankState>
                </div>
            }
            else if (NoHoursLogged)
            {
                <div class="gpanel">
                    <BlankState Glyph="@Icons.Insights" Title="No hours logged yet">No completed work was logged in this area and sprint yet.</BlankState>
                </div>
            }
            else
            {
                <BurndownGrid Matrix="@burndownMatrix" Project="@(burndownFor.Area?.Project ?? "")" DailyThreshold="@burndownThreshold" EmptyText="@BurndownEmptyText" />
            }
        </div>
    </text>;

    private RenderFragment AreaSprintSelectors => @<text>
        <div class="cfg-col">
            <div class="cfg-field">
                <label class="cfg-label">📂 Area Path</label>
                <GlassDropdown Style="min-width:240px;" Value="@(selectedArea != null ? AreaSprintSelect.Serialize(selectedArea) : "")"
                               Placeholder="Select area" ShowEmptyOption="false" Label="Area path" Disabled="@(areas.Count==0)" Groups="@AreaGroups" OnChange="OnAreaChange" />
            </div>
        </div>
        <div class="cfg-divider"></div>
        <div class="cfg-col">
            <div class="cfg-field">
                <label class="cfg-label">📅 Sprint</label>
                <GlassDropdown Style="min-width:220px;" Value="@(selectedSprint ?? "")" Placeholder="Select sprint"
                               ShowEmptyOption="false" Label="Sprint" Disabled="@(iterations.Count==0)" Groups="@SprintGroups" OnChange="OnSprintChange" />
            </div>
        </div>
    </text>;

    private List<GlassDropdown.DropdownGroup> AreaGroups => AreaSprintSelect.AreaGroups(areas);

    private List<GlassDropdown.DropdownGroup> SprintGroups => AreaSprintSelect.SprintGroups(iterations);
}
