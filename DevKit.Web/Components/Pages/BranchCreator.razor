@page "/branch-creator"
@inject TfsApiService TfsApi
@inject SettingsService Settings
@inject PageStateService PageState
@inject BranchCacheService BranchCache
@inject ILogger<BranchCreator> Logger
@inject IJSRuntime JS
@implements IDisposable

<div class="bc-page">
    @* The top bar already names the page, so the heading is for screen readers and for the focus a new page gets. *@
    <h1 class="sr-only">Branch Creator</h1>
    @* One raised toolbar with two groups, what to load and how to narrow the table. They share a line when the
       window has room for both and wrap as whole groups when it does not. *@
    <div class="bc-toolbar">
    <div class="cfg-bar">
        <div class="cfg-col">
            <div class="cfg-field">
                <label class="cfg-label">📂 Area Path</label>
                <GlassDropdown CssClass="bc-area" Label="Area path" ShowEmptyOption="false"
                               Value="@(selectedArea != null ? AreaSprintSelect.Serialize(selectedArea) : "")"
                               Placeholder="Select area"
                               Disabled="@(areas.Count==0)"
                               Groups="@AreaGroups"
                               OnChange="OnAreaChange" />
            </div>
        </div>
        <div class="cfg-col">
            <div class="cfg-field">
                <label class="cfg-label">👥 Team Name</label>
                <input class="cfg-fi bc-team" value="@teamName" @onchange="OnTeamNameChange" placeholder="TEAM" aria-label="Team name" />
            </div>
        </div>
        <div class="cfg-col">
            <div class="cfg-field">
                <label class="cfg-label">📅 Sprint</label>
                <GlassDropdown CssClass="bc-sprint" Label="Sprint"
                               Value="@(selectedSprint ?? "")"
                               Placeholder="All"
                               EmptyLabel="All" EmptyValue=""
                               Disabled="@(iterations.Count==0)"
                               Groups="@SprintGroups"
                               OnChange="OnSprintChange" />
            </div>
        </div>
        <div class="cfg-col">
            <button class="cfg-load-btn" @onclick="LoadWorkItems" disabled="@(selectedArea == null || loading)">
                @if (loading) { <span class="spin spin-sm"></span> }
                else { <span aria-hidden="true">⬇</span> }
                Load
            </button>
        </div>
    </div>

    <!-- Filter bar -->
    <div class="cfg-bar-filters">
        <div class="bc-f-search">
            <div class="cfg-field">
                <label class="cfg-label">🔍 Search</label>
                <input class="cfg-fi" placeholder="ID, title, assignee…" aria-label="Search work items" value="@searchQ" @oninput="OnSearch" />
            </div>
        </div>
        <div class="bc-f-pick" role="group" aria-label="Type">
            <div class="cfg-field">
                <label class="cfg-label">🏷 Type</label>
                <GlassDropdown Value="@typeFilter" Placeholder="All" EmptyLabel="All" EmptyValue=""
                               Options="@TypeOptions()" OnChange="OnTypeFilter" />
            </div>
        </div>
        <div class="bc-f-pick" role="group" aria-label="Assignee">
            <div class="cfg-field">
                <label class="cfg-label">👤 Assignee</label>
                <GlassDropdown Value="@assigneeFilter" Placeholder="All" EmptyLabel="All" EmptyValue=""
                               Options="@AssigneeOptions()" OnChange="OnAssigneeFilter" />
            </div>
        </div>
    </div>
    </div>
    @if (!string.IsNullOrEmpty(metadataError)) { <div class="notice warn" role="alert">⚠ @metadataError</div> }
    @if (!string.IsNullOrEmpty(loadError)) { <div class="notice warn" role="alert">⚠ @loadError</div> }

    <!-- Main content: left table + right branch form -->
    <div class="content bc-content">
        <div class="content-left">
            <div class="gpanel bc-list">
                <div class="phead">
                    <span class="ptitle"><span aria-hidden="true">📋</span> Requirements / Change Requests / Bugs</span>
                    @* "10/33" once a filter hides some, so the one count also says how many were loaded. *@
                    @if (filtered.Count > 0)
                    {
                        <span class="bc-count">@filtered.Count@(filtered.Count != workItems.Count ? $"/{workItems.Count}" : "") item(s)</span>
                    }
                </div>
                <div class="pbody bc-list-body">
                    <div class="grid-wrap bc-grid">
                        @* One line per work item, like the merging grid: titles end in an ellipsis and the cell's
                           tooltip has them whole. *@
                        <table class="req-table bc-table">
                            @* Each header is a button; the sorted column says so (aria-sort) and shows its arrow. *@
                            <thead><tr>
                                <th class="bc-c-id" aria-sort="@AriaSort("id")"><button type="button" class="bc-sort" @onclick='() => Sort("id")'>ID</button></th>
                                <th aria-sort="@AriaSort("title")"><button type="button" class="bc-sort" @onclick='() => Sort("title")'>Title & Details</button></th>
                                <th class="bc-c-type" aria-sort="@AriaSort("type")"><button type="button" class="bc-sort" @onclick='() => Sort("type")'>Type</button></th>
                                <th class="bc-c-state" aria-sort="@AriaSort("state")"><button type="button" class="bc-sort" @onclick='() => Sort("state")'>State</button></th>
                                <th class="bc-c-user" aria-sort="@AriaSort("assigned")"><button type="button" class="bc-sort" @onclick='() => Sort("assigned")'>Assigned</button></th>
                            </tr></thead>
                            @* Each load brings a new list, so the body is new and fades in once; filtering, sorting and
                               selecting keep the same list and never replay it. The rows are one Tab stop: the arrow
                               keys, Home and End move between their titles (app.js), and Enter or Space picks one. *@
                            <tbody @key="workItems" data-roving>
                                @if (filtered.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="tbl-empty">
                                            @if (loading)
                                            {
                                                <span class="bc-loading" role="status"><span class="spin spin-sm"></span> Reading work items…</span>
                                            }
                                            else
                                            {
                                                @EmptyTableText
                                            }
                                        </td>
                                    </tr>
                                }
                                @{
                                    var chosenArea = selectedArea?.Name;
                                    var tabRowId = TabRowId;
                                }
                                @foreach (var item in filtered)
                                {
                                    // Everything under the chosen area loads, so a row names its area only when it comes from below it.
                                    var area = item.Area.Split('\\').LastOrDefault() ?? "";
                                    var fromSubArea = !string.Equals(area, chosenArea, StringComparison.OrdinalIgnoreCase);
                                    var isSelected = selectedItem?.Id == item.Id;
                                    <tr class="@(isSelected ? "selected" : "")" @onclick="() => SelectItem(item)">
                                        @* For the pointer only: from the keyboard, the chosen work item's id in the form opens TFS. *@
                                        <td><a class="id-link" href="@TfsApi.WorkItemUrl(item.Project, item.Id)" target="_blank" rel="noopener"
                                               tabindex="-1" @onclick:stopPropagation>#@item.Id</a></td>
                                        <td title="@item.Title">
                                            <button type="button" class="bc-title-cell bc-pick" id="@RowButtonId(item)" data-roving-item
                                                    tabindex="@(item.Id == tabRowId ? "0" : "-1")" aria-pressed="@(isSelected ? "true" : "false")"
                                                    @onfocus="() => focusRowId = item.Id" @onclick="() => SelectItem(item)" @onclick:stopPropagation>
                                                <span class="bc-title">@item.Title</span>
                                                @if (fromSubArea)
                                                {
                                                    <span class="bc-sub">@area</span>
                                                }
                                            </button>
                                        </td>
                                        <td class="bc-c-type"><span class="type-pill @WorkItemBadges.TypeClass(item.Type)">@item.Type</span></td>
                                        <td class="bc-c-state"><span class="state-pill @WorkItemBadges.StateClass(item.State)">@item.State</span></td>
                                        <td class="bc-c-user" title="@item.Assigned">@item.Assigned</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="content-right">
            <div class="gpanel">
                <div class="phead">
                    <span class="ptitle"><span aria-hidden="true">🔀</span> New Branch</span>
                    @if (selectedRepo != null)
                    {
                        <span class="bc-head-note">@selectedRepo.Project</span>
                    }
                </div>
                <div class="pbody">
                    <!-- Repository: drives the base-branch list and where the branch is created -->
                    <div class="f-row">
                        <div class="f-label">
                            Repository
                            @if (loadingBranches)
                            {
                                <span class="spin spin-sm bc-spin"></span>
                            }
                            else if (selectedRepo != null)
                            {
                                <span class="bc-hint">@branches.Count branches</span>
                            }
                        </div>
                        <GlassDropdown CssClass="fi-size" Label="Repository"
                                       Value="@(selectedRepo?.Id ?? "")"
                                       Placeholder="Select repository"
                                       ShowEmptyOption="false"
                                       Disabled="@(repos.Count == 0)"
                                       Groups="@RepoGroups"
                                       OnChange="OnRepoChange" />
                        @if (!string.IsNullOrEmpty(branchLoadErr))
                        {
                            <div class="bc-field-err">⚠ @branchLoadErr</div>
                        }
                    </div>

                    @if (selectedItem == null)
                    {
                        <div class="pr-placeholder">
                            <Icon Inner="@Icons.ToolBranchCreator" CssClass="ic-xl bc-empty-ic" />
                            <div class="bp-title">Select a Requirement</div>
                            <div class="bp-sub">Click a row in the table to set up and create its branch.</div>
                        </div>
                    }
                    else
                    {
                        <!-- Selected item info: sunk into the form like a field, since it is context rather than a control -->
                        <div class="bc-item">
                            <div class="bc-item-title">@selectedItem.Title</div>
                            <div class="bc-item-meta">
                                @* The keyboard's way to TFS: the table's id links are for the pointer only. *@
                                <a class="bc-item-link" href="@TfsApi.WorkItemUrl(selectedItem.Project, selectedItem.Id)" target="_blank"
                                   rel="noopener">#@selectedItem.Id<span class="sr-only"> (opens TFS in a new tab)</span></a>
                                · @selectedItem.Type · @selectedItem.State · @selectedItem.Assigned
                            </div>
                        </div>

                        <!-- Branches already linked to this work item, in any repository -->
                        @if (loadingExisting)
                        {
                            <div class="bc-note" role="status">
                                <span class="spin spin-sm bc-spin"></span>
                                Reading linked branches…
                            </div>
                        }
                        else if (existingBranches.Count > 0)
                        {
                            <div class="bc-existing">
                                <div class="bc-existing-h">
                                    ⚠ Existing Branches (@existingBranches.Count)
                                </div>
                                <p class="bc-existing-note">Linked to this work item. Click one to use it.</p>
                                @foreach (var link in existingBranches)
                                {
                                    var gone = link.BranchMissing;
                                    @* The branch is a button of its own, so the keyboard reaches it; its remove controls sit beside
                                       it rather than inside it, since a button cannot hold another. *@
                                    <div class="bc-link @(gone ? "gone" : "")">
                                        <button type="button" class="bc-link-name" title="@ExistingBranchTitle(link)"
                                                @onclick="() => UseExistingBranch(link)">
                                            <span aria-hidden="true">@(gone ? "🥀" : "🌿")</span> @ExistingBranchLabel(link)
                                            @if (gone)
                                            {
                                                <span class="bc-gone"> · deleted</span>
                                            }
                                        </button>
                                        @if (gone)
                                        {
                                            @if (ReferenceEquals(unlinkCandidate, link))
                                            {
                                                <span class="bc-link-acts">
                                                    <button class="btn-sm bc-remove" disabled="@unlinking"
                                                            title="Permanently remove this link from the work item"
                                                            @onclick="() => RemoveStaleLink(link)" @onclick:stopPropagation>
                                                        @if (unlinking) { <span class="spin spin-sm"></span> }
                                                        Remove link
                                                    </button>
                                                    <button class="btn-sm" disabled="@unlinking"
                                                            @onclick="() => unlinkCandidate = null" @onclick:stopPropagation>
                                                        Cancel
                                                    </button>
                                                </span>
                                            }
                                            else
                                            {
                                                <button class="bpk-clear" title="Remove this stale link from the work item"
                                                        aria-label="Remove the stale link to @link.BranchName"
                                                        @onclick="() => unlinkCandidate = link" @onclick:stopPropagation>✕</button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(existingErr))
                        {
                            <div class="bc-err">
                                ⚠ Could not load linked branches: @existingErr
                            </div>
                        }

                        <!-- Branch Name -->
                        @* The check line, the length hint and the pattern describe the box, so a screen reader hears them
                           with it, and an invalid name is marked as such. *@
                        var nameInvalid = !string.IsNullOrWhiteSpace(branchName) && BranchNameError != null;
                        <div class="f-row">
                            <div class="f-label"><label for="bcBranchName">Branch Name</label> <span class="bc-hint" id="bcBranchHint">max @BranchNaming.MaxLength chars</span></div>
                            <div class="bc-ref-row">
                                <span class="bc-ref-prefix" aria-hidden="true">refs/heads/</span>
                                <input class="fi bc-ref-input" id="bcBranchName" @bind="branchName" @bind:event="oninput" placeholder="auto-generated"
                                       aria-invalid="@(nameInvalid ? "true" : null)" aria-describedby="bcBranchCheck bcBranchHint bcBranchPattern" />
                            </div>
                            @if (!string.IsNullOrWhiteSpace(branchName))
                            {
                                @if (BranchNameError == null)
                                {
                                    <div class="bc-valid ok" id="bcBranchCheck">✓ Valid branch name</div>
                                }
                                else
                                {
                                    <div class="bc-valid bad" id="bcBranchCheck">✕ @BranchNameError</div>
                                }
                            }
                            @* The pattern explains the field above it, so it sits with it. *@
                            <div class="bc-pattern" id="bcBranchPattern">
                                Branch: <code>{TEAM}/{Sprint}/{id}_{title}</code>
                            </div>
                        </div>

                        <!-- PR Name -->
                        <div class="f-row">
                            <div class="f-label"><label for="bcPrName">PR Name Suggestion</label></div>
                            <input class="fi" id="bcPrName" @bind="prName" />
                        </div>

                        <!-- Base Branch -->
                        <div class="f-row">
                            <div class="f-label">
                                Base Branch
                                <span class="bc-hint">@BaseBranchHint</span>
                            </div>
                            <BranchPicker CssClass="fi-size" Label="Base branch"
                                          Branches="@branches"
                                          Value="@baseBranch"
                                          ValueChanged="OnBaseBranchChange"
                                          Loading="@loadingBranches"
                                          Disabled="@(selectedRepo == null)"
                                          Placeholder="@(selectedRepo == null ? "Select a repository first" : "Select branch")" />
                        </div>

                        <!-- Action Buttons -->
                        @* Create is the one filled button; Check is its quieter sibling, and Clear only empties the form.
                           The row stays pinned to the bottom of the form column, so Create is in reach however many
                           linked branches push the fields down. *@
                        <div class="bc-actions">
                            <button class="btn-primary" @onclick="CreateBranch" disabled="@(!CanSubmit || creating)"
                                    title="@(creating ? null : CreateBlockedReason)">
                                @if (creating) { <span class="spin spin-sm"></span> <span>Creating…</span> }
                                else { <span aria-hidden="true">🔀</span> <span>Create Branch</span> }
                            </button>
                            <button class="btn-ghost bc-check-btn" @onclick="CheckBranch" disabled="@(!CanCheck || checking)"
                                    title="@(checking ? null : CheckBlockedReason)">
                                @if (checking) { <span class="spin spin-sm"></span> } else { <span aria-hidden="true">🔍</span> }
                                Check
                            </button>
                            <button class="btn-ghost bc-clear" @onclick="ClearForm">
                                <span aria-hidden="true">✕</span> Clear
                            </button>
                        </div>

                        <!-- Result: a live region that is always there, so the outcome of Check or Create is read out -->
                        <div role="status">
                            @if (!string.IsNullOrEmpty(resultMsg))
                            {
                                <div class="bc-result @(resultOk ? "ok" : "bad")">
                                    @((MarkupString)resultMsg)
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
