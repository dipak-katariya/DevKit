@inject TfsApiService TfsApi
@inject ILogger<SizeCheckPanel> Logger

@* Size Check: requirement/CHR sizes verified against the estimates on their child tasks.
   Area and sprint are owned by Sprint Insights and arrive as parameters so they stay shared across tabs. *@

<div class="sc-tab">
    <div class="si-toolbar">
    <div class="cfg-bar">
        @Selectors
        <div class="cfg-divider"></div>
        <div class="cfg-col">
            <button type="button" class="cfg-load-btn" @onclick="Load" disabled="@(loading || LoadBlocked is not null)" title="@LoadBlocked">
                @if (loading) { <span class="spin spin-sm"></span> }
                else { <span aria-hidden="true">⬇</span> }
                Load Sprint
            </button>
        </div>
    </div>
    @* The grid's own tools are a second row, as on Task Creation: on a laptop the toolbar breaks between choosing a
       sprint and working on it, not wherever the width runs out. *@
    <div class="cfg-bar-filters">
        <div class="cfg-col">
            @* A filter over what is loaded, so it wears the tint of Verify All and Check, not the filled Load. *@
            <button type="button" class="si-tint-btn @(showMismatchOnly ? "on" : "")" aria-pressed="@(showMismatchOnly ? "true" : "false")"
                    @onclick="ToggleVerifySize" disabled="@(planningItems.Count == 0)" title="@(planningItems.Count == 0 ? NothingLoaded : null)">
                <span aria-hidden="true">@(showMismatchOnly ? "✓" : "⚠")</span>
                @(showMismatchOnly ? "Showing Mismatches" : "Verify Size")
                @if (planningItems.Count > 0) { <span class="si-btn-count">· @MismatchedCount</span> }
            </button>
        </div>
        <div class="cfg-divider"></div>
        <div class="cfg-col">
            @* It writes every size to TFS, so it stays a quiet button beside the one filled action. *@
            <button type="button" class="si-quiet-btn"
                    @onclick="ApplyAllCalculated"
                    disabled="@(CalcDiffersCount == 0 || bulkApplying || loading)"
                    title="@ApplyAllTitle">
                @if (bulkApplying) { <span class="spin spin-sm"></span> }
                else { <span aria-hidden="true">∑</span> }
                Apply All Sizes
                @if (CalcDiffersCount > 0) { <span class="si-btn-count">· @CalcDiffersCount</span> }
            </button>
        </div>
        <div class="cfg-divider"></div>
        <div class="cfg-col si-f-search">
            <div class="cfg-field">
                <label class="cfg-label">🔍 Search</label>
                <input class="cfg-fi" placeholder="ID, title…" aria-label="Search items" @oninput="OnSearch" />
            </div>
        </div>
        <div class="cfg-divider"></div>
        <div class="cfg-col sc-f-type" role="group" aria-label="Type">
            <div class="cfg-field">
                <label class="cfg-label">🏷 Type</label>
                <MultiSelectDropdown Options="@TypeOptions()" Selected="@typeFilter"
                                     SelectedChanged="OnTypeFilterChanged" ItemNoun="type"
                                     Placeholder="None" SearchPlaceholder="Search types…" />
            </div>
        </div>
    </div>
    </div>
    @if (loadError is not null) { <div class="notice warn" role="alert">⚠ @loadError</div> }
    @if (partialNotice is not null) { <div class="notice warn">⚠ @partialNotice</div> }

    <div class="content">
        <div class="sr-only" role="status">@announcement</div>
        <div class="gpanel sc-panel">
            @* The totals sit in the heading of the grid they add up, so the grid starts higher; how to use the grid is the
               title's tooltip. *@
            <div class="phead">
                <span class="ptitle" title="Click ▸ to expand tasks · click size to edit">📐 Size Check</span>
                @if (planningItems.Count > 0)
                {
                    <div class="sc-sums">
                        <span class="sc-sum-count">📋 @filteredItems.Count items</span>
                        <span><span class="sc-sum-k">Σ Size:</span> @TotalEffort.ToString("0.##")</span>
                        <span><span class="sc-sum-k">Σ Calc Size:</span> @TotalCalculated.ToString("0.##")</span>
                        <span><span class="sc-sum-k">Σ Original:</span> @TotalOriginal.ToString("0.##") h</span>
                        <span><span class="sc-sum-k">Σ Remaining:</span> @TotalRemaining.ToString("0.##") h</span>
                        <span><span class="sc-sum-k">Σ Completed:</span> @TotalCompleted.ToString("0.##") h</span>
                        <span><span class="sc-sum-k">Σ Revised:</span> @TotalRevised.ToString("0.##") h</span>
                        @if (showMismatchOnly)
                        {
                            <span class="sc-sum-note">⚠ Showing @filteredItems.Count mismatched item(s)</span>
                        }
                    </div>
                    <button type="button" class="si-head-btn" @onclick="ExpandAllClicked">
                        @(AllExpanded ? "▾ Collapse all" : "▸ Expand all")
                    </button>
                }
            </div>
            <div class="pbody">
                @if (loading)
                {
                    <LoadingState>Reading the sprint's requirements and their tasks for <b>@AreaSprintSelect.Describe(Area, Sprint)</b></LoadingState>
                }
                else if (LoadedEmpty)
                {
                    <BlankState Glyph="@Icons.TabSize" Title="Nothing to size">This area and sprint have no requirements or change requests.</BlankState>
                }
                else if (planningItems.Count == 0)
                {
                    <BlankState Glyph="@Icons.TabSize" Title="Nothing loaded yet">
                        Select an area and sprint, then <b>Load Sprint</b> to compare each requirement's size with the estimates on its tasks.
                    </BlankState>
                }
                else
                {
                    <div class="grid-wrap sc-grid @arrival.Class">
                        <table class="req-table sc-table">
                            <thead><tr>
                                <th class="sc-c-id" aria-sort="@AriaSort("id")"><button type="button" class="sc-sort" @onclick='() => Sort("id")'>ID</button></th>
                                <th aria-sort="@AriaSort("title")"><button type="button" class="sc-sort" @onclick='() => Sort("title")'>Title</button></th>
                                <th class="sc-c-state" aria-sort="@AriaSort("state")"><button type="button" class="sc-sort" @onclick='() => Sort("state")'>State</button></th>
                                <th class="sc-c-user" aria-sort="@AriaSort("assigned")"><button type="button" class="sc-sort" @onclick='() => Sort("assigned")'>Assigned</button></th>
                                <th class="sc-c-size" aria-sort="@AriaSort("size")"><button type="button" class="sc-sort" @onclick='() => Sort("size")'>Size</button></th>
                                <th class="sc-c-calc" aria-sort="@AriaSort("calc")" title="Past sprints completed work + current sprint original estimate"><button type="button" class="sc-sort" @onclick='() => Sort("calc")'>Calc Size</button></th>
                                <th class="sc-c-orig" aria-sort="@AriaSort("orig")"><button type="button" class="sc-sort" @onclick='() => Sort("orig")'>Original</button></th>
                                <th class="sc-c-rem" aria-sort="@AriaSort("rem")"><button type="button" class="sc-sort" @onclick='() => Sort("rem")'>Remaining</button></th>
                                <th class="sc-c-done" aria-sort="@AriaSort("done")"><button type="button" class="sc-sort" @onclick='() => Sort("done")'>Completed</button></th>
                                <th class="sc-c-rev" aria-sort="@AriaSort("rev")"><button type="button" class="sc-sort" @onclick='() => Sort("rev")'>Revised</button></th>
                                <th class="sc-c-delta">Δ</th>
                            </tr></thead>
                            <tbody>
                                @if (filteredItems.Count == 0)
                                {
                                    <tr><td colspan="11" class="tbl-empty">@EmptyGridMessage</td></tr>
                                }
                                @foreach (var pi in filteredItems)
                                {
                                    var hasSize = pi.WorkItem.Effort.HasValue && pi.WorkItem.Effort.Value > 0;
                                    var mismatch = hasSize && pi.TaskTotalEstimate > 0 && Math.Abs(pi.SizeMismatch) > 0.01;
                                    <tr class="sc-req @SizeTone(hasSize, mismatch)">
                                        <td>
                                            <button type="button" @key="pi" class="sc-exp @(pi.IsExpanded ? "open" : "")" @onclick="() => ExpanderClicked(pi)"
                                                    aria-expanded="@(pi.IsExpanded ? "true" : "false")" aria-label="Tasks of #@pi.WorkItem.Id"
                                                    title="@(pi.IsExpanded ? "Collapse tasks" : "Expand tasks")">▸</button>
                                            <a class="id-link sc-req-id" href="@TfsApi.WorkItemUrl(pi.WorkItem.Project, pi.WorkItem.Id)" target="_blank" rel="noopener">#@pi.WorkItem.Id</a>
                                        </td>
                                        <td>
                                            <div class="cell-title sc-req-title" title="@pi.WorkItem.Title">@pi.WorkItem.Title</div>
                                            <div class="cell-meta"><span class="type-pill @WorkItemBadges.TypeClass(pi.WorkItem.Type)">@pi.WorkItem.Type</span> · @pi.Tasks.Count task(s)</div>
                                        </td>
                                        <td><span class="state-pill @WorkItemBadges.StateClass(pi.WorkItem.State)">@pi.WorkItem.State</span></td>
                                        <td class="sc-user" title="@pi.WorkItem.Assigned">@pi.WorkItem.Assigned</td>
                                        <td class="sc-mid">
                                            @if (pi.EditingSize != null)
                                            {
                                                <div class="sc-size-edit">
                                                    @* Bound on every keystroke: the browser raises keydown before change, so Enter would save the old size. *@
                                                    <input type="number" step="0.5" min="0" class="sc-size-input" id="@SizeInputId(pi)" aria-label="New size for #@pi.WorkItem.Id"
                                                           @bind="pi.EditingSize" @bind:event="oninput"
                                                           @onkeydown="e => OnSizeKeyDown(e, pi)" />
                                                    <button type="button" class="sc-mini" aria-label="Save the size of #@pi.WorkItem.Id" @onclick="() => SaveSize(pi)" disabled="@pi.Saving">
                                                        @if (pi.Saving) { <span class="spin spin-sm"></span> } else { <span aria-hidden="true">✓</span> }
                                                    </button>
                                                    <button type="button" class="sc-mini" aria-label="Keep the size of #@pi.WorkItem.Id" @onclick="() => CancelSizeEdit(pi)"><span aria-hidden="true">✕</span></button>
                                                </div>
                                            }
                                            else
                                            {
                                                @* A quiet well marks the size as the one value here that can be edited. *@
                                                <button type="button" class="sc-size @(hasSize ? "" : "unset")" id="@SizeButtonId(pi)" @onclick="() => BeginSizeEdit(pi)" title="Click to edit"
                                                        aria-label="Size of #@pi.WorkItem.Id: @(hasSize ? pi.WorkItem.Effort!.Value.ToString("0.##") : "not set"). Edit">
                                                    @(hasSize ? pi.WorkItem.Effort!.Value.ToString("0.##") : "Not set")
                                                </button>
                                            }
                                        </td>
                                        <td class="sc-mid">
                                            @if (pi.CalculatedSize > 0)
                                            {
                                                <div class="sc-calc">
                                                    <span class="sc-calc-n"
                                                          title="@($"{pi.PastSprintCompleted:0.##}h completed (past sprints) + {pi.CurrentSprintOriginal:0.##}h original estimate (this sprint)")">
                                                        @pi.CalculatedSize.ToString("0.##")
                                                    </span>
                                                    <button type="button" class="sc-mini sc-apply-one @(pi.CalcDiffersFromCurrent ? "differs" : "")"
                                                            @onclick="() => ApplyCalculatedSize(pi)" disabled="@(pi.Saving || !pi.CalcDiffersFromCurrent)"
                                                            title="@(pi.CalcDiffersFromCurrent ? $"Apply calculated size {pi.CalculatedSize:0.##} to #{pi.WorkItem.Id}" : "Size already matches the calculated value")"
                                                            aria-label="Apply calculated size @pi.CalculatedSize.ToString("0.##") to #@pi.WorkItem.Id">
                                                        @if (pi.Saving) { <span class="spin spin-sm"></span> } else { <span aria-hidden="true">→</span> }
                                                    </button>
                                                </div>
                                            }
                                        </td>
                                        <td class="sc-n">
                                            @(pi.TaskTotalEstimate > 0 ? pi.TaskTotalEstimate.ToString("0.##") : "")
                                        </td>
                                        <td class="sc-n">
                                            @(pi.TaskTotalRemaining > 0 ? pi.TaskTotalRemaining.ToString("0.##") : "")
                                        </td>
                                        <td class="sc-n">
                                            @(pi.TaskTotalCompleted > 0 ? pi.TaskTotalCompleted.ToString("0.##") : "")
                                        </td>
                                        <td class="sc-n">
                                            @(pi.TaskTotalRevised > 0 ? pi.TaskTotalRevised.ToString("0.##") : "")
                                        </td>
                                        <td class="sc-delta @SizeTone(hasSize, mismatch)">
                                            @if (hasSize && pi.TaskTotalEstimate > 0)
                                            {
                                                @(pi.SizeMismatch > 0 ? "+" : "")@pi.SizeMismatch.ToString("0.##")
                                            }
                                        </td>
                                    </tr>

                                    @if (pi.IsExpanded)
                                    {
                                        @foreach (var t in pi.Tasks)
                                        {
                                            var rev = (t.CompletedWork ?? 0) + (t.RemainingWork ?? 0);
                                            var isCurrent = pi.IsCurrentSprintTask(t);
                                            <tr class="sc-task @RowArrival(pi)">
                                                <td class="sc-task-id">
                                                    <span class="sc-arrow">↳</span>
                                                    <a class="id-link" href="@TfsApi.WorkItemUrl(t.Project, t.Id)" target="_blank" rel="noopener">#@t.Id</a>
                                                </td>
                                                <td>
                                                    <div class="sc-task-title" title="@t.Title">@t.Title</div>
                                                    <div class="cell-meta sc-task-meta">
                                                        Task · @(string.IsNullOrEmpty(t.Sprint) ? "(no sprint)" : t.Sprint)
                                                        @* Which of this task's numbers adds to the size; that number is underlined in its column. *@
                                                        <span class="sc-basis">@(isCurrent ? "· est → size" : "· completed → size")</span>
                                                    </div>
                                                </td>
                                                <td><span class="state-pill @WorkItemBadges.StateClass(t.State)">@t.State</span></td>
                                                <td class="sc-user sc-dim" title="@t.Assigned">@t.Assigned</td>
                                                <td></td>
                                                <td></td>
                                                <td class="sc-n @(isCurrent ? "sc-counted" : "")">@(t.OriginalEstimate?.ToString("0.##") ?? "")</td>
                                                <td class="sc-n">@(t.RemainingWork?.ToString("0.##") ?? "")</td>
                                                <td class="sc-n @(isCurrent ? "" : "sc-counted")">@(t.CompletedWork?.ToString("0.##") ?? "")</td>
                                                <td class="sc-n">@(rev > 0 ? rev.ToString("0.##") : "")</td>
                                                <td></td>
                                            </tr>
                                        }

                                        @if (pi.Tasks.Count == 0)
                                        {
                                            <tr class="sc-task @RowArrival(pi)">
                                                <td colspan="11" class="sc-no-tasks">
                                                    ↳ No tasks linked to this work item.
                                                </td>
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div class="sc-toast @(statusOk ? "ok" : "bad")" role="status">
            @statusMsg
        </div>
    }
</div>
