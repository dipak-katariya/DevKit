@inherits ClickOutsideComponent
@inject NavigationManager Nav

@{ var matches = Matches(); }
<div class="topbar-search @(open ? "open" : "")" @ref="Root">
    @* A combobox: screen readers hear the results as a list, and the highlighted one as the arrows move. The box
       is a label, so a tap anywhere in it reaches the input. *@
    <label class="ts-box">
        <span class="ts-ico"><Icon Inner="@Icons.Search" /></span>
        <input id="cmdSearch" class="ts-input" placeholder="Search tools…" autocomplete="off"
               role="combobox" aria-label="Search tools" aria-autocomplete="list"
               aria-expanded="@(open ? "true" : "false")" aria-controls="@(open ? ListId : null)"
               aria-activedescendant="@(open && highlight < matches.Count ? OptionId(highlight) : null)"
               value="@query" @oninput="OnInput" @onfocus="OnFocus" @onclick="OnFocus" @onkeydown="OnKeyDown" />
        <span class="kbd" aria-hidden="true">Ctrl K</span>
    </label>
    @if (open)
    {
        <div class="ts-panel">
            @if (matches.Count == 0)
            {
                <div class="ts-empty" role="status">No tools match “@query”.</div>
            }
            else
            {
                <div id="@ListId" role="listbox" aria-label="Tools">
                    @for (int i = 0; i < matches.Count; i++)
                    {
                        var tool = matches[i];
                        var idx = i;
                        <div class="ts-item @(idx == highlight ? "hl" : "")" id="@OptionId(idx)" role="option"
                             aria-selected="@(idx == highlight ? "true" : "false")" @onclick="() => Go(tool.Path)">
                            <Icon Inner="@tool.Icon" />
                            <span class="ts-item-name">@tool.Name</span>
                            <span class="ts-item-path">@tool.Path</span>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private const string ListId = "cmdSearchList";

    private string query = "";
    private bool open;
    private int highlight;

    private static string OptionId(int index) => $"cmdSearchOpt{index}";

    protected override bool IsPanelOpen => open;

    private List<ToolEntry> Matches() => ToolCatalog.All()
        .Where(t => string.IsNullOrWhiteSpace(query)
            || t.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
            || t.Path.Contains(query, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override Task OnAfterRenderedAsync(bool firstRender) =>
        firstRender ? InvokeJsAsync("devKit.registerCommandKey", "cmdSearch") : Task.CompletedTask;

    private void OnFocus() => open = true;

    private void OnInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        open = true;
        highlight = 0;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        var matches = Matches();
        switch (e.Key)
        {
            // Escape closes the results but leaves focus in the box: the Down arrow brings them back.
            case "ArrowDown" when !open: open = true; highlight = 0; break;
            case "ArrowDown" when matches.Count > 0: highlight = (highlight + 1) % matches.Count; break;
            case "ArrowUp" when matches.Count > 0: highlight = (highlight - 1 + matches.Count) % matches.Count; break;
            case "Enter" when highlight >= 0 && highlight < matches.Count: Go(matches[highlight].Path); break;
            case "Escape": Reset(); break;
        }
    }

    private void Go(string path)
    {
        Reset();
        Nav.NavigateTo(path);
    }

    // Escape and a chosen result both start the next search from nothing, so it never opens on old results.
    private void Reset()
    {
        open = false;
        query = "";
        highlight = 0;
    }

    protected override Task CloseFromOutsideAsync()
    {
        open = false;
        StateHasChanged();
        return Task.CompletedTask;
    }
}
