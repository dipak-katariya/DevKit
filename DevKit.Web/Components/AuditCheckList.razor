@inject TfsApiService TfsApi

@* Sprint Insights shows the blank and loading states, so this draws only a run's results. *@
@if (Checks.Count > 0)
{
    var critical = CountBy(AuditSeverity.Critical);
    var warnings = CountBy(AuditSeverity.Warning);
    var passed = Checks.Count(c => c.Count == 0);
    var passedLabelled = false;
    @* One panel of rows: the checks that found something come first and carry the colour; the ones that passed follow,
       quiet, under their own label. *@
    <div class="gpanel audit-panel">
    <div class="phead">
        <span class="ptitle">@Title</span>
        <span class="audit-summary">
            <span class="@(critical > 0 ? "cnt-crit" : "")">@critical critical</span>
            <span class="@(warnings > 0 ? "cnt-warn" : "")">@warnings warning(s)</span>
            <span>@Checks.Sum(c => c.Count) flagged item(s)</span>
        </span>
    </div>
    @foreach (var c in FoundFirst())
    {
        if (c.Count == 0 && !passedLabelled)
        {
            passedLabelled = true;
            <div class="audit-passed">Passed · @passed</div>
        }
        <div @key="c" class="audit-card @(c.Count == 0 ? "pass" : "")">
            @* A check that found something is a button that opens its rows; one that passed has nothing to open. *@
            @if (c.Count > 0)
            {
                <button type="button" class="audit-head clickable" aria-expanded="@(c.Expanded ? "true" : "false")"
                        aria-controls="@(c.Expanded ? BodyId(c) : null)" @onclick="() => HeadClicked(c)">
                    @HeadContent(c)
                    <span class="audit-chev @(c.Expanded ? "open" : "")" aria-hidden="true">▸</span>
                </button>
            }
            else
            {
                <div class="audit-head">@HeadContent(c)</div>
            }
            @if (c.Expanded && c.Count > 0)
            {
                <div class="audit-body @OpenedClass(c)" id="@BodyId(c)">
                    <table class="req-table">
                        <thead>
                            <tr>
                                <th class="audit-c-id">ID</th>
                                <th>Title</th>
                                <th class="audit-c-user">Assigned</th>
                                <th class="audit-c-state">State</th>
                                @if (c.ExtraColumn != null) { <th>@c.ExtraColumn</th> }
                                @if (c.ExtraColumn2 != null) { <th class="audit-c-date">@c.ExtraColumn2</th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in c.Rows)
                            {
                                <tr>
                                    <td><a class="id-link" href="@TfsApi.WorkItemUrl(r.Item.Project, r.Item.Id)" target="_blank" rel="noopener">#@r.Item.Id</a></td>
                                    <td>
                                        <div class="cell-title">@r.Item.Title</div>
                                        @if (RowMeta(r.Item) is { Length: > 0 } meta) { <div class="cell-meta">@meta</div> }
                                    </td>
                                    <td class="audit-user">@r.Item.Assigned</td>
                                    <td><span class="state-pill @WorkItemBadges.StateClass(r.Item.State)">@(string.IsNullOrEmpty(r.Item.State) ? "Unknown" : r.Item.State)</span></td>
                                    @if (c.ExtraColumn != null) { <td class="audit-extra audit-dim">@r.Expected</td> }
                                    @if (c.ExtraColumn2 != null) { <td class="audit-extra">@(r.Expected2 ?? "Not found")</td> }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    </div>
}

@code {
    [Parameter] public List<AuditCheck> Checks { get; set; } = new();

    /// <summary>The panel's heading, which says whose checks these are.</summary>
    [Parameter] public string Title { get; set; } = "Checks";

    private int CountBy(AuditSeverity sev) => Checks.Where(c => c.Severity == sev).Sum(c => c.Count);
    private static void Toggle(AuditCheck c)
    {
        if (c.Count > 0)
        {
            c.Expanded = !c.Expanded;
        }
    }

    private static string SevClass(AuditCheck c) => c.Count == 0 ? "sev-ok"
        : c.Severity switch { AuditSeverity.Critical => "sev-crit", AuditSeverity.Warning => "sev-warn", _ => "sev-info" };

    private static string CountClass(AuditCheck c) => c.Count == 0 ? "cnt-ok"
        : c.Severity switch { AuditSeverity.Critical => "cnt-crit", AuditSeverity.Warning => "cnt-warn", _ => "cnt-info" };

    private static string RowMeta(WorkItem w)
    {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(w.Discipline)) parts.Add(w.Discipline);
        if (string.Equals(w.TaskExecutionType, "Manual", StringComparison.OrdinalIgnoreCase)) parts.Add("Manual");
        if (!string.IsNullOrEmpty(w.Severity)) parts.Add(w.Severity);
        if (!string.IsNullOrEmpty(w.RootCause)) parts.Add(w.RootCause);
        if ((w.OriginalEstimate ?? 0) > 0) parts.Add($"OE {w.OriginalEstimate:0.##}h");
        return string.Join(" · ", parts);
    }

    /// <summary>The checks that found something, in their own order, then the ones that passed.</summary>
    private IEnumerable<AuditCheck> FoundFirst() => Checks.Where(c => c.Count > 0).Concat(Checks.Where(c => c.Count == 0));

    // Only a check a click has just opened fades its rows in; one that is open again after a tab switch shows at once.
    private readonly ArrivalCue openCue = new();
    private AuditCheck? lastOpened;

    private void HeadClicked(AuditCheck c)
    {
        Toggle(c);
        lastOpened = c.Expanded ? c : null;
        openCue.Mark();
    }

    private string OpenedClass(AuditCheck c) => ReferenceEquals(c, lastOpened) ? openCue.Class : "";

    // Tasks and Bugs each have a list on the page at once, so each list numbers its rows under its own prefix.
    private readonly string idBase = "audit-" + Guid.NewGuid().ToString("N")[..8] + "-";

    private string BodyId(AuditCheck c) => idBase + Checks.IndexOf(c);

    private static RenderFragment HeadContent(AuditCheck c) => @<text>
        <span class="sev-dot @SevClass(c)"></span>
        <span class="audit-title">@c.Title</span>
        <span class="audit-count @CountClass(c)">@(c.Count == 0 ? "✓ 0" : c.Count.ToString())</span>
    </text>;
}
