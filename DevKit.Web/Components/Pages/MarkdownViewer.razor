@page "/markdown"
@inject IJSRuntime JS

<div class="mdv">
    <div class="mdv-header">
        <div class="mdv-title">
            <Icon Inner="@Icons.FileText" />
            <span>Markdown Viewer</span>
        </div>
        <div class="mdv-modes">
            <button class="mdv-mode" id="mdModeEditor" data-mode="editor">Editor</button>
            <button class="mdv-mode active" id="mdModeSplit" data-mode="split">Split</button>
            <button class="mdv-mode" id="mdModePreview" data-mode="preview">Preview</button>
        </div>
        <div class="mdv-actions">
            <button class="btn-ghost btn-sm" id="mdImportBtn">Import</button>
            <div class="mdv-dropdown" id="mdExportDropdown">
                <button class="btn-ghost btn-sm" id="mdExportBtn">Export ▾</button>
                <div class="mdv-menu" id="mdExportMenu">
                    <button class="mdv-menu-item" id="mdExportMd">Export as .md</button>
                    <button class="mdv-menu-item" id="mdExportHtml">Export as .html</button>
                    <button class="mdv-menu-item" id="mdExportPdf">Export as PDF (print)</button>
                </div>
            </div>
        </div>
    </div>

    <div class="mdv-content mode-split" id="mdContent">
        <div class="mdv-pane" id="mdEditorPane">
            <div class="mdv-pane-label">Editor</div>
            <textarea id="mdEditor" class="md-editor" spellcheck="false" placeholder="Type or paste Markdown here..."></textarea>
        </div>
        <div class="mdv-resizer" id="mdResizer"></div>
        <div class="mdv-pane" id="mdPreviewPane">
            <div class="mdv-pane-label">
                <span>Preview</span>
                <button class="mdv-copy" id="mdCopyBtn" title="Copy formatted preview to clipboard">
                    <Icon Inner="@Icons.Copy" /><span>Copy as Text</span>
                </button>
            </div>
            <div class="mdv-preview">
                <div class="md" id="mdPreview"></div>
            </div>
        </div>
    </div>

    <div class="mdv-status">
        <span id="mdStatLines">Ln 0</span>
        <span id="mdStatWords">Words 0</span>
        <span id="mdStatChars">Chars 0</span>
    </div>
</div>

<input type="file" id="mdFileInput" accept=".md,.markdown,.txt,.text,.mdown" style="display:none" />

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("devKit.initMarkdownViewer");
    }
}
