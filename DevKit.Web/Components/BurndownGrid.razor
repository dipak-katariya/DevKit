@inject TfsApiService TfsApi

@* One panel, headed like the other tabs: the member count and the colour key sit in the heading, so the table starts
   right under it, and how to read the grid is the title's tooltip. *@
<div class="gpanel bd-panel">
    <div class="phead">
        <span class="ptitle" title="Hover a column heading for its expected hours. Click a cell, or press Enter on it, for its work items.">📆 Hours by member</span>
        @if (Matrix is { IsEmpty: false }) { <span class="si-count">@Matrix.Rows.Count member(s)</span> }
        <span class="bd-legend">
            <span><span class="bd-reg-green" aria-hidden="true">●</span> meets the hours expected</span>
            <span><span class="bd-reg-red" aria-hidden="true">●</span> below them</span>
            <span><span class="bd-reg-none" aria-hidden="true">●</span> not due yet</span>
            <span><span class="bd-bug-red">+Nb</span> = bug hours</span>
            <span class="bd-legend-note">@ThresholdLabel h expected per working day</span>
        </span>
    </div>
@if (Matrix is null || Matrix.IsEmpty)
{
    <div class="tbl-empty">@EmptyText</div>
}
else
{
    <div class="bd-wrap">
        <table class="bd-table">
            <thead>
                <tr>
                    <th class="bd-member">Member</th>
                    @foreach (var col in Matrix.Columns) { <th title="@ExpectedTitle(col.WorkingDays)">@col.Label</th> }
                    <th class="bd-total" title="@TotalTitle">Total</th>
                </tr>
            </thead>
            @* One Tab stop: the arrow keys move between the cells with hours (app.js), and a new matrix starts over. *@
            <tbody @key="Matrix" data-roving="grid" data-roving-stop>
                @{ var firstCell = true; }
                @foreach (var row in Matrix.Rows)
                {
                    <tr>
                        <td class="bd-member">@row.MemberDisplay</td>
                        @foreach (var col in Matrix.Columns)
                        {
                            var cell = row.Cells.TryGetValue(col.Key, out var c) ? c : null;
                            var expected = Expected(col.WorkingDays);
                            var overBug = expected is { } e && cell?.Bug < e;
                            <td class="bd-cell" title="@ExpectedTitle(col.WorkingDays)" @onclick="() => Show(row.MemberDisplay, col.Label, cell)">
                                @if (cell is null || Math.Abs(cell.Total) < HalfHundredth)
                                {
                                    <span class="bd-zero">·</span>
                                }
                                else
                                {
                                    @* No click handler of its own: Enter and clicks reach the cell's. *@
                                    <button type="button" class="bd-hit" data-roving-item tabindex="@(firstCell ? "0" : "-1")"
                                            aria-label="@CellName(row.MemberDisplay, col.Label, cell)">
                                        <span class="@RegClass(cell.Regular, expected)">@cell.Regular.ToString("0.#")</span>
                                        @if (cell.Bug > 0)
                                        {
                                            <span class="bd-bug @(overBug ? "bd-bug-red" : "")">+@cell.Bug.ToString("0.#")b</span>
                                        }
                                    </button>
                                    firstCell = false;
                                }
                            </td>
                        }
                        <td class="bd-total" title="@TotalTitle">
                            <span class="@RegClass(row.TotalRegular, Expected(Matrix.WorkingDays))">@row.TotalRegular.ToString("0.#")</span>
                            @if (row.TotalBug > 0) { <div class="bd-bug">+@row.TotalBug.ToString("0.#")b</div> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</div>

@if (sel is not null)
{
    <ModalDialog CssClass="bd-dialog" BodyClass="bd-dialog-body" OnClose="CloseCell">
        <Title>@selMember · @selPeriod</Title>
        <ChildContent>
                <table class="req-table">
                    <thead><tr><th class="bd-c-id">ID</th><th>Title</th><th class="bd-c-type">Type</th><th class="bd-c-hours">Hours</th></tr></thead>
                    <tbody>
                        @foreach (var it in sel.Items.OrderByDescending(i => i.Delta))
                        {
                            <tr>
                                <td><a class="id-link" href="@TfsApi.WorkItemUrl(Project, it.ItemId)" target="_blank" rel="noopener">#@it.ItemId</a></td>
                                <td>
                                    <div class="cell-title">@it.ItemTitle</div>
                                    <div class="cell-meta" title="@it.ItemArea">@(it.ItemArea.Split('\\').LastOrDefault())</div>
                                </td>
                                <td><span class="type-pill @WorkItemBadges.TypeClass(it.IsBug ? BugWork.BugType : it.ItemType)">@(it.IsBug ? "Bug work" : it.ItemType)</span></td>
                                <td class="bd-hours @(it.Delta < 0 ? "neg" : "")">@it.Delta.ToString("0.#")</td>
                            </tr>
                        }
                    </tbody>
                </table>
        </ChildContent>
        <Actions>
            <button type="button" class="btn-ghost" @onclick="CloseCell">Close</button>
        </Actions>
    </ModalDialog>
}

@code {
    [Parameter] public BurndownMatrix? Matrix { get; set; }
    [Parameter] public string Project { get; set; } = "";

    /// <summary>What the panel says when no row is left to show, which depends on why (a member filter, for one).</summary>
    [Parameter] public string EmptyText { get; set; } = "No hours to show.";

    /// <summary>Hours a member is expected to log in a working day: the Capacity Planning hours-per-day setting.</summary>
    [Parameter] public double DailyThreshold { get; set; } = CapacityPlanningSettings.DefaultHoursPerDay;

    private string ThresholdLabel => DailyThreshold.ToString("0.##");

    // The table has no row headers, so a cell's button names its member and period itself.
    private static string CellName(string member, string period, BurndownCell cell) => cell.Bug > 0
        ? $"{member}, {period}: {cell.Regular:0.#} h plus {cell.Bug:0.#} h on bugs. Show the work items"
        : $"{member}, {period}: {cell.Regular:0.#} h. Show the work items";

    private void CloseCell() => sel = null;

    private BurndownCell? sel;
    private string selMember = "", selPeriod = "";

    private void Show(string member, string period, BurndownCell? cell)
    {
        if (cell is null || cell.Items.Count == 0) return;
        sel = cell; selMember = member; selPeriod = period;
    }

    // Cells hold hours rounded to hundredths, so a total nearer zero than half of one is no hours.
    private const double HalfHundredth = 0.005;

    /// <summary>
    /// Hours expected over a period, so a week is measured against a week's working days, and
    /// null for a period the sprint does not cover, which is not judged either way.
    /// </summary>
    private double? Expected(int workingDays) => workingDays > 0 ? DailyThreshold * workingDays : null;

    private string ExpectedTitle(int workingDays) => Expected(workingDays) is { } hours
        ? $"{hours:0.##} h expected ({workingDays} working day(s) × {ThresholdLabel} h)"
        : "No hours expected yet. This period is outside the sprint's finished working days.";

    /// <summary>The Total covers the sprint so far, so it says how much of the sprint that is.</summary>
    private string TotalTitle
    {
        get
        {
            var elapsed = Matrix?.WorkingDays ?? 0;
            var sprint = Matrix?.SprintWorkingDays ?? 0;
            if (Expected(elapsed) is not { } hours) return "No hours expected yet. The sprint's first working day is not finished.";
            return sprint > elapsed
                ? $"{hours:0.##} h expected so far ({elapsed} of {sprint} working days elapsed × {ThresholdLabel} h)"
                : $"{hours:0.##} h expected ({elapsed} working day(s) × {ThresholdLabel} h)";
        }
    }

    private static string RegClass(double v, double? expected)
    {
        if (v <= 0)
        {
            return "bd-zero";
        }

        if (expected is not { } hours)
        {
            return "bd-reg-none";
        }

        return v < hours ? "bd-reg-red" : "bd-reg-green";
    }
}
