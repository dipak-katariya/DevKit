@inherits ClickOutsideComponent

@* Searchable multi-select built on the same .gdd-* shell as GlassDropdown. The arrow keys move
   through the options from the search box and Enter ticks one, so it works from the keyboard alone. *@

@{ var triggerLabel = TriggerLabel; }
<div class="gdd msd @(IsOpen ? "gdd-open" : "") @CssClass" @ref="Root" style="@Style">
    <button type="button" class="gdd-trigger" @ref="trigger" @onclick="Toggle" @onclick:stopPropagation
            disabled="@Disabled" aria-haspopup="listbox" aria-expanded="@(IsOpen ? "true" : "false")"
            aria-label="@(Label is null ? null : $"{Label}: {triggerLabel}")">
        <span class="gdd-value @(Selected.Count == 0 ? "gdd-placeholder" : "")" title="@SelectedLabels">@triggerLabel</span>
        @if (Selected.Count > 1)
        {
            <span class="msd-count" aria-hidden="true">@Selected.Count</span>
        }
        <span class="gdd-arrow" aria-hidden="true">▾</span>
    </button>

    @if (IsOpen && !Disabled)
    {
        <div class="gdd-panel" @onclick:stopPropagation>
            <div class="gdd-search-wrap">
                @* Keydown stops here, so Escape closes only this list and not a popover the dropdown sits in. *@
                <input class="gdd-search" type="text" placeholder="@SearchPlaceholder" autocomplete="off"
                       role="combobox" aria-label="@Label" aria-autocomplete="list" aria-expanded="true"
                       aria-controls="@PanelId" aria-activedescendant="@(highlightIdx >= 0 ? OptionId(highlightIdx) : null)"
                       @oninput="OnSearchInput" @ref="searchInput" @onkeydown="OnKeyDown" @onkeydown:stopPropagation />
            </div>

            <div class="msd-bulk">
                <button class="msd-bulk-btn" @onclick="SelectAllVisible" disabled="@(Visible().Count == 0)">
                    Select all@(HasSearch ? " matching" : "")
                </button>
                <button class="msd-bulk-btn" @onclick="ClearAll" disabled="@(Selected.Count == 0)">Clear</button>
            </div>

            @* A listbox only while it has options, so "No matches" is read as a status line, not as a list item. It
               does the scrolling, with tabindex -1, because a list that scrolls is otherwise a Tab stop of its own
               in Chrome, and the arrows already move through it from the search box. *@
            @{ var optionIndex = 0; }
            <div id="@PanelId" class="gdd-scroll" tabindex="-1" role="@(Visible().Count > 0 ? "listbox" : null)" aria-label="@Label" aria-multiselectable="true">
            <div class="gdd-list">
                @foreach (var opt in Visible())
                {
                    var isOn = Selected.Contains(opt.Value);
                    var idx = optionIndex++;
                    @* Pressing an option keeps focus in the search box, so the keys go on working after a click. *@
                    <div class="gdd-item msd-item @(isOn ? "gdd-item-active" : "") @(highlightIdx == idx ? "gdd-item-hl" : "")"
                         id="@OptionId(idx)" role="option" aria-selected="@(isOn ? "true" : "false")"
                         title="@(opt.Hint ?? opt.Label)" @onmousedown:preventDefault @onclick="() => ToggleValue(opt.Value)">
                        <span class="msd-box @(isOn ? "on" : "")" aria-hidden="true">@(isOn ? "✓" : "")</span>
                        <span class="msd-label">@opt.Label</span>
                    </div>
                }
                @if (Visible().Count == 0)
                {
                    <div class="gdd-empty" role="status">No matches</div>
                }
            </div>
            </div>
            @if (HiddenCount > 0)
            {
                <div class="bpk-more">@HiddenCount more. Type to narrow the list.</div>
            }
        </div>
    }
</div>

@code {
    private const int MaxRendered = 80;

    public sealed class Option
    {
        public string Value { get; set; } = "";
        public string Label { get; set; } = "";
        /// <summary>Tooltip; falls back to the label.</summary>
        public string? Hint { get; set; }
    }

    [Parameter] public List<Option> Options { get; set; } = new();
    [Parameter] public HashSet<string> Selected { get; set; } = new();
    [Parameter] public EventCallback<HashSet<string>> SelectedChanged { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select";
    [Parameter] public string SearchPlaceholder { get; set; } = "Search…";
    [Parameter] public string ItemNoun { get; set; } = "item";
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Style { get; set; }

    /// <summary>What the field is, such as "Sprint". Screen readers then hear the trigger as "Sprint: value".</summary>
    [Parameter] public string? Label { get; set; }

    private bool IsOpen;
    private string searchText = "";
    private ElementReference searchInput;
    private ElementReference trigger;
    private int highlightIdx = -1;

    protected override bool IsPanelOpen => IsOpen;

    private bool HasSearch => !string.IsNullOrWhiteSpace(searchText);

    private List<Option> Matches() => Options
        .Where(o => !HasSearch || o.Label.Contains(searchText, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private List<Option> Visible() => Matches().Take(MaxRendered).ToList();

    private int HiddenCount => Math.Max(0, Matches().Count - MaxRendered);

    private string TriggerLabel
    {
        get
        {
            if (Selected.Count == 0) return Placeholder;
            var first = Options.FirstOrDefault(o => Selected.Contains(o.Value));
            if (first is null) return $"{Selected.Count} {ItemNoun}(s) selected";
            return Selected.Count == 1 ? first.Label : $"{first.Label}  +{Selected.Count - 1}";
        }
    }

    // Every selected label for the trigger's tooltip, since the trigger names only the first.
    private string? SelectedLabels => Selected.Count == 0
        ? null
        : string.Join(", ", Options.Where(o => Selected.Contains(o.Value)).Select(o => o.Label));

    private async Task Toggle()
    {
        if (Disabled)
        {
            return;
        }
        IsOpen = !IsOpen;
        searchText = "";
        highlightIdx = -1;
        if (IsOpen)
        {
            await Task.Yield();
            await FocusAsync(searchInput);
        }
    }

    protected override Task CloseFromOutsideAsync()
    {
        IsOpen = false;
        searchText = "";
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task ToggleValue(string value)
    {
        if (!Selected.Add(value)) Selected.Remove(value);
        return SelectedChanged.InvokeAsync(Selected);
    }

    private Task SelectAllVisible()
    {
        Selected.UnionWith(Visible().Select(opt => opt.Value));
        return SelectedChanged.InvokeAsync(Selected);
    }

    private Task ClearAll()
    {
        Selected.Clear();
        return SelectedChanged.InvokeAsync(Selected);
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        highlightIdx = -1;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CloseToTriggerAsync();
            return;
        }

        var visible = Visible();
        if (e.Key == "Enter")
        {
            // Ticks and stays open, since the point of this list is to pick several.
            if (highlightIdx >= 0 && highlightIdx < visible.Count)
            {
                await ToggleValue(visible[highlightIdx].Value);
            }
            return;
        }

        var step = e.Key switch { "ArrowDown" => 1, "ArrowUp" => -1, _ => 0 };
        if (step == 0 || visible.Count == 0)
        {
            return;
        }
        highlightIdx = Math.Clamp(highlightIdx + step, 0, visible.Count - 1);
        await RevealAsync(OptionId(highlightIdx));
    }

    /// <summary>Closes from the keyboard. Focus goes back to the trigger, since the search box it was in is gone.</summary>
    private async Task CloseToTriggerAsync()
    {
        IsOpen = false;
        searchText = "";
        highlightIdx = -1;
        await FocusAsync(trigger);
    }

    private string OptionId(int index) => $"{PanelId}-{index}";
}
