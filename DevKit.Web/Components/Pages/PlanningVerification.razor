@page "/planning"
@inject TfsApiService TfsApi
@inject SettingsService Settings
@inject PageStateService PageState

<div style="display:flex;flex-direction:column;gap:0;flex:1;overflow:hidden;">
    <!-- Config Bar -->
    <div class="cfg-bar">
        <div class="cfg-col" style="flex:0 0 auto;">
            <div class="cfg-field">
                <label class="cfg-label">📂 Area Path</label>
                <GlassDropdown Style="min-width:220px;"
                               Value="@(selectedArea != null ? SerializeArea(selectedArea) : "")"
                               Placeholder="— Select area —"
                               Disabled="@(areas.Count==0)"
                               Groups="@AreaGroups"
                               OnChange="OnAreaChange" />
            </div>
        </div>
        <div class="cfg-divider"></div>
        <div class="cfg-col" style="flex:0 0 auto;">
            <div class="cfg-field">
                <label class="cfg-label">📅 Sprint</label>
                <GlassDropdown Style="min-width:220px;"
                               Value="@(selectedSprint ?? "")"
                               Placeholder="— Select sprint —"
                               ShowEmptyOption="false"
                               Disabled="@(iterations.Count==0)"
                               Groups="@SprintGroups"
                               OnChange="OnSprintChange" />
            </div>
        </div>
        <div class="cfg-divider"></div>
        <div class="cfg-col" style="flex:0 0 auto;">
            <button class="cfg-load-btn" @onclick="LoadPlanning" disabled="@(string.IsNullOrEmpty(selectedSprint) || selectedArea == null || loading)">
                @if (loading) { <span class="spin spin-sm" style="color:var(--text);"></span> }
                else { <span>⬇</span> }
                Load Sprint
            </button>
            @if (planningItems.Count > 0)
            {
                <span class="chip chip-green" style="font-size:.56rem;">@planningItems.Count items</span>
            }
        </div>
        <div class="cfg-divider"></div>
        <div class="cfg-col" style="flex:0 0 auto;">
            <button class="cfg-load-btn @(showMismatchOnly ? "btn-sm-active" : "")"
                    style="@(showMismatchOnly ? "background:rgba(251,191,36,.18);border-color:rgba(251,191,36,.35);color:#fde68a;" : "")"
                    @onclick="ToggleVerifySize" disabled="@(planningItems.Count == 0)">
                <span>@(showMismatchOnly ? "✓" : "⚠")</span>
                @(showMismatchOnly ? "Showing Mismatches" : "Verify Size")
            </button>
            @if (planningItems.Count > 0)
            {
                <span class="chip" style="font-size:.56rem;background:rgba(251,191,36,.1);color:var(--amber);">
                    @MismatchedCount mismatch
                </span>
            }
        </div>
        <div class="cfg-divider"></div>
        <div class="cfg-col" style="flex:0 0 auto;">
            <button class="cfg-load-btn"
                    style="background:rgba(167,139,250,.16);border-color:rgba(167,139,250,.35);color:#c4b5fd;"
                    @onclick="ApplyAllCalculated"
                    disabled="@(CalcDiffersCount == 0 || bulkApplying || loading)"
                    title="Set every requirement's size to its calculated value (past completed + current estimate)">
                @if (bulkApplying) { <span class="spin spin-sm" style="color:var(--text);"></span> }
                else { <span>∑</span> }
                Apply All Sizes
            </button>
            @if (CalcDiffersCount > 0)
            {
                <span class="chip" style="font-size:.56rem;background:rgba(167,139,250,.12);color:var(--purple);">
                    @CalcDiffersCount to update
                </span>
            }
        </div>
        <div class="cfg-divider"></div>
        <div class="cfg-col" style="flex:1;">
            <div class="cfg-field">
                <label class="cfg-label">🔍 Search</label>
                <input class="cfg-fi" placeholder="ID, title…" @oninput="OnSearch" />
            </div>
        </div>
        <div class="cfg-divider"></div>
        <div class="cfg-col" style="flex:0 0 auto;">
            <div class="cfg-field">
                <label class="cfg-label">🏷 Type</label>
                <GlassDropdown Value="@typeFilter" Placeholder="— All —" EmptyLabel="— All —" EmptyValue=""
                               Options="@TypeOptions" OnChange="OnTypeFilter" />
            </div>
        </div>
    </div>

    <!-- Summary bar -->
    @if (planningItems.Count > 0)
    {
        <div style="display:flex;align-items:center;gap:14px;padding:8px 18px;background:rgba(100,100,120,.03);border-bottom:1px solid rgba(255,255,255,.04);font-size:.66rem;flex-wrap:wrap;">
            <span class="chip chip-cyan">📋 @filteredItems.Count items</span>
            <span style="color:var(--muted);">Σ Size:</span>
            <span style="font-weight:700;color:var(--accent2);">@TotalEffort.ToString("0.##")</span>
            <span style="color:var(--muted);">·</span>
            <span style="color:var(--muted);">Σ Calc Size:</span>
            <span style="font-weight:700;color:var(--purple);">@TotalCalculated.ToString("0.##")</span>
            <span style="color:var(--muted);">·</span>
            <span style="color:var(--muted);">Σ Original:</span>
            <span style="font-weight:700;color:var(--cyan);">@TotalOriginal.ToString("0.##") h</span>
            <span style="color:var(--muted);">·</span>
            <span style="color:var(--muted);">Σ Remaining:</span>
            <span style="font-weight:700;color:var(--amber);">@TotalRemaining.ToString("0.##") h</span>
            <span style="color:var(--muted);">·</span>
            <span style="color:var(--muted);">Σ Completed:</span>
            <span style="font-weight:700;color:var(--green);">@TotalCompleted.ToString("0.##") h</span>
            <span style="color:var(--muted);">·</span>
            <span style="color:var(--muted);">Σ Revised:</span>
            <span style="font-weight:700;color:var(--purple);">@TotalRevised.ToString("0.##") h</span>
            @if (showMismatchOnly)
            {
                <span style="margin-left:auto;font-weight:700;color:var(--amber);">
                    ⚠ Showing @filteredItems.Count mismatched item(s)
                </span>
            }
        </div>
    }

    <!-- Main content -->
    <div class="content" style="flex:1;overflow:hidden;">
        <div class="gpanel" style="flex:1;display:flex;flex-direction:column;overflow:hidden;">
            <div class="phead">
                <span class="ptitle">📐 Sprint Planning Verification</span>
                <div style="display:flex;align-items:center;gap:10px;margin-left:auto;">
                    @if (planningItems.Count > 0)
                    {
                        <button class="btn-sm" style="padding:2px 8px;height:22px;font-size:.6rem;" @onclick="ToggleExpandAll">
                            @(AllExpanded ? "▾ Collapse all" : "▸ Expand all")
                        </button>
                    }
                    <span style="font-size:.6rem;color:var(--muted);">Click ▸ to expand tasks · click size to edit</span>
                </div>
            </div>
            <div class="pbody" style="padding:0;flex:1;overflow:hidden;">
                @if (planningItems.Count == 0 && !loading)
                {
                    <div class="pr-placeholder">
                        <div style="font-size:2rem;opacity:.2;">📐</div>
                        <div class="bp-title">Select Area & Sprint</div>
                        <div class="bp-sub">Choose an area path and sprint, then click Load Sprint to verify task estimates against requirement sizes.</div>
                    </div>
                }
                else if (loading)
                {
                    <div style="padding:40px;text-align:center;">
                        <div class="spin" style="color:var(--accent);width:24px;height:24px;border-width:2.5px;margin:0 auto;"></div>
                        <div style="font-size:.74rem;color:var(--muted);margin-top:10px;">Loading sprint items and tasks…</div>
                    </div>
                }
                else
                {
                    <div class="grid-wrap" style="overflow:auto;height:100%;">
                        <table class="req-table">
                            <thead><tr>
                                <th style="width:70px;" @onclick='() => Sort("id")'>ID</th>
                                <th @onclick='() => Sort("title")'>Title</th>
                                <th style="width:80px;" @onclick='() => Sort("state")'>State</th>
                                <th style="width:100px;" @onclick='() => Sort("assigned")'>Assigned</th>
                                <th style="width:75px;text-align:center;" @onclick='() => Sort("size")'>Size</th>
                                <th style="width:120px;text-align:center;" @onclick='() => Sort("calc")' title="Past sprints completed work + current sprint original estimate">Calc Size</th>
                                <th style="width:75px;text-align:center;" @onclick='() => Sort("orig")'>Original</th>
                                <th style="width:75px;text-align:center;" @onclick='() => Sort("rem")'>Remaining</th>
                                <th style="width:75px;text-align:center;" @onclick='() => Sort("done")'>Completed</th>
                                <th style="width:75px;text-align:center;" @onclick='() => Sort("rev")'>Revised</th>
                                <th style="width:60px;text-align:center;">Δ</th>
                            </tr></thead>
                            <tbody>
                                @if (filteredItems.Count == 0)
                                {
                                    <tr><td colspan="11" class="tbl-empty">No items match the filter.</td></tr>
                                }
                                @foreach (var pi in filteredItems)
                                {
                                    var hasSize = pi.WorkItem.Effort.HasValue && pi.WorkItem.Effort.Value > 0;
                                    var mismatch = hasSize && pi.TaskTotalEstimate > 0 && Math.Abs(pi.SizeMismatch) > 0.01;
                                    var reqBg = !hasSize ? "rgba(248,113,113,.06)" : mismatch ? "rgba(251,191,36,.06)" : "rgba(16,185,129,.05)";

                                    <!-- Requirement row (with sums of tasks) -->
                                    <tr style="background:@reqBg;border-top:2px solid rgba(255,255,255,.08);">
                                        <td>
                                            <span @onclick="() => ToggleExpand(pi)"
                                                  style="cursor:pointer;display:inline-block;width:13px;color:var(--muted);user-select:none;transition:transform .12s;transform:@(pi.IsExpanded ? "rotate(90deg)" : "none");"
                                                  title="@(pi.IsExpanded ? "Collapse tasks" : "Expand tasks")">▸</span>
                                            <a class="id-link" href="@TfsApi.WorkItemUrl(pi.WorkItem.Project, pi.WorkItem.Id)" target="_blank" style="font-weight:700;">#@pi.WorkItem.Id</a>
                                        </td>
                                        <td>
                                            <span class="type-pill @TypeCls(pi.WorkItem.Type)">@pi.WorkItem.Type</span>
                                            <div class="cell-title" style="font-weight:700;">@pi.WorkItem.Title</div>
                                            <div class="cell-meta">@pi.Tasks.Count task(s)</div>
                                        </td>
                                        <td><span class="state-pill @StateCls(pi.WorkItem.State)">@pi.WorkItem.State</span></td>
                                        <td style="font-size:.66rem;">@pi.WorkItem.Assigned</td>
                                        <td style="text-align:center;">
                                            @if (pi.EditingSize != null)
                                            {
                                                <div style="display:flex;align-items:center;gap:3px;justify-content:center;">
                                                    <input type="number" step="0.5" min="0" value="@pi.EditingSize"
                                                           @onchange="e => pi.EditingSize = e.Value?.ToString()"
                                                           @onkeydown="e => OnSizeKeyDown(e, pi)"
                                                           style="width:55px;background:rgba(0,0,0,.3);border:1px solid var(--accent);border-radius:5px;color:var(--text);font-size:.72rem;padding:2px 4px;font-family:var(--mono);text-align:center;"
                                                           autofocus />
                                                    <button class="btn-sm" style="padding:2px 6px;height:22px;" @onclick="() => SaveSize(pi)" disabled="@pi.Saving">
                                                        @if (pi.Saving) { <span class="spin spin-sm" style="width:8px;height:8px;"></span> } else { <span>✓</span> }
                                                    </button>
                                                    <button class="btn-sm" style="padding:2px 6px;height:22px;" @onclick="() => pi.EditingSize = null">✕</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <span style="font-family:var(--mono);font-size:.76rem;font-weight:700;cursor:pointer;color:@(hasSize ? "var(--accent2)" : "var(--red)");padding:3px 8px;border-radius:5px;background:rgba(255,255,255,.06);"
                                                      @onclick="() => StartEditSize(pi)" title="Click to edit">
                                                    @(hasSize ? pi.WorkItem.Effort!.Value.ToString("0.##") : "—")
                                                </span>
                                            }
                                        </td>
                                        <td style="text-align:center;">
                                            @if (pi.CalculatedSize > 0)
                                            {
                                                <div style="display:flex;align-items:center;gap:4px;justify-content:center;">
                                                    <span style="font-family:var(--mono);font-size:.74rem;font-weight:700;color:var(--purple);"
                                                          title="@($"{pi.PastSprintCompleted:0.##}h completed (past sprints) + {pi.CurrentSprintOriginal:0.##}h original estimate (this sprint)")">
                                                        @pi.CalculatedSize.ToString("0.##")
                                                    </span>
                                                    <button class="btn-sm" style="padding:2px 6px;height:22px;@(pi.CalcDiffersFromCurrent ? "border-color:rgba(167,139,250,.5);color:#c4b5fd;" : "opacity:.4;")"
                                                            @onclick="() => ApplyCalculatedSize(pi)" disabled="@(pi.Saving || !pi.CalcDiffersFromCurrent)"
                                                            title="@(pi.CalcDiffersFromCurrent ? $"Apply calculated size {pi.CalculatedSize:0.##} to #{pi.WorkItem.Id}" : "Size already matches the calculated value")">
                                                        @if (pi.Saving) { <span class="spin spin-sm" style="width:8px;height:8px;"></span> } else { <span>→</span> }
                                                    </button>
                                                </div>
                                            }
                                            else { <span style="color:var(--muted);">—</span> }
                                        </td>
                                        <td style="text-align:center;font-family:var(--mono);font-size:.7rem;color:var(--cyan);font-weight:700;">
                                            @(pi.TaskTotalEstimate > 0 ? pi.TaskTotalEstimate.ToString("0.##") : "—")
                                        </td>
                                        <td style="text-align:center;font-family:var(--mono);font-size:.7rem;color:var(--amber);font-weight:700;">
                                            @(pi.TaskTotalRemaining > 0 ? pi.TaskTotalRemaining.ToString("0.##") : "—")
                                        </td>
                                        <td style="text-align:center;font-family:var(--mono);font-size:.7rem;color:var(--green);font-weight:700;">
                                            @(pi.TaskTotalCompleted > 0 ? pi.TaskTotalCompleted.ToString("0.##") : "—")
                                        </td>
                                        <td style="text-align:center;font-family:var(--mono);font-size:.7rem;color:var(--purple);font-weight:700;">
                                            @(pi.TaskTotalRevised > 0 ? pi.TaskTotalRevised.ToString("0.##") : "—")
                                        </td>
                                        <td style="text-align:center;font-family:var(--mono);font-size:.66rem;font-weight:700;color:@(mismatch ? "var(--amber)" : hasSize ? "var(--green)" : "var(--muted)");">
                                            @if (hasSize && pi.TaskTotalEstimate > 0)
                                            {
                                                @(pi.SizeMismatch > 0 ? "+" : "")@pi.SizeMismatch.ToString("0.##")
                                            }
                                            else { @("—") }
                                        </td>
                                    </tr>

                                    @if (pi.IsExpanded)
                                    {
                                        @foreach (var t in pi.Tasks)
                                        {
                                            var rev = (t.CompletedWork ?? 0) + (t.RemainingWork ?? 0);
                                            var isCurrent = pi.IsCurrentSprintTask(t);
                                            <tr style="background:rgba(0,0,0,.12);">
                                                <td style="padding-left:24px;">
                                                    <span style="color:var(--muted);font-size:.6rem;margin-right:4px;">↳</span>
                                                    <a class="id-link" href="@TfsApi.WorkItemUrl(t.Project, t.Id)" target="_blank">#@t.Id</a>
                                                </td>
                                                <td>
                                                    <span class="type-pill" style="background:rgba(148,152,179,.12);color:var(--muted2);font-size:.52rem;">Task</span>
                                                    <div style="font-size:.7rem;color:var(--text);">@t.Title</div>
                                                    <div class="cell-meta" style="font-size:.56rem;">
                                                        @(string.IsNullOrEmpty(t.Sprint) ? "(no sprint)" : t.Sprint)
                                                        @if (isCurrent) { <span style="color:var(--purple);">· est → size</span> }
                                                        else { <span style="color:var(--green);">· completed → size</span> }
                                                    </div>
                                                </td>
                                                <td><span class="state-pill @StateCls(t.State)">@t.State</span></td>
                                                <td style="font-size:.64rem;color:var(--muted2);">@t.Assigned</td>
                                                <td></td>
                                                <td></td>
                                                <td style="text-align:center;font-family:var(--mono);font-size:.66rem;color:var(--cyan);@(isCurrent ? "font-weight:700;text-decoration:underline;" : "")">@(t.OriginalEstimate?.ToString("0.##") ?? "—")</td>
                                                <td style="text-align:center;font-family:var(--mono);font-size:.66rem;color:var(--amber);">@(t.RemainingWork?.ToString("0.##") ?? "—")</td>
                                                <td style="text-align:center;font-family:var(--mono);font-size:.66rem;color:var(--green);@(isCurrent ? "" : "font-weight:700;text-decoration:underline;")">@(t.CompletedWork?.ToString("0.##") ?? "—")</td>
                                                <td style="text-align:center;font-family:var(--mono);font-size:.66rem;color:var(--purple);">@(rev > 0 ? rev.ToString("0.##") : "—")</td>
                                                <td></td>
                                            </tr>
                                        }

                                        @if (pi.Tasks.Count == 0)
                                        {
                                            <tr style="background:rgba(0,0,0,.12);">
                                                <td colspan="11" style="padding:8px 24px;font-size:.66rem;color:var(--muted);font-style:italic;">
                                                    ↳ No tasks linked to this work item.
                                                </td>
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMsg))
    {
        <div style="position:fixed;bottom:20px;left:50%;transform:translateX(-50%);z-index:1000;padding:10px 18px;border-radius:var(--r2);font-size:.74rem;border:1px solid @(statusOk ? "rgba(52,211,153,.3)" : "rgba(248,113,113,.3)");background:@(statusOk ? "rgba(52,211,153,.1)" : "rgba(248,113,113,.1)");color:@(statusOk ? "var(--green)" : "var(--red)");backdrop-filter:blur(10px);">
            @statusMsg
        </div>
    }
</div>

@code {
    private List<TfsArea> areas => PageState.TfsData.Areas;
    private List<TfsIteration> iterations => PageState.TfsData.Iterations;

    private TfsArea? selectedArea;
    private string? selectedSprint;
    private List<PlanningItem> planningItems = new();
    private List<PlanningItem> filteredItems = new();
    private bool loading;
    private string searchQ = "", typeFilter = "";
    private string sortCol = "id";
    private bool sortAsc = true;
    private bool showMismatchOnly;
    private bool bulkApplying;
    private string statusMsg = "";
    private bool statusOk;

    private bool AllExpanded => filteredItems.Count > 0 && filteredItems.All(p => p.IsExpanded);
    private int CalcDiffersCount => planningItems.Count(p => p.CalcDiffersFromCurrent);

    private void ToggleExpand(PlanningItem pi) => pi.IsExpanded = !pi.IsExpanded;

    private void ToggleExpandAll()
    {
        var expand = !AllExpanded;
        foreach (var pi in filteredItems) pi.IsExpanded = expand;
    }

    // Totals
    private double TotalEffort => planningItems.Sum(p => p.WorkItem.Effort ?? 0);
    private double TotalCalculated => planningItems.Sum(p => p.CalculatedSize);
    private double TotalOriginal => planningItems.Sum(p => p.TaskTotalEstimate);
    private double TotalRemaining => planningItems.Sum(p => p.TaskTotalRemaining);
    private double TotalCompleted => planningItems.Sum(p => p.TaskTotalCompleted);
    private double TotalRevised => planningItems.Sum(p => p.TaskTotalRevised);

    private int MismatchedCount => planningItems.Count(p =>
        !p.WorkItem.Effort.HasValue || p.WorkItem.Effort == 0
        || (p.TaskTotalEstimate > 0 && Math.Abs(p.SizeMismatch) > 0.01));

    private void ToggleVerifySize()
    {
        showMismatchOnly = !showMismatchOnly;
        ApplyFilter();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Settings.IsConfigured) return;
        if (!PageState.TfsData.IsLoaded)
        {
            try
            {
                PageState.TfsData.Projects = await TfsApi.GetProjectsAsync();
                PageState.TfsData.Repos = await TfsApi.GetRepositoriesAsync();
                foreach (var p in PageState.TfsData.Projects)
                {
                    PageState.TfsData.Areas.AddRange(await TfsApi.GetAreasAsync(p.Name));
                    PageState.TfsData.Iterations.AddRange(await TfsApi.GetIterationsAsync(p.Name));
                }
                PageState.TfsData.IsLoaded = true;
            }
            catch { }
        }

        // Apply defaults from settings
        if (!string.IsNullOrEmpty(Settings.DefaultAreaPath))
        {
            var parts = Settings.DefaultAreaPath.Split("|||");
            if (parts.Length == 3)
                selectedArea = new TfsArea { Name = parts[0], Path = parts[1], Project = parts[2] };
        }
        if (!string.IsNullOrEmpty(Settings.DefaultSprint))
            selectedSprint = Settings.DefaultSprint;
    }

    private void OnAreaChange(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (string.IsNullOrEmpty(val)) { selectedArea = null; return; }
        var parts = val.Split("|||");
        if (parts.Length == 3) selectedArea = new TfsArea { Name = parts[0], Path = parts[1], Project = parts[2] };
    }
    private string SerializeArea(TfsArea a) => $"{a.Name}|||{a.Path}|||{a.Project}";
    private void OnSprintChange(ChangeEventArgs e) => selectedSprint = e.Value?.ToString();

    private async Task LoadPlanning()
    {
        if (selectedArea == null || string.IsNullOrEmpty(selectedSprint)) return;
        loading = true; planningItems.Clear(); filteredItems.Clear(); statusMsg = "";
        StateHasChanged();
        try
        {
            var iterPath = TfsApiService.ToWiqlPath(selectedSprint);
            var reqs = await TfsApi.LoadPlanningItemsAsync(selectedArea.Project, iterPath);

            // Filter by area path
            var areaPath = TfsApiService.ToWiqlPath(selectedArea.Path);
            reqs = reqs.Where(r => r.Area.Replace("\\Area\\", "\\").Contains(areaPath, StringComparison.OrdinalIgnoreCase)
                              || r.Area.Equals(areaPath, StringComparison.OrdinalIgnoreCase)).ToList();

            planningItems = reqs.Select(r => new PlanningItem { WorkItem = r, CurrentSprintPath = iterPath }).ToList();

            // Load tasks in parallel (chunked)
            foreach (var chunk in planningItems.Chunk(5))
            {
                var tasks = chunk.Select(async pi =>
                {
                    try { pi.Tasks = await TfsApi.GetChildTasksAsync(pi.WorkItem.Project, pi.WorkItem.Id); }
                    catch { pi.Tasks = new(); }
                }).ToArray();
                await Task.WhenAll(tasks);
                ApplyFilter();
                StateHasChanged();
            }
        }
        catch (Exception ex) { statusMsg = $"✕ Load failed: {ex.Message}"; statusOk = false; }
        loading = false;
    }

    private void StartEditSize(PlanningItem pi)
    {
        pi.EditingSize = pi.WorkItem.Effort?.ToString("0.##") ?? "";
    }

    private async Task OnSizeKeyDown(KeyboardEventArgs e, PlanningItem pi)
    {
        if (e.Key == "Enter") await SaveSize(pi);
        else if (e.Key == "Escape") pi.EditingSize = null;
    }

    private async Task SaveSize(PlanningItem pi)
    {
        if (pi.EditingSize == null) return;
        if (!double.TryParse(pi.EditingSize, out var newSize) || newSize < 0)
        {
            SetStatus("✕ Invalid size value", false, 2500);
            return;
        }

        pi.Saving = true; StateHasChanged();
        try
        {
            await PushSize(pi, newSize);
            pi.EditingSize = null;
            SetStatus($"✓ Updated #{pi.WorkItem.Id} size to {newSize:0.##}", true, 2000);
        }
        catch (Exception ex)
        {
            SetStatus($"✕ Update failed: {ex.Message}", false, 3500);
        }
        pi.Saving = false;
    }

    /// <summary>Applies the calculated size (past completed + current estimate) to a single requirement.</summary>
    private async Task ApplyCalculatedSize(PlanningItem pi)
    {
        var newSize = pi.CalculatedSize;
        if (newSize <= 0)
        {
            SetStatus("✕ No task hours available to calculate a size", false, 2500);
            return;
        }

        pi.Saving = true; StateHasChanged();
        try
        {
            await PushSize(pi, newSize);
            pi.EditingSize = null;
            SetStatus($"✓ Set #{pi.WorkItem.Id} size to {newSize:0.##} ({pi.PastSprintCompleted:0.##}h done + {pi.CurrentSprintOriginal:0.##}h est)", true, 2800);
        }
        catch (Exception ex)
        {
            SetStatus($"✕ Update failed: {ex.Message}", false, 3500);
        }
        pi.Saving = false;
    }

    /// <summary>Applies the calculated size to every loaded requirement whose size differs from the calculation.</summary>
    private async Task ApplyAllCalculated()
    {
        var targets = planningItems.Where(p => p.CalcDiffersFromCurrent).ToList();
        if (targets.Count == 0)
        {
            SetStatus("✓ All sizes already match the calculated values", true, 2500);
            return;
        }

        bulkApplying = true; StateHasChanged();
        var results = new System.Collections.Concurrent.ConcurrentBag<bool>();
        foreach (var chunk in targets.Chunk(5))
        {
            var jobs = chunk.Select(async pi =>
            {
                pi.Saving = true;
                try { await PushSize(pi, pi.CalculatedSize); results.Add(true); }
                catch { results.Add(false); }
                pi.Saving = false;
            }).ToArray();
            await Task.WhenAll(jobs);
            StateHasChanged();
        }
        bulkApplying = false;

        var ok = results.Count(r => r);
        var fail = results.Count - ok;
        SetStatus(fail == 0 ? $"✓ Updated {ok} requirement size(s)" : $"⚠ Updated {ok}, {fail} failed", fail == 0, 3500);
    }

    // Requirement/Change Request "Size" field across the common process templates.
    private static readonly string[] SizeFieldCandidates =
    {
        "Microsoft.VSTS.Scheduling.Size",     // CMMI (Requirement / Change Request)
        "Microsoft.VSTS.Scheduling.Effort",   // Scrum (Backlog Item / Bug)
        "Microsoft.VSTS.Scheduling.StoryPoints" // Agile (User Story)
    };

    /// <summary>Writes the size value to the requirement's Size field (falling back across templates) and updates the local model.</summary>
    private async Task PushSize(PlanningItem pi, double newSize)
    {
        Exception? lastError = null;
        foreach (var field in SizeFieldCandidates)
        {
            try
            {
                await TfsApi.UpdateWorkItemFieldAsync(pi.WorkItem.Project, pi.WorkItem.Id, field, newSize);
                pi.WorkItem.Effort = newSize;
                return;
            }
            catch (Exception ex) { lastError = ex; }
        }
        throw lastError ?? new InvalidOperationException("No size field could be updated.");
    }

    private void SetStatus(string msg, bool ok, int clearMs)
    {
        statusMsg = msg;
        statusOk = ok;
        _ = ClearStatusAfter(clearMs);
    }

    private async Task ClearStatusAfter(int ms)
    {
        await Task.Delay(ms);
        statusMsg = "";
        await InvokeAsync(StateHasChanged);
    }

    // ─── Filtering ───
    private void OnSearch(ChangeEventArgs e) { searchQ = (e.Value?.ToString() ?? "").ToLower(); ApplyFilter(); }
    private void OnTypeFilter(ChangeEventArgs e) { typeFilter = e.Value?.ToString() ?? ""; ApplyFilter(); }

    private void ApplyFilter()
    {
        filteredItems = planningItems.Where(pi =>
        {
            if (!string.IsNullOrEmpty(searchQ)
                && !pi.WorkItem.Id.Contains(searchQ)
                && !pi.WorkItem.Title.ToLower().Contains(searchQ))
                return false;
            if (!string.IsNullOrEmpty(typeFilter) && pi.WorkItem.Type != typeFilter) return false;
            if (showMismatchOnly)
            {
                var hasSize = pi.WorkItem.Effort.HasValue && pi.WorkItem.Effort > 0;
                var hasMismatch = hasSize && pi.TaskTotalEstimate > 0 && Math.Abs(pi.SizeMismatch) > 0.01;
                // Show: no size OR size mismatch
                if (hasSize && !hasMismatch) return false;
            }
            return true;
        }).ToList();
        ApplySort();
    }

    private void Sort(string col)
    {
        if (sortCol == col) sortAsc = !sortAsc; else { sortCol = col; sortAsc = true; }
        ApplySort();
    }

    private void ApplySort()
    {
        filteredItems = sortCol switch
        {
            "id" => sortAsc ? filteredItems.OrderBy(p => int.TryParse(p.WorkItem.Id, out var n) ? n : 0).ToList() : filteredItems.OrderByDescending(p => int.TryParse(p.WorkItem.Id, out var n) ? n : 0).ToList(),
            "title" => sortAsc ? filteredItems.OrderBy(p => p.WorkItem.Title).ToList() : filteredItems.OrderByDescending(p => p.WorkItem.Title).ToList(),
            "state" => sortAsc ? filteredItems.OrderBy(p => p.WorkItem.State).ToList() : filteredItems.OrderByDescending(p => p.WorkItem.State).ToList(),
            "assigned" => sortAsc ? filteredItems.OrderBy(p => p.WorkItem.Assigned).ToList() : filteredItems.OrderByDescending(p => p.WorkItem.Assigned).ToList(),
            "size" => sortAsc ? filteredItems.OrderBy(p => p.WorkItem.Effort ?? 0).ToList() : filteredItems.OrderByDescending(p => p.WorkItem.Effort ?? 0).ToList(),
            "calc" => sortAsc ? filteredItems.OrderBy(p => p.CalculatedSize).ToList() : filteredItems.OrderByDescending(p => p.CalculatedSize).ToList(),
            "orig" => sortAsc ? filteredItems.OrderBy(p => p.TaskTotalEstimate).ToList() : filteredItems.OrderByDescending(p => p.TaskTotalEstimate).ToList(),
            "rem" => sortAsc ? filteredItems.OrderBy(p => p.TaskTotalRemaining).ToList() : filteredItems.OrderByDescending(p => p.TaskTotalRemaining).ToList(),
            "done" => sortAsc ? filteredItems.OrderBy(p => p.TaskTotalCompleted).ToList() : filteredItems.OrderByDescending(p => p.TaskTotalCompleted).ToList(),
            "rev" => sortAsc ? filteredItems.OrderBy(p => p.TaskTotalRevised).ToList() : filteredItems.OrderByDescending(p => p.TaskTotalRevised).ToList(),
            _ => filteredItems
        };
    }

    // ─── Dropdown Data ───
    private List<GlassDropdown.DropdownGroup> AreaGroups => areas.GroupBy(a => a.Project).Select(grp => new GlassDropdown.DropdownGroup
    { Label = "📁 " + grp.Key, Options = grp.Select(a => new GlassDropdown.DropdownOption { Value = SerializeArea(a), Label = grp.Key + " — " + TfsApiService.AreaDisplayPath(a.Path) }).ToList() }).ToList();

    private List<GlassDropdown.DropdownGroup> SprintGroups => iterations.GroupBy(i => i.Project).Select(grp => new GlassDropdown.DropdownGroup
    { Label = "📁 " + grp.Key, Options = grp.Select(it => new GlassDropdown.DropdownOption { Value = it.Path, Label = grp.Key + " — " + it.Name }).ToList() }).ToList();

    private List<GlassDropdown.DropdownOption> TypeOptions => planningItems.Select(p => p.WorkItem.Type).Distinct().OrderBy(t => t)
        .Select(t => new GlassDropdown.DropdownOption { Value = t, Label = t }).ToList();

    // ─── Helpers ───
    private static string TypeCls(string t) => t.ToLower() switch { "bug" => "bug", "change request" => "cr", _ => "" };
    private static string StateCls(string s)
    {
        var l = s.ToLower();
        if (l.Contains("progress") || l.Contains("active")) return "state-active";
        if (l.Contains("resolve") || l.Contains("done") || l.Contains("complete")) return "state-resolved";
        if (l.Contains("closed")) return "state-closed";
        return "state-new";
    }
}
