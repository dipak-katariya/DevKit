@page "/settings"
@inject SettingsService SettingsSvc
@inject TfsApiService TfsApi
@inject PageStateService PageState
@inject BranchCacheService BranchCache
@inject IJSRuntime JS
@inject ILogger<Settings> Logger

@* One column of raised sections. Every choice is saved as it is made, except the TFS connection: that one is checked
   with TFS first and saved only when TFS accepts it. *@
<div class="st-page">
    <h1 class="sr-only">Settings</h1>
    <div class="st-col">
    <div class="st-bar">
        <p class="st-where" title="@SettingsSvc.SettingsFilePath">Saved in <code>@SettingsSvc.SettingsFilePath</code></p>
        <div class="st-bar-tools">
            <button type="button" class="btn-sm" @onclick="ExportSettings"
                    title="Download your settings as a file. The TFS connection and token are not included."><span aria-hidden="true">📤</span> Export</button>
            @* The file input stays in the Tab order, hidden only from sight, so Import works from the keyboard too. *@
            <label class="btn-sm st-import"
                   title="Load settings from a file exported by DevKit. Your TFS connection is not changed.">
                <span aria-hidden="true">📥</span> Import
                <InputFile OnChange="ImportSettings" accept=".json,application/json" class="sr-only" />
            </label>
        </div>
    </div>
    <div role="status">
        @if (!string.IsNullOrEmpty(transferMsg))
        {
            <div class="notice @(transferOk ? "ok" : "bad")">@transferMsg</div>
        }
    </div>
    @foreach (var problem in new[] { SettingsSvc.LoadProblem, SettingsSvc.LastSaveError }.OfType<string>().Distinct())
    {
        <div class="notice bad" role="alert">@problem</div>
    }

    <section class="gpanel st-sec" aria-labelledby="stTfsTitle">
        <div class="phead"><h2 class="ptitle" id="stTfsTitle">TFS / Azure DevOps Connection</h2></div>
        <div class="pbody">
            @* Windows sign-in to TFS acts as the account DevKit runs as, so shared DevKit offers it to that account alone. *@
            @if (SettingsSvc.AllowsWindowsSignIn)
            {
                <div class="f-row" role="group" aria-labelledby="stSignInLabel">
                    <div class="f-label" id="stSignInLabel">Sign in with</div>
                    <div class="cm-seg">
                        <button type="button" class="cm-seg-btn @(tfsAuth == TfsAuthMode.Windows ? "on" : "")" aria-pressed="@(tfsAuth == TfsAuthMode.Windows ? "true" : "false")"
                                @onclick="() => SetSignIn(TfsAuthMode.Windows)">Windows account</button>
                        <button type="button" class="cm-seg-btn @(tfsAuth == TfsAuthMode.Pat ? "on" : "")" aria-pressed="@(tfsAuth == TfsAuthMode.Pat ? "true" : "false")"
                                @onclick="() => SetSignIn(TfsAuthMode.Pat)">Personal Access Token</button>
                    </div>
                </div>
            }
            <div class="settings-grid">
                <div class="f-row">
                    <label class="f-label" for="stTfsUrl">Server URL <span class="req-badge">required</span></label>
                    @if (SettingsSvc.FixedTfsUrl is { } fixedUrl)
                    {
                        <input id="stTfsUrl" class="fi" value="@fixedUrl" readonly title="Set for everyone by whoever runs this shared DevKit." />
                    }
                    else
                    {
                        <input id="stTfsUrl" class="fi" @bind="tfsUrl" placeholder="@TfsConnectionForm.ExampleHint" />
                    }
                </div>
                @if (tfsAuth == TfsAuthMode.Windows)
                {
                    <div class="f-row">
                        <label class="f-label" for="stAccount">Windows account <em>no token needed</em></label>
                        <input id="stAccount" class="fi" value="@WindowsAccount" readonly title="DevKit signs in to TFS as the Windows account it runs as." />
                    </div>
                }
                else
                {
                    <div class="f-row">
                        <label class="f-label" for="stPat">Personal Access Token <span class="req-badge">required</span></label>
                        <input id="stPat" class="fi" type="password" autocomplete="new-password" @bind="tfsPat"
                               placeholder="@(hasStoredPat ? "Saved. Leave blank to keep it" : "Enter PAT")" />
                    </div>
                }
            </div>
            <div class="st-actions">
                <button type="button" class="btn-primary" @onclick="SaveAndConnect" disabled="@saving">
                    @if (saving) { <span class="spin spin-sm"></span> } else { <span aria-hidden="true">💾</span> }
                    Save & Connect
                </button>
                <button type="button" class="btn-ghost" @onclick="TestConnection" disabled="@testing">
                    @if (testing) { <span class="spin spin-sm"></span> } else { <span aria-hidden="true">🔌</span> }
                    Test Connection
                </button>
            </div>
            <div role="status">
                @if (!string.IsNullOrEmpty(statusMsg))
                {
                    <div class="notice @(statusOk ? "ok" : "bad")">@statusMsg</div>
                }
            </div>
            <p class="st-hint">
                @if (SettingsSvc.FixedTfsUrl is not null)
                {
                    <text>They are encrypted for your Windows account and kept only here, never on the DevKit server. They stay when DevKit is updated or moves to another server; in another browser or on another PC, enter them once there.</text>
                }
                else if (SettingsSvc.Tfs.Auth == TfsAuthMode.Windows)
                {
                    <text>Only your Windows account can open it, and it holds no token: DevKit signs in to TFS as your Windows account.</text>
                }
                else
                {
                    <text>Only your Windows account can open it, and the PAT inside is encrypted for this server.</text>
                }
            </p>
        </div>
    </section>

    <section class="gpanel st-sec" aria-labelledby="stDefaultsTitle">
        <div class="phead"><h2 class="ptitle" id="stDefaultsTitle">Team & Default Selections</h2></div>
        <div class="pbody">
            <p class="st-desc">Configure your team name and default selections. These pre-fill the area and sprint pickers on the other pages.</p>
            <div class="f-row st-team">
                <label class="f-label" for="stTeam">Team Name</label>
                <input id="stTeam" class="fi" value="@teamName" @onchange="OnTeamNameChange" placeholder="e.g. FOIA, Platform, Core…" />
                <p class="st-hint">Used in branch naming: <code>TeamName/sprint/id_title</code></p>
            </div>
            @if (!string.IsNullOrEmpty(metadataError)) { <div class="notice warn" role="alert">⚠ @metadataError</div> }
            <div class="st-grid3">
                <div class="f-row">
                    <div class="f-label">Default Area Path</div>
                    <GlassDropdown CssClass="fi-size" Label="Default area path"
                                   Value="@defaultAreaPath"
                                   Placeholder="None"
                                   EmptyLabel="None" EmptyValue=""
                                   Disabled="@(areas.Count==0)"
                                   Groups="@AreaGroups"
                                   OnChange="OnDefaultAreaChange" />
                </div>
                <div class="f-row" role="group" aria-labelledby="stSprintLabel">
                    <div class="f-label" id="stSprintLabel">Default Sprint</div>
                    <div class="cm-seg st-seg">
                        <button type="button" class="cm-seg-btn @(defaultSprintIsCurrent ? "on" : "")" aria-pressed="@(defaultSprintIsCurrent ? "true" : "false")"
                                @onclick="() => SetDefaultSprintMode(true)">Current sprint</button>
                        <button type="button" class="cm-seg-btn @(defaultSprintIsCurrent ? "" : "on")" aria-pressed="@(defaultSprintIsCurrent ? "false" : "true")"
                                @onclick="() => SetDefaultSprintMode(false)">Choose a sprint</button>
                    </div>
                    @if (defaultSprintIsCurrent)
                    {
                        <input class="fi" value="@CurrentSprintLabel" readonly aria-label="Current sprint"
                               title="Worked out from today's date and the sprint dates in TFS, in the default area's project." />
                    }
                    else
                    {
                        <GlassDropdown CssClass="fi-size" Label="Default sprint"
                                       Value="@defaultSprint"
                                       Placeholder="None"
                                       EmptyLabel="None" EmptyValue=""
                                       Disabled="@(iterations.Count==0)"
                                       Groups="@SprintGroups"
                                       OnChange="OnDefaultSprintChange" />
                    }
                </div>
                <div class="f-row">
                    <div class="f-label">Default Repository</div>
                    <GlassDropdown CssClass="fi-size" Label="Default repository"
                                   Value="@defaultRepoId"
                                   Placeholder="None"
                                   EmptyLabel="None" EmptyValue=""
                                   Disabled="@(repos.Count==0)"
                                   Groups="@RepoGroups"
                                   OnChange="OnDefaultRepoChange" />
                </div>
            </div>
        </div>
    </section>

    <section class="gpanel st-sec" aria-labelledby="stPinsTitle">
        <div class="phead"><h2 class="ptitle" id="stPinsTitle">Most-Used Repositories</h2></div>
        <div class="pbody">
            <p class="st-desc">
                Pin the repositories you work in most often. They appear in a
                <b>@RepoSelect.MostUsedGroupLabel</b> group at the top of every repository picker in DevKit,
                in the order you pin them.
            </p>
            <div class="st-pins-grid">
                <div class="f-row">
                    <div class="f-label">How many</div>
                    <GlassDropdown CssClass="fi-size" Label="How many repositories to pin"
                                   Value="@mostUsedCount.ToString()"
                                   ShowEmptyOption="false"
                                   Placeholder="Off"
                                   Options="@MostUsedCountOptions()"
                                   OnChange="OnMostUsedCountChange" />
                </div>
                <div class="f-row">
                    <div class="f-label">
                        Pinned repositories
                        @if (mostUsedCount > 0)
                        {
                            <span class="st-count">@mostUsedRepoIds.Count of @mostUsedCount used</span>
                        }
                    </div>
                    <MultiSelectDropdown Options="@AllRepoOptions" Selected="@mostUsedSelection" Label="Pinned repositories"
                                         SelectedChanged="OnMostUsedReposChanged" ItemNoun="repository"
                                         Disabled="@(mostUsedCount == 0 || repos.Count == 0)"
                                         Placeholder="@(mostUsedCount == 0 ? "Turned off" : "Select repositories")"
                                         SearchPlaceholder="Search repositories…" />
                </div>
            </div>

            @* Repositories load after the first render, so the chips wait for names rather than
               flashing "(unknown repository)" for every pin. *@
            @if (mostUsedRepoIds.Count > 0 && repos.Count > 0)
            {
                <ol class="st-pins" aria-label="Pinned repositories, in order">
                    @for (var i = 0; i < mostUsedRepoIds.Count; i++)
                    {
                        var repoId = mostUsedRepoIds[i];
                        var position = i + 1;
                        <li class="st-pin" @key="repoId">
                            <span class="st-pin-n" aria-hidden="true">@position</span>
                            @MostUsedRepoLabel(repoId)
                            <button type="button" class="bpk-clear" title="Unpin" aria-label="Unpin @MostUsedRepoLabel(repoId)" @onclick="() => UnpinMostUsedRepo(repoId)">✕</button>
                        </li>
                    }
                </ol>
            }
            <div role="status">
                @if (!string.IsNullOrEmpty(mostUsedMsg))
                {
                    <div class="notice warn">⚠ @mostUsedMsg</div>
                }
            </div>
        </div>
    </section>

    <section class="gpanel st-sec" aria-labelledby="stBranchesTitle">
        <div class="phead">
            <h2 class="ptitle" id="stBranchesTitle">Default Branches for Code Merging</h2>
            @if (repos.Count > 0)
            {
                <span class="si-count">@ConfiguredBranchCount of @repos.Count configured@(BranchRepos.Count < repos.Count ? $" · showing {BranchRepos.Count}" : "")</span>
            }
            <label class="st-filter">
                <span class="sr-only">Filter repositories</span>
                <input class="cfg-fi" placeholder="Filter by name or project…" value="@repoBranchFilter" @oninput="OnRepoBranchFilter" />
            </label>
        </div>
        <div class="pbody">
            <p class="st-desc">
                The branches the Code Merging Sheet starts with for each repository. The <b>QA branch</b> is where
                developers merge their pull requests, and decides which pull requests the sheet lists. The
                <b>merging target</b> is the release branch the changes must reach, and is what verification checks.
                Left empty, both are automatic: the merging target is the newest release branch (such as
                <code>release/cp-26.5.2</code>), and the QA branch is <code>main</code>. When a repository has no such
                branch, its default branch is used. Either can still be changed on the sheet for one session.
                Your most-used repositories are listed first.
            </p>

            @if (repos.Count == 0 && listsLoading)
            {
                <LoadingState>Reading the repositories from TFS…</LoadingState>
            }
            else if (repos.Count == 0)
            {
                <div class="tbl-empty">Connect to TFS above to configure repository branches.</div>
            }
            else if (BranchRepos.Count == 0)
            {
                <div class="tbl-empty">No repositories match “@repoBranchFilter”.</div>
            }
            else
            {
                <div class="st-table-wrap">
                <table class="repo-path-table">
                    <thead>
                        <tr>
                            <th class="st-c-repo">Repository</th>
                            <th class="st-c-branch">QA branch</th>
                            <th class="st-c-branch">Merging target</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var repo in BranchRepos)
                        {
                            var saved = SettingsSvc.GetRepoBranches(repo.Id);
                            <tr @key="repo.Id">
                                <td>
                                    <div class="st-repo">
                                        @repo.Name
                                        @if (mostUsedSelection.Contains(repo.Id))
                                        {
                                            <span class="st-tag">Most used</span>
                                        }
                                    </div>
                                    <div class="st-repo-project">@repo.Project</div>
                                </td>
                                <td>
                                    <BranchPicker Branches="@BranchesFor(repo.Id)" Value="@saved.QaBranch" Label="@($"QA branch for {repo.Name}")"
                                                  ValueChanged="@(b => OnQaBranchChange(repo.Id, b))"
                                                  OnOpened="@(() => LoadBranchesFor(repo))"
                                                  Loading="@(loadingBranchRepoId == repo.Id)"
                                                  Placeholder="@AutomaticBranch(repo, MergingBranchDefaults.QaBranch, "main")" />
                                </td>
                                <td>
                                    <BranchPicker Branches="@BranchesFor(repo.Id)" Value="@saved.MergingBranch" Label="@($"Merging target for {repo.Name}")"
                                                  ValueChanged="@(b => OnMergingBranchChange(repo.Id, b))"
                                                  OnOpened="@(() => LoadBranchesFor(repo))"
                                                  Loading="@(loadingBranchRepoId == repo.Id)"
                                                  Placeholder="@AutomaticBranch(repo, MergingBranchDefaults.MergingTarget, "newest release branch")" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>
    </section>
    </div>
</div>
