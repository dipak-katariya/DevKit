@inject IJSRuntime JS
@inject ILogger<CopyableRef> Log
@implements IDisposable

@* A git ref or SHA: opens in a new tab when it has a URL, and always copies from the icon. *@

<span class="cref @CssClass">
    @if (string.IsNullOrEmpty(Url))
    {
        <span class="cref-text" title="@Tooltip">@DisplayText</span>
    }
    else
    {
        <a class="cref-text cref-link" href="@Url" target="_blank" rel="noopener"
           title="@Tooltip" @onclick:stopPropagation>@DisplayText</a>
    }
    <button class="cref-copy @(copied ? "done" : "")" type="button"
            title="@(copied ? "Copied" : $"Copy {Label}")"
            @onclick="Copy" @onclick:stopPropagation>
        <Icon Inner="@(copied ? Icons.Check : Icons.Copy)" />
    </button>
</span>

@code {
    /// <summary>The exact value placed on the clipboard.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    /// <summary>What is rendered; defaults to <see cref="Text"/>.</summary>
    [Parameter] public string? Display { get; set; }

    /// <summary>When set, the text becomes a link opening in a new tab.</summary>
    [Parameter] public string? Url { get; set; }

    [Parameter] public string Label { get; set; } = "value";
    [Parameter] public string? CssClass { get; set; }

    private bool copied;
    private CancellationTokenSource? resetCts;

    private string DisplayText => string.IsNullOrEmpty(Display) ? Text : Display;

    private string Tooltip => string.IsNullOrEmpty(Url) ? Text : $"{Text} (opens in a new tab)";

    private async Task Copy()
    {
        try
        {
            // False when the browser refused: no tick for a copy that did not happen.
            if (!await JS.InvokeAsync<bool>("devKit.copyToClipboard", Text))
            {
                return;
            }
        }
        catch (JSDisconnectedException ex)
        {
            Log.LogDebug(ex, "The page closed before a {Label} was copied", Label);
            return;
        }
        catch (JSException ex)
        {
            Log.LogError(ex, "The browser could not copy a {Label}", Label);
            return;
        }

        copied = true;
        var previous = resetCts;
        resetCts = new CancellationTokenSource();
        var token = resetCts.Token;
        await CancellationSources.CancelAndDisposeAsync(previous);

        // Clear the tick without blocking the click handler.
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(CopyFeedback.TickMs, token);
                copied = false;
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException ex)
            {
                Log.LogDebug(ex, "A {Label} copy tick was superseded by a newer copy, or the component went away", Label);
            }
        }, token);
    }

    public void Dispose()
    {
        resetCts?.Cancel();
        resetCts?.Dispose();
    }
}
